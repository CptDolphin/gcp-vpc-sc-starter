# Stan A — jedna reguła ingress w konfiguracji DRY-RUN.
#
# Celowo BEZ backendu zdalnego: chodzi o to, żeby oba stany nie miały wspólnej blokady. Dokładnie tak
# wygląda sytuacja dwóch repozytoriów zespołów, z których każde ma własny bucket stanu.

terraform {
  required_version = ">= 1.8, < 2.0"
  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 7.0"
    }
  }
}

provider "google" {}

variable "policy_id" {
  description = "Numer org-level access policy."
  type        = string
}

variable "perimeter_name" {
  description = "Nazwa TESTOWEGO perimetru (nie produkcyjnego!)."
  type        = string
}

# Tożsamość jest PARAMETREM, nie stałą — i musi wskazywać konto, które REALNIE ISTNIEJE w organizacji.
# ACM waliduje istnienie tożsamości i odrzuca całą zmianę (`invalid or non-existent`). Wpisane tu na sztywno
# konto przykładowe sprawiało, że OBA applye padały z tego samego powodu, a eksperyment raportował „reguły
# giną" — czyli zawsze potwierdzał tezę, niezależnie od zachowania API (Issue #1904).
variable "identity" {
  description = "ISTNIEJĄCE konto serwisowe w formacie ACM, np. serviceAccount:sa-x@prj-y.iam.gserviceaccount.com"
  type        = string

  validation {
    condition     = can(regex("^serviceAccount:[^@\\s]+@[^@\\s]+\\.gserviceaccount\\.com$", var.identity))
    error_message = "identity musi mieć postać serviceAccount:<konto>@<projekt>.iam.gserviceaccount.com"
  }
}

# Reguła w konfiguracji DRY-RUN — nie blokuje niczego, tylko zapisuje się w konfiguracji.
resource "google_access_context_manager_service_perimeter_dry_run_ingress_policy" "race" {
  perimeter = "accessPolicies/${var.policy_id}/servicePerimeters/${var.perimeter_name}"
  title     = "race-test-alpha"

  ingress_from {
    identities = [var.identity]
  }

  ingress_to {
    resources = ["*"]
    operations {
      service_name = "storage.googleapis.com"
      method_selectors {
        method = "google.storage.buckets.get"
      }
    }
  }
}
