# Bramki na DEKLARACJACH (pliki YAML w perimeter/), zanim cokolwiek trafi do planu.
#
# Wejście buduje tools/collect_declarations.py:
#   { "policy": {...}, "profiles": {...}, "members": {...}, "members_list": [...], "today": "YYYY-MM-DD" }
#
# `members` to mapa klucz→wpis (klucz = `<dywizja>-<project_id>`, ten sam ciąg, który jest adresem zasobu
# w stanie Terraform), `members_list` to surowa lista z `perimeter/projects.yaml`. Obie opisują ten sam
# plik i obie są potrzebne: reguły o TREŚCI wpisu czytają mapę, reguły o DUPLIKATACH — wyłącznie listę,
# bo mapa duplikatu nie umie reprezentować. Powód rozpisany przy tamtych regułach.
#
# DLACZEGO część reguł działa tu, a nie na plan-JSON: promocja do enforced i wygasanie wpisów to warunki
# o CZASIE i o INTENCJI (ticket, właściciel, data przeglądu) — w planie ich nie widać, bo plan pokazuje
# tylko kształt zasobów. Reguły o kształcie reguł siedzą osobno, w perimeter.rego.

package vpcsc.onboarding

import rego.v1

# --- baseline ---------------------------------------------------------------------------------------

# Vertex AI jest powodem istnienia perimetru. Ta reguła działa NIEZALEŻNIE od trybu brownfield: nawet gdy
# Terraform nie zarządza szkieletem, policy.yaml jest dokumentem, na którym opierają się wszystkie guardy —
# ciche wyjęcie aiplatform zamieniłoby je w atrapę.
deny contains msg if {
	not "aiplatform.googleapis.com" in input.policy.restricted_services
	msg := "policy.yaml: restricted_services musi zawierać aiplatform.googleapis.com (Vertex AI chroniony od dnia zero, DEC-1)"
}

# --- członkowie -------------------------------------------------------------------------------------

# Profil musi istnieć w katalogu. Literówka w nazwie inaczej przechodzi jako „członek bez reguł":
# projekt ląduje w perimetrze, żadna reguła nie powstaje, a po promocji ruch jest odcięty.
deny contains msg if {
	some name, m in input.members
	some p in m.profiles
	not input.profiles[p.name]
	msg := sprintf("projects.yaml[%s]: profil %q nie istnieje w perimeter/profiles/", [name, p.name])
}

# Każdy parametr zadeklarowany w profilu musi mieć wartość w pliku członka — i odwrotnie, żadnych
# parametrów-widm. Brakujący parametr renderuje się na pustą listę tożsamości, czyli regułę, która nikogo
# nie autoryzuje (i nikt tego nie zauważy do czasu enforce).
deny contains msg if {
	some name, m in input.members
	some p in m.profiles
	some param in input.profiles[p.name].parameters
	not p.params[param.name]
	msg := sprintf("projects.yaml[%s]: profil %q wymaga parametru %q", [name, p.name, param.name])
}

deny contains msg if {
	some name, m in input.members
	some p in m.profiles
	some key, _ in p.params
	not param_declared(input.profiles[p.name], key)
	msg := sprintf("projects.yaml[%s]: parametr %q nie jest zadeklarowany w profilu %q (literówka?)", [name, key, p.name])
}

param_declared(profile, key) if {
	some param in profile.parameters
	param.name == key
}

# --- duplikaty wpisów w perimeter/projects.yaml -----------------------------------------------------
#
# CZTERY REGUŁY NIŻEJ LICZĄ NA `members_list`, A NIE NA `input.members` — I TO JEST CAŁA ICH TREŚĆ.
#
# `input.members` jest MAPĄ klucz→wpis (`<division>-<project_id>`), zbudowaną przez collect_declarations.py
# dokładnie tak, jak wcześniej budowała ją nazwa pliku. Mapa nie umie reprezentować duplikatu: dwa wpisy
# o tym samym kluczu dają jeden element i żadna reguła nie zobaczy, że drugi kiedykolwiek istniał.
# Przy jednym wspólnym pliku (DEC-12) to nie jest przypadek brzegowy, tylko normalny wynik scalenia —
# a wtedy „cicho wygrywa ostatni" znaczy: promocja do `enforced` cofnięta do `dry-run` bez śladu w diffie.
#
# `members_list` to surowa lista z pliku, w kolejności zapisu, z duplikatami. `object.get` z domyślną
# pustą listą, a nie `input.members_list`: brak klucza (stare narzędzie, ręcznie sklecony declarations.json)
# ma dawać PUSTĄ listę, czyli 0 wpisów kontra N w mapie — i wtedy odpala reguła o rozjeździe liczności
# niżej. Odwrotnie — gdyby odwołać się wprost — wyrażenie byłoby niezdefiniowane, reguły by nie odpaliły
# i brak listy przepuszczałby wszystko. Fail-closed, nie fail-quiet.
members_list := object.get(input, "members_list", [])

# Ten sam projekt opisany dwa razy. Renderer wyprodukowałby dwa zasoby ACM o różnych kluczach i tej samej
# treści (albo — przy identycznym kluczu — jeden, gubiąc drugi), więc Terraform dodawałby ten projekt do
# perimetru dwa razy: błąd API albo dwóch właścicieli jednego wpisu, z których każdy apply kasuje cudzy.
# Gorzej niż technicznie: dwie dywizje uważałyby się za właściciela tego samego projektu.
deny contains msg if {
	some i, m1 in members_list
	some j, m2 in members_list
	i < j
	m1.project_number == m2.project_number
	msg := sprintf(
		"projects.yaml: wpisy %q (#%d) i %q (#%d) deklarują ten sam projekt (project_number %s) — jeden projekt może mieć tylko jeden wpis",
		[klucz_wpisu(m1), i + 1, klucz_wpisu(m2), j + 1, m1.project_number],
	)
}

# To samo dla `project_id`. Osobna reguła, a nie „i różne numery" jak wcześniej: przy pliku na projekt
# para (ten sam ID, ten sam numer) była łapana przez regułę wyżej i nie mogła powstać inaczej niż jako dwa
# pliki. Tutaj może powstać jako dwa wpisy o tym samym kluczu, więc pytamy o oba pola niezależnie —
# a komunikat pokazuje numery, bo rozjazd (ten sam ID, inny numer) oznacza literówkę w numerze, czyli
# dopisanie do perimetru CUDZEGO projektu pod właściwie wyglądającą nazwą.
deny contains msg if {
	some i, m1 in members_list
	some j, m2 in members_list
	i < j
	m1.project_id == m2.project_id
	msg := sprintf(
		"projects.yaml: wpisy #%d i #%d mają ten sam project_id (%s), numery %s i %s — jeden projekt może mieć tylko jeden wpis",
		[i + 1, j + 1, m1.project_id, m1.project_number, m2.project_number],
	)
}

# Ten sam KLUCZ przy różnych projektach. To nie wynika z dwóch reguł wyżej: klucz powstaje przez sklejenie
# dywizji z projektem, więc `division: a-b` + `project_id: cccccc` i `division: a` + `project_id: b-cccccc`
# to dwa RÓŻNE projekty pod jednym adresem w stanie Terraform. Terraform to odrzuci („Duplicate object key"),
# ale dopiero na planie i komunikatem o wyrażeniu `for` — czyli tam, gdzie wnioskodawca go nie zobaczy.
deny contains msg if {
	some i, m1 in members_list
	some j, m2 in members_list
	i < j
	klucz_wpisu(m1) == klucz_wpisu(m2)
	m1.project_id != m2.project_id
	msg := sprintf(
		"projects.yaml: wpisy #%d (%s) i #%d (%s) dają ten sam klucz %q — to jeden adres zasobu w stanie Terraform dla dwóch różnych projektów; zmień dywizję albo popraw project_id",
		[i + 1, m1.project_id, j + 1, m2.project_id, klucz_wpisu(m1)],
	)
}

# BACKSTOP NA WSZYSTKO, CZEGO NIE PRZEWIDZIELIŚMY. Mapa i lista opisują ten sam plik, więc muszą mieć tyle
# samo elementów. Każdy powód, dla którego mapa gubi wpis — duplikat klucza, przyszła zmiana w kluczowaniu,
# błąd w collect_declarations.py — daje tu różnicę i zatrzymuje PR, nawet jeśli żadna reguła wyżej nie
# rozpoznaje przyczyny. Reguła kosztuje trzy linie i jest jedyną, która nie zakłada, że wiemy, co się psuje.
deny contains msg if {
	count(members_list) != count(input.members)
	msg := sprintf(
		"projects.yaml: %d wpisów w pliku, %d po zbudowaniu mapy członków — któryś wpis został po cichu zgubiony (duplikat klucza?). Napraw plik; sama mapa nie umie tego pokazać",
		[count(members_list), count(input.members)],
	)
}

# Klucz członka = `<dywizja>-<project_id>`. JEDNA definicja, tak jak w `tools/projects_file.py` i w
# `terraform/locals.tf`: ten ciąg jest adresem zasobu w stanie, więc trzy różne sposoby jego składania
# byłyby trzema różnymi zbiorami członków.
klucz_wpisu(m) := sprintf("%s-%s", [m.division, m.project_id])

# --- projekty płaszczyzny sterowania (anty-samo-zablokowanie) ---------------------------------------
#
# To jest bramka na JEDYNY tryb awarii tego repozytorium, którego `git revert` NIE COFA — i dlatego jest
# bramką maszynową, a nie pozycją w checkliście review.
#
# Mechanika: bucket stanu Terraform leży w projekcie administracyjnym perimetru. Gdy ten projekt trafi do
# konfiguracji EGZEKWOWANEJ przy `storage.googleapis.com` w restricted_services, konto apply traci dostęp do
# WŁASNEGO stanu — woła z GitHub Actions, czyli spoza granicy. Rewert wniosku nie pomaga, bo apply rewertu
# też potrzebuje stanu. Wyjście: człowiek z uprawnieniami org-level, ręcznie na żywej polityce.
#
# DLACZEGO odrzucamy na KAŻDYM etapie, a nie dopiero przy `enforced`: w dry-run wpis faktycznie niczego nie
# blokuje, ale promocja to jednowyrazowy diff (`stage: dry-run` → `enforced`) po 14 dniach obserwacji,
# wyglądający na rutynę. Bramka odpalająca dopiero przy promocji pozwoliłaby uzbroić pułapkę teraz
# i rozbroiłaby się dokładnie w tym PR-ze, którego nikt nie czyta uważnie.
#
# DLACZEGO nie warunkujemy tego obecnością storage.googleapis.com w restricted_services: lista usług rośnie
# osobnym PR-em i nikt wtedy nie wraca do plików członków. Bramka bezwarunkowa jest tańsza niż zależność
# między dwoma plikami, o której trzeba pamiętać w odpowiedniej kolejności.
deny contains msg if {
	some name, m in input.members
	on_control_plane_list(m)
	not control_plane_exception_declared(m)
	msg := sprintf(
		"projects.yaml[%s]: projekt %s jest na liście control_plane_projects (policy.yaml) — po promocji do enforced konto apply straci dostęp do bucketa stanu, bo woła spoza perimetru. Rewert tego NIE cofa (apply rewertu też potrzebuje stanu), naprawa wymaga człowieka z uprawnieniami org-level. Jeśli to świadome, dodaj control_plane_exception z uzasadnieniem",
		[name, m.project_id],
	)
}

# Furtka musi kosztować zdanie tłumaczące, dlaczego tym razem jest bezpiecznie. Bez progu długości pole
# degeneruje się do „ok" — a wtedy jedyna bramka przed nieodwracalną awarią przepuszcza na skrót klawiszowy.
deny contains msg if {
	some name, m in input.members
	control_plane_exception_declared(m)
	not control_plane_exception_justified(m)
	msg := sprintf(
		"projects.yaml[%s]: control_plane_exception wymaga uzasadnienia (min. 20 znaków) — napisz, gdzie leży teraz stan Terraform i skąd woła konto apply",
		[name],
	)
}

# Wyjątek na członku, którego NIE MA na liście, nic nie robi — i właśnie to jest problem. Gdyby wolno go było
# trzymać „na zapas", ktoś mógłby dopisać go do wszystkich plików członków, a późniejsze rozszerzenie
# control_plane_projects przeszłoby bez ani jednej bramki. Wyjątek ma być odpowiedzią na istniejącą blokadę,
# nie polisą wykupioną z góry.
deny contains msg if {
	some name, m in input.members
	control_plane_exception_declared(m)
	not on_control_plane_list(m)
	msg := sprintf(
		"projects.yaml[%s]: control_plane_exception na projekcie spoza listy control_plane_projects — wyjątek trzymany „na zapas\" cicho rozbroi bramkę, gdy lista się rozszerzy. Usuń go",
		[name],
	)
}

# Numer projektu zapisany w YAML-u bez cudzysłowów jest liczbą, a `project_number` w pliku członka jest
# zawsze stringiem — porównanie nigdy nie trafi. Bramka wyglądałaby na uzbrojoną i nie łapała niczego,
# czyli byłaby gorsza od jej braku (fałszywe poczucie pokrycia). Schema łapie to samo `type: string`;
# ta reguła jest drugą warstwą, bo cichy no-op akurat tej bramki kosztuje interwencję org-level.
deny contains msg if {
	some cp in object.get(input.policy, "control_plane_projects", [])
	not is_string(cp)
	msg := sprintf(
		"policy.yaml control_plane_projects: wpis %v nie jest tekstem — numer projektu zapisz w cudzysłowach, inaczej ta bramka nigdy niczego nie dopasuje",
		[cp],
	)
}

on_control_plane_list(m) if {
	some cp in object.get(input.policy, "control_plane_projects", [])
	m.project_id == cp
}

# Lista przyjmuje ID albo numer — członek musi zostać złapany niezależnie od tego, którym z nich został
# wpisany. Jedna ścieżka dopasowania byłaby bramką, którą omija się literówką w wyborze formatu.
on_control_plane_list(m) if {
	some cp in object.get(input.policy, "control_plane_projects", [])
	m.project_number == cp
}

# `object.get` z sentinelem `null` zamiast `m.control_plane_exception`: odwołanie do brakującego klucza jest
# w rego NIEZDEFINIOWANE, a wtedy `not` zachowuje się inaczej niż na wartości. Sentinel czyni ten predykat
# totalnym — brak pola i puste pole znaczą to samo: wyjątku nie ma.
control_plane_exception_declared(m) if {
	object.get(m, "control_plane_exception", null) != null
}

# `is_object` PRZED odczytem uzasadnienia: gdyby ktoś wpisał tam string, `object.get` byłoby niezdefiniowane,
# reguła wyżej by nie odpaliła i malformowany wyjątek przeszedłby jako ważny. Tu każdy kształt inny niż
# obiekt z 20-znakowym uzasadnieniem oznacza „niedostatecznie uzasadniony" (fail-closed).
control_plane_exception_justified(m) if {
	exc := m.control_plane_exception
	is_object(exc)
	count(object.get(exc, "justification", "")) >= 20
}

# --- promocja do enforced ---------------------------------------------------------------------------

# WYJĄTEK OD BRAMKI PROMOCJI — dlaczego w ogóle istnieje.
#
# Bramka bez udokumentowanej ścieżki wyjątku nie jest bramką rygorystyczną, tylko bramką, która zostanie
# WYŁĄCZONA. Pierwszy przypadek, w którym okno obserwacji nie da się spełnić w rozsądnym czasie (migracja
# z terminem, projekt utworzony pod sam test, naruszenia wygenerowane przez własny audyt), kończy się
# obniżeniem `dry_run_min_days` w baseline — czyli poluzowaniem reżimu dla WSZYSTKICH dywizji naraz,
# bezterminowo i bez śladu, kto i po co o to poprosił.
#
# Wyjątek jest odwrotnością tamtego ruchu na czterech osiach:
#   * ZAKRES — dotyczy JEDNEGO członka po nazwie, nie całej organizacji;
#   * CZAS — ma `expires`; po tej dacie przestaje działać sam, bez niczyjej pamięci;
#   * WŁASNOŚĆ — mieszka w `policy.yaml`, czyli pod CODEOWNERS Security. Gdyby siedział w pliku członka,
#     dywizja zwalniałaby się z bramki własnym PR-em, a to jest definicja bramki, która nie bramkuje;
#   * ILOŚĆ — `accept_violations_up_to` jest LICZBĄ, nie flagą „ignoruj". Wyjątek na 2 naruszenia nie
#     przepuści trzeciego: jeśli w oknie pojawi się nowy przepływ, promocja znów staje.
#
# Uzasadnienie ma minimum 40 znaków — dwa razy tyle, co przy `exceptions` w pliku członka. Świadomie:
# tamto opisuje pojedynczą regułę, to zwalnia z warunku, który chroni całą dywizję przed odcięciem ruchu.
promotion_waivers := object.get(object.get(input.policy, "onboarding", {}), "promotion_waivers", [])

# Wyjątek jest WAŻNY, gdy dotyczy tego członka, nie wygasł i niesie uzasadnienie. Każdy z tych warunków
# osobno: wygasły wyjątek z dobrym uzasadnieniem jest tak samo nieważny jak świeży bez uzasadnienia.
wazne_wyjatki(name) := [w |
	some w in promotion_waivers
	w.member == name
	w.expires >= input.today # ISO YYYY-MM-DD porównuje się leksykograficznie
	count(object.get(w, "justification", "")) >= 40
]

# DWA PREDYKATY Z `default`, A NIE `object.get` NA WYNIKU FUNKCJI. Funkcja bez pasującego wyjątku jest
# NIEZDEFINIOWANA, a niezdefiniowane wyrażenie w ciele reguły `deny` unieważnia CAŁĄ regułę — czyli brak
# wyjątku przepuszczałby promocję zamiast ją zatrzymać. Bramka fail-open jest gorsza od jej braku, bo
# wygląda na obecną. Stąd jawne wartości domyślne: „brak wyjątku" = nie zwalnia i pokrywa 0 naruszeń.
default wyjatek_zwalnia_z_okna(_) := false

wyjatek_zwalnia_z_okna(name) if {
	some w in wazne_wyjatki(name)
	object.get(w, "accept_dry_run_days_below_minimum", false)
}

default wyjatek_pokrywa_naruszen(_) := 0

wyjatek_pokrywa_naruszen(name) := n if {
	n := max([x |
		some w in wazne_wyjatki(name)
		x := object.get(w, "accept_violations_up_to", 0)
	])
}

# Okno obserwacji: minimum dni w dry-run. Bez tej bramki „promocja" staje się formalnością zaraz po
# merge'u wniosku — a wtedy cała dwustopniowość jest teatrem (DEC-4).
deny contains msg if {
	some name, m in input.members
	m.stage == "enforced"
	days := days_between(m.dry_run_since, input.today)
	days < input.policy.onboarding.dry_run_min_days
	not wyjatek_zwalnia_z_okna(name)
	msg := sprintf(
		"projects.yaml[%s]: promocja do enforced po %d dniach dry-run, wymagane minimum %d (perimeter/policy.yaml)",
		[name, days, input.policy.onboarding.dry_run_min_days],
	)
}

# Raport naruszeń (violations-report.yml) wstrzykuje `violations_last_window` per członek. Brak klucza =
# brak dowodu, że okno było czyste — a „nie mamy danych" nie jest tym samym co „nie było naruszeń".
#
# TEJ reguły wyjątek NIE zwalnia i to jest świadome: „nie zmierzyliśmy" nie jest stanem, o którym da się
# podjąć decyzję. Wyjątek mówi „widzieliśmy N naruszeń i bierzemy je na siebie" — więc najpierw musi być co
# zobaczyć. Zwolnienie z dowodu zamieniłoby wyjątek w wyłącznik całej bramki.
deny contains msg if {
	some name, m in input.members
	m.stage == "enforced"
	not input.violations_last_window[name]
	msg := sprintf("projects.yaml[%s]: brak raportu naruszeń dla okna obserwacji — promocja bez dowodu, że jest czysto", [name])
}

deny contains msg if {
	some name, m in input.members
	m.stage == "enforced"
	count := input.violations_last_window[name]
	count > 0
	count > wyjatek_pokrywa_naruszen(name)
	msg := sprintf(
		"projects.yaml[%s]: %d naruszeń w oknie obserwacji — napraw przepływy albo dodaj profil przed promocją (wyjątek pokrywa do %d)",
		[name, count, wyjatek_pokrywa_naruszen(name)],
	)
}

# Wyjątek dla członka, którego nie ma — zwykle literówka w nazwie pliku. Cichy no-op wyglądałby jak
# działający wyjątek do czasu, aż ktoś zdziwi się, czemu promocja stoi. Fail-loud, nie fail-silent.
deny contains msg if {
	some w in promotion_waivers
	not input.members[w.member]
	msg := sprintf("policy.yaml onboarding.promotion_waivers: wyjątek wskazuje członka %q, którego nie ma w perimeter/projects.yaml", [w.member])
}

# Wyjątek, który nie zwalnia z niczego, jest wpisem-widmem: wygląda w diffie jak decyzja, a nie robi nic.
deny contains msg if {
	some w in promotion_waivers
	not object.get(w, "accept_dry_run_days_below_minimum", false)
	object.get(w, "accept_violations_up_to", 0) == 0
	msg := sprintf("policy.yaml onboarding.promotion_waivers[%q]: wyjątek nie zwalnia z niczego — ustaw accept_dry_run_days_below_minimum albo accept_violations_up_to", [w.member])
}

# --- kanały wejścia ---------------------------------------------------------------------------------
# Trzy kanały prowadzą do jednego mutatora (DEC-7). Każdy ma inny dowód autoryzacji:
#   snow:  ticket zweryfikowany oddzwonieniem do ServiceNow (workflow intake — poza rego)
#   pr:    repozytorium zespołu — TU sprawdzamy, czy wolno mu wnioskować o TEN projekt
#   manual: wpis ręczny — dowodem jest approval CODEOWNERS (poza rego; egzekwuje branch protection)

# Kanał `pr:` może zgłaszać WYŁĄCZNIE projekty przypisane temu repozytorium w perimeter/contributors.yaml.
# Bez tej reguły repo dowolnego zespołu dopisałoby sobie cudzy projekt do perimetru — a wniosek wyglądałby
# tak samo legalnie jak każdy inny.
deny contains msg if {
	some name, m in input.members
	startswith(m.change_ref, "pr:")
	repo := contributor_repo(m.change_ref)
	not contributor_allows(repo, m.project_id)
	msg := sprintf(
		"projects.yaml[%s]: repozytorium %q nie ma projektu %q na liście dozwolonych (perimeter/contributors.yaml)",
		[name, repo, m.project_id],
	)
}

# Repo zgłaszające musi należeć do tej samej dywizji co wpis — inaczej zespół A zgłasza w imieniu zespołu B,
# a właścicielem wpisu (i adresatem raportu naruszeń) zostaje ktoś, kto o niczym nie wie.
deny contains msg if {
	some name, m in input.members
	startswith(m.change_ref, "pr:")
	repo := contributor_repo(m.change_ref)
	some c in object.get(input, "contributors", [])
	c.repository == repo
	c.division != m.division
	msg := sprintf("projects.yaml[%s]: repozytorium %q jest przypisane do dywizji %q, a wpis deklaruje %q",
		[name, repo, c.division, m.division])
}

contributor_repo(ref) := repo if {
	trimmed := trim_prefix(ref, "pr:")
	parts := split(trimmed, "#")
	repo := parts[0]
}

contributor_allows(repo, project) if {
	some c in object.get(input, "contributors", [])
	c.repository == repo
	project in c.allowed_projects
}

# --- reguły baseline ---------------------------------------------------------------------------------
# Reguła stosowana do WSZYSTKICH członków bez warunku kontekstu to realne poszerzenie granicy. Dopuszczamy
# to (skaner woła z własnej infrastruktury i nie spełni korpo-access-levelu), ale wyłącznie JAWNIE — pole
# `allow_without_access_level: true`. Pominięcie pola nie może dawać tego samego skutku co jego ustawienie.
deny contains msg if {
	some rule in object.get(input.policy, "baseline_ingress", [])
	count(object.get(rule, "access_levels", [])) == 0
	not object.get(rule, "allow_without_access_level", false)
	msg := sprintf(
		"policy.yaml baseline_ingress[%q]: brak access_levels — dopuszczalne tylko z jawnym allow_without_access_level: true (approval Security)",
		[rule.title],
	)
}

# Baseline mnoży się przez liczbę członków, więc `*` w metodach kosztuje tu najwięcej — i daje skanerowi
# prawo do wszystkiego w każdym chronionym projekcie.
# WYJĄTEK ten sam co w perimeter.rego i z tego samego powodu: dla usług, którym ACM nie publikuje listy metod
# (`supportedMethods` puste), `*` jest JEDYNĄ wartością, jaką API przyjmuje. Tutaj listę czytamy wprost
# z `input.policy` — collect_declarations.py podaje cały baseline, więc `--data` nie jest potrzebne.
# `object.get` z domyślną pustą listą: brak pola = zero wyjątków = każdy `*` odrzucony (fail-closed).
deny contains msg if {
	some rule in object.get(input.policy, "baseline_ingress", [])
	some op in rule.operations
	"*" in op.methods
	not op.service in object.get(input.policy, "services_without_method_selectors", [])
	msg := sprintf("policy.yaml baseline_ingress[%q]: method \"*\" na %s — wypisz metody jawnie", [rule.title, op.service])
}

# --- egress do zasobów POZA Google Cloud ------------------------------------------------------------
# Pole `externalResources` w regule egress obsługuje WYŁĄCZNIE zasoby BigQuery Omni (s3:// i azure://).
# Obie reguły poniżej łapią błąd, który inaczej wychodzi dopiero na apply — a przy granicy bezpieczeństwa
# „wyjdzie na apply" znaczy: w oknie, w którym pipeline już zaczął zmieniać politykę produkcyjną.

# Operacja na innej usłudze niż BigQuery wygląda w pliku tak samo poprawnie jak właściwa, a nie zadziała:
# API zastosuje regułę, ale `externalResources` nie obejmie ruchu tej usługi. Efekt = reguła-atrapa.
deny contains msg if {
	some pname, prof in input.profiles
	some rule in object.get(prof, "egress", [])
	object.get(rule, "to_external_from", "") != ""
	some op in rule.operations
	op.service != "bigquery.googleapis.com"
	msg := sprintf(
		"profiles/%s: reguła %q ma zasoby zewnętrzne i operację na %s — externalResources działa wyłącznie dla BigQuery Omni",
		[pname, rule.title, op.service],
	)
}

# Format identyfikatora. `arn:aws:s3:::bucket` to najczęstsza pomyłka (bo tak wygląda w AWS), a API oczekuje
# `s3://BUCKET`. Bez tej bramki literówka przechodzi review i pada dopiero na apply.
deny contains msg if {
	some name, m in input.members
	some prof in m.profiles
	some rule in object.get(input.profiles[prof.name], "egress", [])
	key := object.get(rule, "to_external_from", "")
	key != ""
	some res in object.get(prof.params, key, [])
	not valid_external_resource(res)
	msg := sprintf(
		"projects.yaml[%s]: %q nie jest obsługiwanym zasobem zewnętrznym — wymagane s3://BUCKET albo azure://ACCOUNT.blob.core.windows.net/CONTAINER",
		[name, res],
	)
}

# TRZY REGULY API, KTORYCH NIE MA W ZADNEJ DOKUMENTACJI GOOGLE'A CZYTANEJ PRZY PISANIU TEGO PROFILU.
# Wszystkie trzy zmierzone 2026-08-11 na zywym ACM, kazda osobnym targetowanym apply:
#
#   1. `arn:aws:s3:::bucket` -> `Invalid external resource ... Valid format is s3://<bucket_name>,
#      s3a://<bucket_name>, s3n://<bucket_name>, or azure://<blob_name>.blob.core.windows.net/<path_name>`
#   2. `methods` przy `external_resources` -> `With 'external_resources' set, MethodSelector is only
#      allowed to have permission`
#   3. `permissions` inne niz `externalResource.read` -> `PERMISSION '<x>' is not supported in
#      bigquery.googleapis.com`. Odrzucone zostaly m.in. `bigquery.jobs.create`, `bigquery.tables.getData`,
#      `bigquery.tables.get` i `*` — mimo ze pierwsze trzy SA na liscie
#      `gcloud access-context-manager supported-services describe bigquery.googleapis.com`,
#      a `externalResource.read` na tej liscie NIE JEST.
#
# Konsekwencja, ktora kosztowala pelny cykl apply: profil `bq-omni-external-read` byl w katalogu od dnia
# powstania z `methods: [JobService.Query, JobService.InsertJob]` i NIE DAL SIE ZAPLIKOWAC ANI RAZU.
# Bramki tego nie widzialy, bo zaden czlonek go nie uzywal — pierwsze uzycie bylo pierwszym testem.

deny contains msg if {
	some pname, prof in input.profiles
	some rule in object.get(prof, "egress", [])
	object.get(rule, "to_external_from", "") != ""
	some op in rule.operations
	count(object.get(op, "methods", [])) > 0
	msg := sprintf(
		"profiles/%s: regula %q ma zasoby zewnetrzne i selektory `methods` — API przyjmuje tam WYLACZNIE `permissions` (zmierzone: `With 'external_resources' set, MethodSelector is only allowed to have permission`)",
		[pname, rule.title],
	)
}

# Wartosc uprawnienia. Lista `supported-services` NIE jest tu wyrocznia (patrz punkt 3 wyzej), wiec
# porownujemy z tym, co API realnie przyjelo. Gdyby Google dolozyl kolejne, ta lista jest jednym miejscem
# do poprawienia — i wymaga POMIARU, nie lektury dokumentacji.
dozwolone_uprawnienia_zewnetrzne := {"externalResource.read"}

deny contains msg if {
	some pname, prof in input.profiles
	some rule in object.get(prof, "egress", [])
	object.get(rule, "to_external_from", "") != ""
	some op in rule.operations
	some perm in object.get(op, "permissions", [])
	not perm in dozwolone_uprawnienia_zewnetrzne
	msg := sprintf(
		"profiles/%s: regula %q ma uprawnienie %q przy zasobach zewnetrznych — API przyjmuje tylko %v (zmierzone; `supported-services` klamie w obie strony)",
		[pname, rule.title, perm, dozwolone_uprawnienia_zewnetrzne],
	)
}

# `access_levels_from` W REGULE EGRESS — druga warstwa nad schematem, bo cichy no-op tej akurat deklaracji
# jest drozszy niz jej brak. API to POTRAFI (`egressFrom.sources.accessLevel` + `sourceRestriction`
# istnieja w schemacie providera 7.43.0), ale renderer tego NIE SKLADA: `egress_from` w rules.tf ma
# wylacznie `identities`. Zmierzone przed poprawka: pole przechodzilo schemat i te bramki, budzet
# atrybutow LICZYL je (53 -> 54 atrybuty, sufit 299 -> 284), a `egress_from.sources` w planie zostawalo
# puste. Czyli deklaracja „wymagaj sieci korporacyjnej" renderowala sie na regule autoryzujaca
# z DOWOLNEGO miejsca — i wszystko po drodze swiecilo na zielono.
deny contains msg if {
	some pname, prof in input.profiles
	some rule in object.get(prof, "egress", [])
	object.get(rule, "access_levels_from", "") != ""
	msg := sprintf(
		"profiles/%s: regula egress %q deklaruje access_levels_from, a renderer sklada `egress_from` wylacznie z `identities` — deklaracja bylaby cicho gubiona. Albo dopisz `sources` do rules.tf (wraz z `source_restriction`), albo usun to pole",
		[pname, rule.title],
	)
}

valid_external_resource(res) if startswith(res, "s3://")

valid_external_resource(res) if startswith(res, "azure://")

# --- higiena wpisów ---------------------------------------------------------------------------------

# Data przeglądu w przeszłości = wpis, którego nikt nie potwierdził. Sweeper otwiera PR offboardingowy,
# ale sama bramka pilnuje, żeby taki wpis nie przeszedł niezauważony w innym PR-ze.
deny contains msg if {
	some name, m in input.members
	m.review_by < input.today
	msg := sprintf("projects.yaml[%s]: review_by (%s) minął — potwierdź wpis albo go usuń", [name, m.review_by])
}

# Wyjątek bez uzasadnienia to reguła, której nikt nie umie później ocenić.
deny contains msg if {
	some name, m in input.members
	some e in object.get(m, "exceptions", [])
	count(e.justification) < 20
	msg := sprintf("projects.yaml[%s]: wyjątek %q wymaga uzasadnienia (min. 20 znaków)", [name, e.title])
}

# Prosta różnica dat ISO (YYYY-MM-DD) w dniach — bez stref czasowych, bo okno liczymy w dobach.
days_between(from, to) := days if {
	f := time.parse_ns("2006-01-02", from)
	t := time.parse_ns("2006-01-02", to)
	days := (t - f) / 86400000000000
}
