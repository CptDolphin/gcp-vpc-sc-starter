# Kto zostaje obudzony, gdy granica psuje sie po cichu — i przy jakich progach.
#
# DLACZEGO OSOBNY PLIK, A NIE SEKCJA W `policy.yaml`. To sa dwie rozne polityki z dwoma roznymi
# wlascicielami i dwiema roznymi kadencjami zmian:
#   * `policy.yaml` odpowiada na pytanie CO GRANICA PRZEPUSZCZA. Zmienia sie przy kazdym wniosku dywizji,
#     recenzuje ja wlasciciel granicy, a kazda jej linijka renderuje sie na konfiguracje ACM.
#   * ten plik odpowiada na pytanie KOGO BOLI, GDY MASZYNERIA PRZESTANIE DZIALAC. Zmienia sie przy zmianie
#     dyzuru albo progu pojemnosci, recenzuje go SRE, i nie renderuje sie na granice ANI JEDNYM atrybutem.
# Trzymanie ich razem daloby jeden plik, w ktorym zmiana adresu e-mail wpada w te sama sciezke review co
# dopuszczenie nowego projektu do granicy — i odwrotnie: kazdy wniosek dywizji konfliktowalby z kazda
# zmiana dyzuru. Rozdzielenie kosztuje jeden `yamldecode`.
#
# BRAK TEGO PLIKU = ALERTY WYLACZONE, i to jest bezpieczna degradacja, nie awaria: `monitoring.tf` renderuje
# wtedy same metryki, bez ani jednej polityki alertu i bez ani jednego kanalu. Wdrozenie, ktore jeszcze nie
# ma dyzuru, dostaje pomiar bez fikcji, ze ktos go oglada.

schema_version: 1

# --- KANALY -----------------------------------------------------------------------------------------
#
# DWA KANALY, NIE JEDEN — i to jest wymaganie, nie estetyka. Alert pojemnosciowy („budzet sie konczy")
# czyta sie w godzinach pracy i planuje sie wokol niego prace. Alert o zmianie granicy poza pipeline'em
# jest sygnalem, ze KTOS OBSZEDL PROCES albo ze trwa incydent — ten musi trafic do innego odbiorcy niz
# ten, ktory dostaje comiesieczne „zblizasz sie do 70%". Wspolny kanal konczy sie tak samo zawsze:
# odbiorca uczy sie ignorowac cala kategorie, bo dziewiec na dziesiec wiadomosci nie wymaga reakcji.
#
# `email` to najnizszy wspolny mianownik, ktory dziala wszedzie i nie wymaga zadnego integratora. Kanal
# realnie budzacy (PagerDuty / Opsgenie / webhook do dyzuru) podmienia sie TUTAJ i nigdzie indziej —
# `monitoring.tf` czyta te dwie nazwy, nie zna typu kanalu.
#
# UWAGA OPERACYJNA, KTORA WYWRACA PIERWSZE WDROZENIE — I POPRAWKA DO NIEJ. Tryb awarii jest realny:
# polityka alertu wyglada na uzbrojona (ma `notificationChannels`), incydent sie otwiera, a do skrzynki
# nie przychodzi nic. Ale sprawdzenie, ktore tu wczesniej stalo, NIE UMIE go wykryc:
#
#   gcloud alpha monitoring channels list --project=<projekt> --format='table(...,verificationStatus)'
#
# Kolumna wraca PUSTA i zadna wersja tej komendy tego nie naprawi. `verificationStatus` jest enumem
# proto3, wiec wartosc domyslna `VERIFICATION_STATUS_UNSPECIFIED` nie serializuje sie do odpowiedzi —
# a Google opisuje ja jako „stan nieznany, pominiety ALBO NIEADEKWATNY (kanaly, ktore weryfikacji ani
# nie wspieraja, ani nie wymagaja)". Puste pole nie znaczy wiec „niezweryfikowany"; znaczy „nie wiesz".
# Zmierzone: jawna maska `?fields=...,verificationStatus` tez go nie zwraca, a po `:sendVerificationCode`
# (HTTP 200) pole NADAL nie istnieje — choc stan `UNVERIFIED` jest wartoscia niedomyslna i musialby sie
# pojawic, gdyby kanal weryfikacji wymagal. Kontrola pozytywna metody: `type`, `displayName` i `enabled`
# z tego samego odczytu przychodza poprawnie.
#
# CO SPRAWDZAC ZAMIAST TEGO (DEC-27): `python3 tools/kanaly_check.py --project <projekt>`. Narzedzie
# pyta o to, co da sie rozstrzygnac — czy kazda polityka `CRITICAL` ma kanal, ktorego DORECZENIE
# potwierdza maszyna — i nie udaje, ze wie cokolwiek o skrzynkach pocztowych. Doreczenie na `email`
# potwierdza WYLACZNIE czlowiek, po tescie negatywnym z `docs/7-alerty.md`.
channels:
  # Pojemnosc i higiena: budzet atrybutow, czlonkowie po `review_by`, nieudany apply.
  capacity:
    email: "example-platform@example.com"
  # Granica bezpieczenstwa: konfiguracja zmieniona poza Gitem, ruch odrzucony w trybie egzekwowanym.
  security:
    email: "example-secops@example.com"

  # KANAL MASZYNOWY (OPCJONALNY) — Pub/Sub. Nie budzi nikogo; odpowiada na inne pytanie: „czym UDOWODNIC,
  # ze alert naprawde odpalil". Cloud Monitoring NIE MA publicznego API do listowania incydentow
  # (`/v3/projects/X/incidents` = 404 „Method not found"), wiec bez tego kanalu jedynym dowodem zadzialania
  # alertu jest wiadomosc w cudzej skrzynce albo zrzut z konsoli — czyli nic, co da sie zapisac w runbooku
  # albo sprawdzic automatem. Wiadomosc Pub/Sub niesie pelny obiekt incydentu (`incident.state`, polityka,
  # warunek, zaobserwowana wartosc), wiec test negatywny przestaje byc deklaracja.
  #
  # DRUGIE ZASTOSOWANIE, dla ktorego ten kanal zostaje na stale: to jest wejscie dla SIEM-u. Alerty granicy
  # trafiaja tam ta sama droga co reszta telemetrii bezpieczenstwa, bez parsowania maili.
  #
  # Temat MUSI istniec i miec prawo publikacji dla agenta powiadomien Monitoringu — tworzy go
  # `iam-bootstrap` (stack czlowieka), NIE pipeline perimetru. Brak klucza = kanal nie powstaje.
  machine:
    pubsub_topic: "projects/example-monitoring/topics/example-vpcsc-alerts"

# --- PROGI ------------------------------------------------------------------------------------------
thresholds:
  # Budzet atrybutow — prog STATYCZNY, ten sam, ktorego pilnuje bramka `tools/attribute_budget.py` na PR-ze.
  # Liczony ODDZIELNIE dla `spec` (dry-run) i `status` (egzekwowana): limit 6000 jest NA KONFIGURACJE, nie
  # laczny, wiec jedna liczba dla obu myli w obie strony naraz.
  attribute_budget_percent: 70

  # Budzet atrybutow — wymiar PREDYKCYJNY. Statyczny prog mowi „gdzie jestes", predykcyjny „ile masz czasu";
  # przy +50 projektow na miesiac ta druga liczba jest wazniejsza, bo 65% z nachyleniem 200 atrybutow na
  # tydzien jest gorsze niz 72% na plaskim wykresie. `dni_do_sciany = (limit - uzyte) / nachylenie_30d`.
  days_to_limit_warning: 90
  days_to_limit_critical: 30

  # `apply` — po ilu sekundach od zmergowania zmiany granicy, ktora NIE zostala zastosowana, to jest incydent.
  # 3600 s, a nie 300: apply trwa ~60 s, ale kolejka `concurrency` przy dwoch wnioskach naraz potrafi go
  # przesunac o kilkanascie minut, a environment z wymaganym recenzentem — o tyle, ile trwa review.
  apply_pending_seconds: 3600

  # Watchdog: po ilu sekundach BRAKU pomiaru uznajemy, ze zepsul sie sam obserwator. Musi tolerowac co
  # najmniej dwa pominiete przebiegi (cron GitHuba jest best-effort i potrafi sie spoznic o kilkanascie
  # minut), stad 3x kadencja godzinna.
  watchdog_absent_seconds: 10800

  # Dryf — jak dlugo roznica miedzy Gitem a chmura musi sie UTRZYMAC, zanim uznamy ja za zmiane spoza Gita.
  # DLACZEGO NIE 0: konfiguracja w ACM zmienia sie natychmiast, ale SKUTEK propaguje sie ~20 s dluzej
  # (zmierzone przy rollbacku: 46 s do apply, 78 s do powrotu ruchu). Regula liczaca roznice w oknie
  # krotszym niz propagacja strzelalaby po KAZDYM apply i nauczylaby dyzurnego ignorowac ja w tydzien.
  # 3600 s to 180x zmierzona propagacja — margines jest tu tani, bo dryf utrzymuje sie do czasu naprawy.
  drift_persist_seconds: 3600

# --- ZRODLO ODMOW I ZMIAN KONFIGURACJI --------------------------------------------------------------
#
# SEKCJA OPCJONALNA — I JEJ BRAK MA KONSEKWENCJE, KTORE TRZEBA ZNAC. Bez niej NIE POWSTAJA dwie polityki
# alertu: „ruch odrzucony w trybie egzekwowanym” i „konfiguracja zmieniona poza pipeline'em”. To jest
# swiadomy wybor miedzy dwoma zlami: alert bez producenta chodzilby wiecznie na martwym-czlowieku (czyli
# stalym falszywym alarmem, ktorego wszyscy nauczyliby sie klikac), a brak alertu jest przynajmniej
# UCZCIWY — `docs/7-alerty.md` nazywa wtedy oba sygnaly jako niewdrozone.
#
# DLACZEGO TE WSPOLRZEDNE W OGOLE TU STOJA, ZAMIAST BYC METRYKA LOG-BASED (#2000). Metryka log-based
# liczy WYLACZNIE wpisy przyjete przez Log Router swojego projektu. Naruszenie VPC-SC powstaje w logu
# projektu-CZLONKA, a zmiana ACM — w logu ORGANIZACJI (`_Required`); do projektu administracyjnego oba
# docieraja SINKIEM, czyli do magazynu, a nie na wejscie. Zmierzone para kontrolna: 5 wpisow ZAPISANYCH
# do projektu -> metryka liczy 5; realna odmowa egzekwowana dostarczona sinkiem do kubelka W TYM SAMYM
# projekcie -> metryka liczy 0. Do tego metryki log-based istnieja tylko per projekt (`gcloud logging
# metrics` nie ma `--organization`), wiec dla zmian ACM nie ma ich gdzie postawic. Zrodlem musi byc widok.
#
# Wspolrzedne MUSZA wskazywac stack `violations-sink/` (jego wyjscia `view_name` i `config_view_name`).
violations_source:
  project_id: "example-vpcsc-admin"
  bucket: "vpcsc-violations"
  location: "eu"
  # Widok naruszen — ten sam, ktory czyta `violations-report.yml`.
  view: "vpcsc-violations"
  # Widok zmian konfiguracji granicy (Admin Activity ACM). ROZLACZNY z powyzszym.
  config_view: "vpcsc-violations-config"
  # Okno liczenia. MUSI byc WIEKSZE niz kadencja `watch.yml`, inaczej miedzy przebiegami powstaje szczelina,
  # w ktorej odmowa nie zostanie policzona przez ZADEN przebieg. 5400 s = godzinny cron + 50% zapasu na
  # spoznienie (cron GitHuba jest best-effort). Nadmiarowe nakladanie sie okien jest tu POZADANE: alert ma
  # prog „> 0”, wiec policzenie tej samej odmowy dwa razy nie zmienia decyzji, a przeoczenie — zmienia.
  window_seconds: 5400

# --- RUNBOOK ----------------------------------------------------------------------------------------
# Kazda polityka alertu niesie `documentation.links` z URL-em na KONKRETNA kotwice w `docs/7-alerty.md`.
# Alert bez procedury budzi czlowieka i zostawia go z pytaniem, co teraz — czyli jest polowa rozwiazania.
# Baza jest konfiguracja, bo docelowe repo ma inny adres niz starter; kotwice sa stale i pilnuje ich selftest.
runbook_base_url: "https://github.com/example-org/example-perimeter/blob/main/docs"
