# PRZYKŁADOWY plik członka — jeden plik = jeden projekt w perimetrze.
# Nazwa pliku: <dywizja>-<project_id>.yaml. Ten plik tworzy BOT po zatwierdzeniu ticketu w ServiceNow;
# ręcznie edytuje się go tylko przy promocji (stage) i offboardingu (usunięcie pliku).
#
# Zostaw ten przykład w repo: jest wejściem dla selftestu i żywą dokumentacją formatu. Ma stage: dry-run
# i fikcyjny numer projektu, więc nawet zaaplikowany nie chroni ani nie blokuje niczego realnego.

schema_version: 1

division: example-division
project_id: prj-example-vertex-dev
# ACM adresuje projekty NUMEREM, nie ID. Pre-flight sprawdza, że numer odpowiada temu project_id —
# literówka w numerze cicho dodałaby do perimetru CUDZY projekt.
project_number: "000000000000"

owner_group: grp-example-division-cloud@example.com
# Skąd przyszła ta zmiana. Trzy dozwolone kanały (schemas/member.schema.json):
#   snow:RITM…            formularz ServiceNow — bot weryfikuje ticket oddzwonieniem do API
#   pr:ORG/repo#123       repozytorium zespołu — weryfikowane po mapowaniu repo→dozwolone projekty
#   manual:<uzasadnienie> architekt piszący plik ręcznie; wymaga approvalu CODEOWNERS (reguła OPA)
change_ref: "snow:RITM0000000"
approved_by: net-approver@example.com

# dry-run | enforced. Jedyne pole, które przesuwa etap onboardingu (DEC-4).
# Bot ZAWSZE tworzy plik z `dry-run`; `enforced` może pojawić się wyłącznie w osobnym PR-ze promocyjnym,
# po czystym oknie obserwacji — pilnuje tego reguła OPA promotion_gate.
stage: dry-run
dry_run_since: "2026-07-28" # data wejścia do konfiguracji dry-run; liczy się od niej okno z policy.yaml
review_by: "2027-01-28" # po tej dacie expiry-sweep otwiera PR offboardingowy

profiles:
  - name: vertex-online-serving
    params:
      caller_identities:
        - "serviceAccount:sa-scoring@prj-example-app-dev.iam.gserviceaccount.com"
      access_levels:
        - corp_network

  - name: corp-user-console-access
    params:
      user_groups:
        - "group:grp-example-division-ds@example.com"
      access_levels:
        # corp_managed_device (device-trust) byloby tu mocniejszym warunkiem, ale wymaga licencji BeyondCorp
        # Enterprise — patrz access-levels/corp.yaml. Domyslny przyklad musi dzialac bez platnego dodatku.
        - corp_network

  # Ten profil jest tu po to, żeby ścieżka egress (w tym zasoby POZA GCP) była realnie renderowana i objęta
  # `terraform test`. Bez ani jednego członka z egressem cały ten kod byłby napisany, ale nieprzetestowany —
  # a to jest właśnie ta kategoria kodu, która pierwszy raz działa na produkcji.
  - name: bq-omni-external-read
    params:
      query_identities:
        - "serviceAccount:sa-analytics@prj-example-app-dev.iam.gserviceaccount.com"
      external_resources:
        # Format narzucony przez API. `arn:aws:s3:::…` byłoby odrzucone przez bramkę OPA jeszcze w PR-ze.
        - "s3://example-approved-dataset"

# Reguły spoza katalogu profili. Wymagają approvalu Security i uzasadnienia. Trzeci taki sam wyjątek
# to sygnał, żeby zrobić z niego profil — nie czwarty wyjątek (DEC-3).
exceptions: []
