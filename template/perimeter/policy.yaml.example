# perimeter/policy.yaml — baseline perimetru. WŁASNOŚĆ CENTRALNA (Security + Networking, CODEOWNERS).
#
# To jedyny plik, w którym mieszka treść chroniona przed dywizjami: lista usług objętych granicą, parametry
# okna dry-run i budżet atrybutów. Dywizje dokładają WYŁĄCZNIE pliki w members/ (i, przez wyjątek, w profiles/).
#
# DLACZEGO to nie jest zmienna Terraform: baseline ma być czytelny dla człowieka, który nie zna HCL
# (audytor, security officer, nowy członek zespołu sieciowego) i ma być diffowalny w PR bez czytania planu.

schema_version: 1

organization:
  org_id: "<ORG_ID>" # numer organizacji GCP
  # Nazwa (numer) org-level access policy. Organizacja ma DOKŁADNIE JEDNĄ taką politykę — perimetr jest
  # org-plane singletonem, stąd single-flight apply w workflow (DEC-6).
  access_policy_name: "<ACCESS_POLICY_NUMBER>"

perimeter:
  name: ai_core # nazwa techniczna (immutable po utworzeniu)
  title: "AI core perimeter"
  # BROWNFIELD vs GREENFIELD — najważniejszy przełącznik w tym pliku.
  #
  # false (DOMYŚLNIE, gdy perimetr JUŻ ISTNIEJE): Terraform NIE zarządza szkieletem. Dokłada wyłącznie
  #   członków i reguły do istniejącego perimetru, którego treść (restricted_services) pozostaje u
  #   obecnego właściciela. Blast-radius pierwszego apply = dodanie zasobów, zero ryzyka nadpisania
  #   cudzej konfiguracji. `restricted_services` niżej służy wtedy TYLKO za dokumentację i wejście dla
  #   guardów OPA — nie jest wysyłane do API.
  # true (greenfield albo świadome przejęcie): Terraform tworzy/zarządza szkieletem. Przy istniejącym
  #   perimetrze WYMAGA importu (docs/4-brownfield-import.md) — inaczej apply spróbuje utworzyć obiekt,
  #   który już jest, albo nadpisze jego treść listą z tego pliku.
  manage_skeleton: false

# Usługi objęte granicą. aiplatform = Vertex AI (Agent Engine, RAG Engine, Vector Search, Model Garden).
# DLACZEGO nie samo aiplatform: Vertex realnie czyta i pisze przez inne API — model z GCS, dane z BigQuery,
# obrazy treningowe z Artifact Registry, notebooki przez notebooks. Perimetr chroniący tylko aiplatform
# zostawia dane w miejscu, z którego i tak da się je wyprowadzić. Guard OPA (baseline_locked.rego) blokuje
# usunięcie aiplatform z tej listy.
restricted_services:
  - aiplatform.googleapis.com
  - storage.googleapis.com
  - bigquery.googleapis.com
  - artifactregistry.googleapis.com
  - notebooks.googleapis.com
  - logging.googleapis.com
  - monitoring.googleapis.com

# vpc_accessible_services = co wolno wołać Z WNĘTRZA perimetru. Trzymamy 1:1 z restricted_services.
# DLACZEGO 1:1: pod-skopowana lista cicho psuje bootstrap workloadów (usługa objęta granicą, ale
# niedostępna od środka = błąd, który wygląda jak awaria aplikacji, nie jak polityka).
vpc_accessible_services:
  enable_restriction: true
  same_as_restricted: true

# Projekty PŁASZCZYZNY STEROWANIA — te, w których leży maszyneria zarządzająca tym perimetrem.
# Bramka OPA (onboarding.rego) odrzuca każdy plik członka wskazujący projekt z tej listy.
#
# DLACZEGO ta lista istnieje: to JEDYNY tryb awarii tego repozytorium, którego `git revert` NIE COFA.
# Bucket stanu Terraform leży w projekcie administracyjnym perimetru. Gdy ten projekt trafi do konfiguracji
# EGZEKWOWANEJ, a `storage.googleapis.com` jest w restricted_services, konto apply traci dostęp do WŁASNEGO
# stanu — pipeline woła z GitHub Actions, czyli SPOZA granicy. Rewert wniosku nie pomaga, bo apply rewertu
# też potrzebuje stanu. Z tej pętli wychodzi wyłącznie człowiek z uprawnieniami org-level, ręcznie na żywej
# polityce (docs/3-runbook-promocja-i-break-glass.md). Każdą inną złą zmianę cofa `git revert` + apply.
#
# CO TU WPISAĆ — project_id albo numer projektu, numer ZAWSZE w cudzysłowach (patrz niżej):
#   * projekt bucketa STANU Terraform (contract.state_bucket, backend w terraform/versions.tf),
#   * projekt bucketa KONTRAKTÓW (contract.bucket),
#   * projekt MONITORINGU perimetru (monitoring.project_id),
#   * każdy kolejny projekt, bez którego pipeline nie umie się wykonać ANI naprawić.
#
# Numer w cudzysłowach, bo YAML bez nich daje liczbę, a `project_number` w pliku członka jest zawsze
# stringiem — porównanie nigdy by nie trafiło i bramka wyglądałaby na uzbrojoną, nie łapiąc niczego.
# Sam typ pilnują dwie warstwy: schema (`type: string`) i osobna reguła OPA, bo cichy no-op guardu jest
# gorszy od jego braku.
#
# Pusta lista jest DOPUSZCZALNA i znaczy „w tej organizacji nie ma takich projektów". Sekcja jest za to
# w schemacie WYMAGANA: brak sekcji i pusta lista dają ten sam skutek, więc różnicę między „zdecydowaliśmy"
# a „nikt o tym nie pomyślał" musi wymusić schema, a nie pamięć autora.
#
# Gdy wciągnięcie takiego projektu jest naprawdę zamierzone (np. stan przeniesiony poza perimetr), NIE
# usuwaj go z tej listy — użyj pola `control_plane_exception` w pliku członka. Usunięcie z listy wygląda
# w diffie jak sprzątanie; jawny wyjątek z uzasadnieniem wygląda na to, czym jest.
control_plane_projects: []
# Przykład wypełnionej listy:
# control_plane_projects:
#   - prj-example-vpcsc-admin
#   - "123456789012"

# Usługi, dla których Access Context Manager NIE PUBLIKUJE listy wspieranych metod — sprawdź komendą
# `gcloud access-context-manager supported-services describe <usluga>`: pole `supportedMethods` jest puste.
# Dla nich `methods: ["*"]` w profilu jest JEDYNĄ wartością, jaką API przyjmuje; wypisanie metod jawnie
# kończy się `Error 400: METHOD ... is not supported`. To nie jest poluzowanie reguły „wypisz metody jawnie",
# tylko jej granica: tam, gdzie API nie zna metod, wybór jest między `*` a regułą, która nie powstanie.
#
# Lista jest DEKLARACJĄ pod CODEOWNERS security, ale nie jest jej się wierzy na słowo: `tools/check_supported_services.py`
# w `plan.yml` porównuje ją z żywym API i PADA, gdy ktoś dopisze tu usługę, która metody publikuje
# (czyli próbuje przemycić `*` tam, gdzie da się wypisać metody) albo użyje `*` dla usługi spoza listy.
services_without_method_selectors:
  - aiplatform.googleapis.com
  - notebooks.googleapis.com
  - monitoring.googleapis.com

# Parametry dwustopniowego onboardingu (DEC-4). Zmiana tych wartości = zmiana reżimu bezpieczeństwa
# dla wszystkich dywizji, dlatego siedzą w baseline, a nie w pliku członka.
onboarding:
  dry_run_min_days: 14 # minimum od dry_run_since do promocji
  clean_window_days: 7 # ostatnie N dni muszą być bez naruszeń

# Budżet atrybutów: perimetr ma limit 6000 atrybutów NA KONFIGURACJĘ, liczony osobno dla enforced i dry-run
# (docs: VPC SC quotas). Guard CI liczy zachowawczo i pada powyżej progu — próg, nie limit, żeby zapchanie
# było wykryte z zapasem na reakcję (nowy profil / konsolidacja / decyzja o drugim perimetrze, DEC-1).
attribute_budget:
  limit_per_config: 6000
  warn_at_percent: 70

# Kontrakt — wąski JSON publikowany po każdym apply dla repozytoriów zespołów.
#
# DLACZEGO to istnieje: zespół musi wiedzieć, jakie profile są dostępne i jakich parametrów wymagają. Bez
# kontraktu musiałby wciągnąć to repo jako submodule — a wtedy dostaje RAZEM Z TYM katalog members/ wszystkich
# dywizji i wasze zakresy IP z access-levels/. Kontrakt daje mu ~4 KB tego, co potrzebuje.
#
# DLACZEGO nie data source: provider Terraforma NIE MA data source dla service perimetra (sprawdzone w google
# i google-beta — są tylko access_policy, access_policy_iam_policy i supported_service/s). Odczyt treści
# perimetru wymagałby `servicePerimeters.get` na organizacji, czyli wglądu w całą granicę. To zresztą
# oficjalna rekomendacja HashiCorpa: publikuj dane do konsumpcji zewnętrznej osobno, nie przez remote state.
contract:
  # Dedykowany bucket, NIE ten ze stanem. Jeden błąd w polityce kontraktów ma wtedy w najgorszym razie
  # skutek „ktoś przeczytał listę profili", a nie „ktoś przeczytał pełną mapę granicy".
  bucket: "<CONTRACTS_BUCKET>"
  path: "vpc-sc/contract.json"
  # Czy publikować listę członków (division/project_id/stage — BEZ reguł i tożsamości). Zespoły zwykle chcą
  # wiedzieć, czy ich projekt już jest w perimetrze i na jakim etapie.
  publish_members: true
  # Nazwa bucketa STANU — wyłącznie do guardu. Terraform nie pozwala odczytać konfiguracji backendu z HCL,
  # więc `precondition` w contract.tf nie ma jak sprawdzić samodzielnie, czy nie publikujemy kontraktu tam,
  # gdzie leży state. Ta wartość musi być identyczna z `bucket` w terraform/versions.tf.
  state_bucket: "<STATE_BUCKET>"

# Reguły ingress stosowane do KAŻDEGO członka perimetru — niezależnie od wybranych profili.
#
# DLACZEGO to nie jest profil: skanery bezpieczeństwa, monitoring i backup potrzebują dostępu do WSZYSTKICH
# projektów w perimetrze. Gdyby były profilem, każda dywizja musiałaby pamiętać, żeby go wybrać — a pierwsza,
# która zapomni, wypadnie ze skanowania dokładnie w momencie promocji do enforced. I nikt tego nie zauważy,
# bo brak findingów wygląda jak brak problemów.
#
# To jest ta klasa przepływów, o której ludzie zapominają przed pierwszym enforce: „to nasze własne narzędzia",
# a perimetr nie zna tej kategorii — widzi wywołanie API spoza granicy i odrzuca je.
#
# Każda reguła tutaj konsumuje budżet atrybutów × liczbę członków, więc trzymamy je WĄSKO: konkretne
# tożsamości, konkretne metody read-only.
baseline_ingress:
  - title: security-scanner-read
    # Konta serwisowe skanerów (CNAPP typu Wiz, SCC, agentless). Imiennie — nigdy ANY_SERVICE_ACCOUNT.
    identities:
      - "serviceAccount:<SCANNER_SA>@<SCANNER_PROJECT>.iam.gserviceaccount.com"
    # Skaner woła z własnej infrastruktury, więc nie spełni korporacyjnego access levelu. Pusta lista
    # oznacza autoryzację wyłącznie tożsamością — dopuszczalne TYLKO dla operacji read-only i tylko dla
    # tożsamości, którą sami kontrolujemy. Reguła OPA `ingress bez access levelu` jest tu świadomie
    # obchodzona przez `allow_without_access_level: true` i wymaga approvalu Security.
    access_levels: []
    allow_without_access_level: true
    operations:
      - service: storage.googleapis.com
        methods: ["google.storage.buckets.get", "google.storage.buckets.list", "google.storage.objects.list"]
      - service: compute.googleapis.com
        methods: ["InstancesService.Get", "InstancesService.List", "DisksService.Get"]
      - service: bigquery.googleapis.com
        methods: ["TableService.GetTable", "DatasetService.ListDatasets"]
      # aiplatform nie publikuje metod (services_without_method_selectors) — `*` to jedyna wartość, jaką
      # API przyjmuje. Zawężenie skanera zostaje po stronie jego własnych uprawnień IAM, nie tutaj.
      - service: aiplatform.googleapis.com
        methods: ["*"]

  # Tożsamość PIPELINE'U, który produkuje DOWÓD dla bramki promocji. To nie jest „jeszcze jeden skaner":
  # bez tej reguły system nie umie promować NIKOGO, a dowiaduje się o tym dopiero przy pierwszej promocji.
  #
  # ZMIERZONE na żywej organizacji (2026-08-10, 34 wpisy audytowe jednego członka w oknie 14 dni).
  # `violations-report.yml` uwierzytelnia się jako konto PLANU i czyta audit-log KAŻDEGO projektu
  # członkowskiego (`gcloud logging read --project=<członek>`) — bo wpis o naruszeniu VPC-SC ląduje w logu
  # projektu będącego WŁAŚCICIELEM zasobu, nie w logu organizacji. A `logging.googleapis.com` jest w
  # restricted_services, więc ten odczyt sam jest wywołaniem chronionej usługi spoza granicy. Skutki są dwa
  # i oba są ciche:
  #
  #   * W DRY-RUN każdy przebieg raportu dopisuje członkowi naruszenie od `sa-vpcsc-plan`
  #     (`LoggingServiceV2.ListLogEntries`) — narzędzie brudzi dokładnie ten dowód, który zbiera. Bramka
  #     `promotion_gate` wymaga ZERA naruszeń w oknie, więc okno nie ma jak się wyczyścić, dopóki raport
  #     chodzi. Zmierzone: 1 z 34 naruszeń członka pochodziło od konta planu, reszta od ludzi.
  #   * PO PROMOCJI ten sam odczyt zostaje ODMÓWIONY, a workflow ma `|| exit 1` (i słusznie: `gcloud logging
  #     read` przy odmowie wypisuje `[]` na stdout). Czyli pierwsza udana promocja zabiera dowód wszystkim
  #     następnym — a awaria wygląda przy tym na problem z uprawnieniami IAM, nie na skutek promocji.
  #
  # DLACZEGO baseline, a nie profil: profil trzeba wybrać, a ten przepływ dotyczy każdego członka z definicji
  # — jest częścią maszynerii perimetru, nie aplikacji dywizji. Ta sama argumentacja co przy skanerze.
  #
  # DLACZEGO tak wąsko: JEDNA metoda odczytu logów, zero zapisów, zero innych usług. Konto `apply` tej reguły
  # NIE dostaje i nie potrzebuje — pracuje na obiekcie org-level (Access Context Manager nie jest usługą
  # chronioną) oraz na własnym projekcie administracyjnym, który członkiem nie jest. Potwierdzone pomiarem:
  # zero naruszeń od `sa-vpcsc-apply` w oknie obserwacji. Reguła szersza „na wszelki wypadek" oddałaby
  # płaszczyźnie sterowania odczyt danych każdej dywizji.
  - title: platform-violations-read
    identities:
      - "serviceAccount:sa-vpcsc-plan@<PROJEKT>.iam.gserviceaccount.com"
    # Pipeline woła z runnerów GitHuba — adresy są pulą dostawcy, nie zakresem korporacyjnym, więc nie ma
    # access levelu, który mógłby to opisać uczciwie. Autoryzacja wyłącznie tożsamością, jawnie i tylko dla
    # odczytu (ta sama furtka i ten sam wymóg approvalu Security co przy skanerze).
    access_levels: []
    allow_without_access_level: true
    operations:
      - service: logging.googleapis.com
        # `logging` PUBLIKUJE listę metod (99 pozycji), więc `*` jest tu zakazane i słusznie — wypisujemy
        # dokładnie tę jedną, której używa `gcloud logging read`.
        methods: ["LoggingServiceV2.ListLogEntries"]

# Monitoring perimetru — metryki log-based i alerty (terraform/monitoring.tf).
#
# DLACZEGO to jest tutaj, a nie „w monitoringu": perimetr bez alertu jest granicą, o której dowiesz się od
# użytkownika. Trzy sygnały mają konsumenta: naruszenia ENFORCED (ktoś jest blokowany teraz — page),
# naruszenia DRY-RUN (ktoś zobaczy blokadę po promocji — informacyjnie) i zmiana konfiguracji POZA
# pipeline'em (git przestał opisywać rzeczywistość).
#
# Pominięcie tej sekcji = brak metryk i alertów. Bezpieczna degradacja w sensie „nic się nie zepsuje",
# ale świadomie ślepa — jeśli ją pomijasz, zapisz gdzieś, kto zamiast tego patrzy na SCC.
monitoring:
  # Projekt, w którym powstają metryki i alerty. Zwykle centralny projekt monitoringu, nie projekt dywizji.
  project_id: "<MONITORING_PROJECT>"
  # Kanały powiadomień (utworzone osobno — alert bez kanału to alert, którego nikt nie widzi).
  notification_channels: []
  # Konto apply pipeline'u — jego zmiany są OCZEKIWANE i wykluczamy je z alertu o zmianach poza pipeline'em.
  # Musi zgadzać się z APPLY_SERVICE_ACCOUNT w zmiennych repo, inaczej alert będzie odpalał przy każdym apply.
  apply_service_account: "sa-vpcsc-apply@<PROJEKT>.iam.gserviceaccount.com"
