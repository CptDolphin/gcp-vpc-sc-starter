#!/usr/bin/env bash
# Konfiguracja repo w GitHub Enterprise: ochrona gałęzi, environments z reviewerami, zmienne.
# Uruchom NA MASZYNIE Z DOSTĘPEM DO ENTERPRISE (VDI), z `gh` zalogowanym na konto firmowe.
#
# DLACZEGO skrypt, a nie klikanie: te ustawienia SĄ częścią mechanizmu bezpieczeństwa, nie higieną repo.
# Environment z reviewerami to jedyna bramka niezależna od CODEOWNERS — wyklikana ręcznie bywa pominięta
# przy odtwarzaniu repo i nikt tego nie zauważy, dopóki apply nie pojedzie bez zatwierdzenia.
#
# DLACZEGO SKRYPT CZYTA WYNIK Z POWROTEM: samo wysłanie PUT-a niczego nie dowodzi. Część reguł ochrony
# environment to funkcje płatne — na planie, który ich nie ma, API odpowiada 422 i environment zostaje
# BEZ ANI JEDNEJ reguły, wyglądając w kodzie i w dokumentacji na bramkę. Skrypt, który by to przemilczał,
# byłby dokładnie tym trybem awarii, przed którym ma chronić: kontrolą istniejącą wyłącznie w komentarzu.
#
#   ./bootstrap_github.sh --org <ORG> --repo gcp-vpc-sc \
#       --net-team network-team --sec-team security-team \
#       --wif "projects/123/locations/global/workloadIdentityPools/github-actions/providers/github" \
#       --sa-plan sa-vpcsc-plan@proj.iam.gserviceaccount.com \
#       --sa-apply sa-vpcsc-apply@proj.iam.gserviceaccount.com \
#       --org-id 123456789012
#
#   ...--dry-run                          # pokaż, co zostanie wykonane, bez wykonywania
#   ...--no-human-gate "<powód>"          # świadome odstępstwo: plan bez required reviewers (krok 3)
#   ...--no-branch-protection "<powód>"   # świadome odstępstwo: plan bez ochrony gałęzi (krok 4)
set -euo pipefail

ORG="" REPO="gcp-vpc-sc" NET_TEAM="" SEC_TEAM="" WIF="" SA_PLAN="" SA_APPLY="" ORG_ID="" DRY=0
NO_HUMAN_GATE="" NO_BRANCH_PROTECTION=""
while [ $# -gt 0 ]; do
  case "$1" in
    --org) shift; ORG="${1:-}" ;;
    --repo) shift; REPO="${1:-}" ;;
    --net-team) shift; NET_TEAM="${1:-}" ;;
    --sec-team) shift; SEC_TEAM="${1:-}" ;;
    --wif) shift; WIF="${1:-}" ;;
    --sa-plan) shift; SA_PLAN="${1:-}" ;;
    --sa-apply) shift; SA_APPLY="${1:-}" ;;
    --org-id) shift; ORG_ID="${1:-}" ;;
    --no-human-gate) shift; NO_HUMAN_GATE="${1:-}" ;;
    --no-branch-protection) shift; NO_BRANCH_PROTECTION="${1:-}" ;;
    --dry-run) DRY=1 ;;
    *) echo "nieznany argument: $1" >&2; exit 2 ;;
  esac
  shift
done
for v in ORG NET_TEAM SEC_TEAM WIF SA_PLAN SA_APPLY ORG_ID; do
  [ -n "${!v}" ] || { echo "brakuje --${v,,} (patrz nagłówek skryptu)" >&2; exit 2; }
done

run() {
  if [ "$DRY" -eq 1 ]; then printf '  [dry-run] %s\n' "$*"; else "$@"; fi
}

SLUG="$ORG/$REPO"
echo "== repo $SLUG =="

# 1. Repo — PRYWATNE. Treść perimetru to mapa tego, co i skąd sięga po wasze dane.
if gh repo view "$SLUG" >/dev/null 2>&1; then
  echo "  repo już istnieje — pomijam tworzenie"
else
  run gh repo create "$SLUG" --private --description "VPC Service Controls perimeter — membership and rules as code"
fi

# 2. Zmienne. NIE sekrety: to identyfikatory, nie poświadczenia — dostęp daje dopiero warunek na puli WIF.
echo "== zmienne =="
run gh variable set WIF_PROVIDER --repo "$SLUG" --body "$WIF"
run gh variable set PLAN_SERVICE_ACCOUNT --repo "$SLUG" --body "$SA_PLAN"
run gh variable set APPLY_SERVICE_ACCOUNT --repo "$SLUG" --body "$SA_APPLY"
run gh variable set ORG_ID --repo "$SLUG" --body "$ORG_ID"

# 3. Environments. DWIE WARSTWY o różnej naturze — mylenie ich to najczęstszy sposób, w jaki ta bramka
#    okazuje się nie istnieć:
#
#    (a) POLITYKA GAŁĘZI (`deployment_branch_policy`) — które refy w ogóle mogą sięgnąć po environment.
#        Działa na każdym planie, także w repozytorium prywatnym bez ochrony gałęzi. I to ONA, nie
#        reviewer, sprawia, że tożsamości apply nie da się wziąć z dowolnej gałęzi: `principalSet` puli
#        WIF pinuje samo `attribute.environment`, więc bez niej DOWOLNY ref, którego job deklaruje
#        `environment: perimeter-apply`, wymienia token na to samo konto. Ustawiamy ZAWSZE i jako
#        pierwszą — to podłoga, nie ozdoba.
#
#    (b) WYMAGANI RECENZENCI — bramka ludzka, funkcja PŁATNA. Na planie bez niej API odrzuca żądanie
#        („Please ensure the billing plan supports the required reviewers protection rule"), a environment
#        zostaje bez ani jednej reguły ochrony. Dlatego po ustawieniu CZYTAMY STAN Z POWROTEM: różnica
#        między „wysłaliśmy PUT" a „bramka istnieje" jest dokładnie tą, na której cała konstrukcja traci
#        sens po cichu.
#
#    perimeter-apply → sieć + security; break-glass → INNY zestaw (ta sama lista znosi sens rozdzielenia).
echo "== environments =="

# Polityka gałęzi jako JAWNA LISTA NAZW, nie `protected_branches: true`. Ten drugi wariant jest odesłaniem
# do innego ustawienia (ochrony gałęzi), więc dopóki tamtego nie ma — a w tym skrypcie powstaje dopiero
# w kroku 4, i na części planów nie powstanie wcale — znaczy „wolno wszystkim". Jawna nazwa nie ma takiego
# stanu pośredniego: albo ref jest na liście, albo deploy jest odrzucany.
polityka_galezi() {
  local env="$1" branch="$2"
  printf '{"deployment_branch_policy":{"protected_branches":false,"custom_branch_policies":true}}' \
    | gh api --method PUT "repos/$SLUG/environments/$env" --input - >/dev/null
  # POST jest nieidempotentny (drugi przebieg = 422 duplicate), więc najpierw pytamy o stan.
  if ! gh api "repos/$SLUG/environments/$env/deployment-branch-policies" \
       --jq '.branch_policies[].name' 2>/dev/null | grep -qx -- "$branch"; then
    printf '{"name":"%s","type":"branch"}' "$branch" \
      | gh api --method POST "repos/$SLUG/environments/$env/deployment-branch-policies" --input - >/dev/null
  fi
}

# Odczyt zwrotny: czy environment NAPRAWDĘ ma regułę wymaganych recenzentów. Pytamy API o stan, nie
# sprawdzamy kodu wyjścia PUT-a — bo bramki brakuje także wtedy, gdy PUT przeszedł, a regułę ktoś zdjął.
ma_reviewerow() {
  gh api "repos/$SLUG/environments/$1" \
    --jq '[.protection_rules[].type] | index("required_reviewers") != null' 2>/dev/null | grep -qx true
}

GALAZ_DOMYSLNA="$(gh api "repos/$SLUG" --jq .default_branch 2>/dev/null || echo main)"
for env in perimeter-apply break-glass; do
  if [ "$DRY" -eq 1 ]; then
    echo "  [dry-run] PUT environments/$env  deployment_branch_policy=[$GALAZ_DOMYSLNA]"
  else
    polityka_galezi "$env" "$GALAZ_DOMYSLNA"
    echo "  $env: do deployu dopuszczona wyłącznie gałąź $GALAZ_DOMYSLNA"
  fi
done

# UWAGA: `gh api` przy 404 wypisuje treść błędu na STDOUT, więc sprawdzenie "czy pusto" NIE wystarcza —
# do payloadu trafiłby wtedy JSON błędu zamiast ID. Wymagamy liczby (wykryte na dry-run).
team_id() {
  local out
  out="$(gh api "orgs/$ORG/teams/$1" --jq .id 2>/dev/null || true)"
  case "$out" in
    ''|*[!0-9]*) return 1 ;;
    *) printf '%s' "$out" ;;
  esac
}

if ! net_id="$(team_id "$NET_TEAM")" || ! sec_id="$(team_id "$SEC_TEAM")"; then
  echo "  BŁĄD: nie znaleziono zespołu ($NET_TEAM / $SEC_TEAM) w orgu $ORG — albo brak uprawnień do jego odczytu." >&2
  echo "  Environment bez wymaganych reviewerów jest GORSZY niż jego brak: wygląda na bramkę, a przepuszcza apply." >&2
  exit 1
fi

# `deployment_branch_policy` powtórzone w tym payloadzie CELOWO: PUT opisuje environment w całości, więc
# pominięcie pola grozi cofnięciem trybu ustawionego wyżej. Nazwane gałęzie żyją w osobnym podzasobie
# i ten PUT ich nie dotyka (sprawdzone odczytem po obu żądaniach).
env_payload() {
  python3 -c "
import json,sys
ids = [int(x) for x in sys.argv[1:]]
print(json.dumps({'wait_timer': 0, 'reviewers': [{'type': 'Team', 'id': i} for i in ids],
                  'deployment_branch_policy': {'protected_branches': False, 'custom_branch_policies': True}}))
" "$@"
}

if [ "$DRY" -eq 1 ]; then
  echo "  [dry-run] PUT repos/$SLUG/environments/perimeter-apply  reviewers=[$net_id,$sec_id]"
  echo "  [dry-run] PUT repos/$SLUG/environments/break-glass      reviewers=[$sec_id]  <-- podmień na własny zestaw"
else
  # `|| true`: 422 z powodu planu NIE MA tu przerywać skryptu — wynik i tak rozstrzyga odczyt niżej,
  # a przerwanie w tym miejscu zostawiłoby repo bez ochrony gałęzi z kroku 4.
  env_payload "$net_id" "$sec_id" | gh api --method PUT "repos/$SLUG/environments/perimeter-apply" --input - >/dev/null || true
  # break-glass: świadomie WĄSKI i INNY zestaw — dostosuj do waszego on-call, nie zostawiaj domyślnego.
  env_payload "$sec_id" | gh api --method PUT "repos/$SLUG/environments/break-glass" --input - >/dev/null || true

  brak=""
  for env in perimeter-apply break-glass; do
    ma_reviewerow "$env" || brak="$brak $env"
  done
  if [ -n "$brak" ]; then
    {
      echo
      echo "  BRAMKA LUDZKA NIE ISTNIEJE dla:$brak"
      echo "  Nieważne, czy PUT zwrócił błąd — odczyt z API mówi, że reguły 'required_reviewers' tam nie ma."
      echo "  Najczęstsza przyczyna: plan GitHuba bez tej funkcji dla repozytoriów prywatnych."
      echo "  Co zostaje i jest realne: polityka gałęzi (wyżej), warunek na environment w puli WIF, IAM Deny"
      echo "  na kasowaniu perimetru i bramki OPA uruchamiane PONOWNIE na planie w apply. Wszystkie maszynowe;"
      echo "  żadna nie zastępuje pary oczu na tym, CO wchodzi do granicy."
    } >&2
    if [ -z "$NO_HUMAN_GATE" ]; then
      {
        echo "  Skrypt kończy się BŁĘDEM celowo: brak bramki, o której mówią komentarze w repo, ma być"
        echo "  decyzją zapisaną z powodem, nie przeoczeniem odkrytym po pierwszym apply bez zatwierdzenia."
        echo "  Świadome odstępstwo: --no-human-gate \"<powód>\"."
      } >&2
      exit 1
    fi
    echo "  ODSTĘPSTWO ŚWIADOME: $NO_HUMAN_GATE" >&2
  else
    echo "  wymagani recenzenci potwierdzeni odczytem: perimeter-apply, break-glass"
  fi
fi

# 4. Ochrona main. `validate` i `plan` jako wymagane statusy — bez nich merge nie wie, czy zmiana jest legalna.
#
# TO JEST PREREKWIZYT, NIE OZDOBA — ale nie z tego powodu, z którego był nim kiedyś, i ta różnica jest
# warta przeczytania. Bramki (schema, OPA, budżet, bramki żywe, pre-flight) biegną dziś na OBU torach:
# na pull requeście i u mutatora (DEC-16, DEC-24), więc push prosto na gałąź domyślną przechodzi przez
# nie TAK SAMO. Zrobiono tak świadomie, bo ochrona gałęzi na repozytorium prywatnym bywa funkcją płatną,
# a bramka, której istnienie zależy od planu cenowego, nie jest bramką. Ochrona gałęzi daje więc to,
# czego bramka dać nie może: REVIEW — CODEOWNERS, drugą parę oczu i opis zmiany. Bez niej każde
# poświadczenie z prawem zapisu do tego repozytorium — CI, integracja ticketowa, token dywizji — zmienia
# granicę organizacji bez czyjegokolwiek spojrzenia, choćby wszystkie bramki świeciły na zielono.
#
# Dlatego kanał dywizji został przestawiony na `workflow_dispatch` (`actions: write`, zero prawa zapisu),
# a ten skrypt kończy się BŁĘDEM, gdy ochrony nie ma. Ta sama konwencja co przy bramce ludzkiej: brak ma
# być decyzją zapisaną z powodem (`--no-branch-protection "<powód>"`), a nie odkryciem po fakcie.
echo "== ochrona main =="
protection='{
  "required_status_checks": {"strict": true, "contexts": ["declarations", "terraform", "plan"]},
  "enforce_admins": true,
  "required_pull_request_reviews": {"required_approving_review_count": 1, "require_code_owner_reviews": true},
  "restrictions": null,
  "allow_force_pushes": false,
  "allow_deletions": false
}'
if [ "$DRY" -eq 1 ]; then
  echo "  [dry-run] PUT repos/$SLUG/branches/main/protection (status checks + CODEOWNERS + no force-push)"
  echo "  [dry-run] GET repos/$SLUG/branches/$GALAZ_DOMYSLNA/protection  <-- odczyt rozstrzyga, nie PUT"
else
  # Ochrona gałęzi w repozytorium PRYWATNYM bywa funkcją płatną. Nie przerywamy na PUT, bo jego kod wyjścia
  # niczego nie dowodzi w żadną stronę — rozstrzyga ODCZYT niżej. Treść odpowiedzi zapisujemy, żeby móc
  # nazwać PRZYCZYNĘ: „nie ma ochrony" i „ten plan nie ma z czego jej zrobić" to dwie różne decyzje.
  odpowiedz_put="$(printf '%s' "$protection" \
    | gh api --method PUT "repos/$SLUG/branches/main/protection" --input - 2>&1 >/dev/null || true)"
  if odczyt="$(gh api "repos/$SLUG/branches/$GALAZ_DOMYSLNA/protection" 2>&1)"; then
    echo "  ochrona $GALAZ_DOMYSLNA potwierdzona odczytem"
    # Sam fakt istnienia ochrony to nie to samo co ochrona, o której mówi dokumentacja. Wymagane statusy
    # są tą jej częścią, która realnie uruchamia bramki treści — a da się je zdjąć, zostawiając resztę.
    braki="$(printf '%s' "$odczyt" | python3 -c '
import json, sys
d = json.load(sys.stdin)
ctx = set(d.get("required_status_checks", {}).get("contexts", []))
brak = [c for c in ("declarations", "terraform", "plan") if c not in ctx]
print(",".join(brak))
' 2>/dev/null || echo "?")"
    [ -z "$braki" ] || echo "  UWAGA: ochrona istnieje, ale bez wymaganych statusów: $braki" >&2
  else
    powod='odczyt z API jej nie widzi'
    case "$odpowiedz_put$odczyt" in
      *pgrade\ to\ GitHub*)
        powod='API odpowiada 403 "Upgrade to GitHub Pro or make this repository public to enable this
  feature", czyli TEN PLAN NIE MA OCHRONY GAŁĘZI DLA REPOZYTORIÓW PRYWATNYCH. To nie jest błąd
  konfiguracji i nie da się tego naprawić żądaniem' ;;
    esac
    {
      echo "  OCHRONA GAŁĘZI $GALAZ_DOMYSLNA NIE ISTNIEJE — $powod."
      echo '  Skutek: do gałęzi domyślnej można wypchnąć commit z pominięciem PR-a, bramek i CODEOWNERS,'
      echo '  a apply rusza z pushem na tę gałąź. Każde poświadczenie z prawem zapisu do tego repozytorium'
      echo '  jest wtedy ścieżką do zmiany granicy organizacji bez ani jednej bramki treści.'
      echo '  Upublicznienie repo perimetru NIE jest obejściem: jego treść to mapa tego, co i skąd sięga'
      echo '  po wasze dane. Wyjścia są dwa: plan GitHuba z ochroną gałęzi dla repo prywatnych albo'
      echo '  świadome odstępstwo z powodem.'
      echo '  Co zostaje bez niej i jest realne: kanał dywizji na workflow_dispatch (token dywizji nie ma'
      echo '  prawa zapisu), polityka gałęzi environmentu, warunek na environment w puli WIF, IAM Deny'
      echo '  i bramki OPA uruchamiane PONOWNIE na planie w apply. Żadna z nich nie zatrzymuje pushu na'
      echo '  gałąź domyślną — zatrzymuje go WYŁĄCZNIE ochrona gałęzi.'
    } >&2
    if [ -z "$NO_BRANCH_PROTECTION" ]; then
      echo "  Świadome odstępstwo: --no-branch-protection \"<powód>\"." >&2
      exit 1
    fi
    echo "  ODSTĘPSTWO ŚWIADOME: $NO_BRANCH_PROTECTION" >&2
  fi
fi

echo
echo "== stan faktyczny (odczytany, nie założony) =="
for env in perimeter-apply break-glass; do
  # `join` na pustej liście daje "" — a "" w jq jest PRAWDĄ, więc `// "BRAK"` nigdy by nie zadziałało.
  # Stąd jawne `if length == 0`. Pusta lista gałęzi przy trybie „lista jawna" znaczy, że deployu nie zrobi
  # ŻADEN ref — odwrotnie niż brak polityki, przy którym może każdy. Te dwa stany trzeba rozróżnić w druku.
  reguly="$(gh api "repos/$SLUG/environments/$env" \
    --jq '[.protection_rules[].type] | if length == 0 then "BRAK" else join(",") end' 2>/dev/null || echo "?")"
  tryb="$(gh api "repos/$SLUG/environments/$env" \
    --jq 'if .deployment_branch_policy == null then "KAZDA GALAZ" else "lista jawna" end' 2>/dev/null || echo "?")"
  galezie="$(gh api "repos/$SLUG/environments/$env/deployment-branch-policies" \
    --jq '[.branch_policies[].name] | join(",")' 2>/dev/null || echo "")"
  printf '  %s: reguly ochrony=%s | polityka galezi=%s %s\n' \
    "$env" "$reguly" "$tryb" "${galezie:+($galezie)}"
done

# Ochrona gałęzi domyślnej w tym samym druku, i z tego samego powodu co environmenty: to jedyna warstwa,
# która zatrzymuje push z pominięciem bramek treści. Bez niej w wierszu stoi BRAK — nie „?", bo brak
# odpowiedzi z API i brak ochrony znaczą tu dokładnie to samo dla kogoś, kto push wykonuje.
ochrona="$(gh api "repos/$SLUG/branches/$GALAZ_DOMYSLNA/protection" \
  --jq '[(.required_status_checks.contexts // [] | join(",")),
         (if .required_pull_request_reviews then "review" else "bez review" end),
         (if .enforce_admins.enabled then "admini tez" else "admini pomijaja" end)] | join(" | ")' \
  2>/dev/null || echo "BRAK")"
printf '  %s (galaz domyslna): ochrona=%s\n' "$GALAZ_DOMYSLNA" "${ochrona:-BRAK}"

cat <<'NEXT'

Gotowe. Weryfikacja końcowa (uruchom i przeczytaj wynik, nie zakładaj):
  gh api repos/<ORG>/<REPO>/environments/perimeter-apply --jq '.protection_rules'
  gh api repos/<ORG>/<REPO>/branches/main/protection --jq '.required_pull_request_reviews'
  git push origin main            # ma zostać ODRZUCONE — jeśli przeszło, ochrona nie działa

Test NEGATYWNY polityki gałęzi (jedyny dowód, że działa): na gałęzi roboczej dodaj workflow z jobem
`environment: perimeter-apply` i jednym `echo`, wypchnij ją i sprawdź, że przebieg zostaje ODRZUCONY
z „Branch ... is not allowed to deploy to perimeter-apply due to environment protection rules".
Job, który wystartował, znaczy, że każda gałąź sięga po tożsamość apply.

Dopiero potem: pierwszy PR z bramkami bez chmury, a po nim plan na żywej organizacji.
NEXT
