{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/vpc-sc/access-level.schema.json",
  "title": "Access levels",
  "description": "Warunki KONTEKSTU dla wywołań spoza perimetru. Poziom ma albo warunki `basic`, albo `custom_expression` (CEL) — nigdy oba.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "access_levels"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "access_levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "title"
        ],
        "allOf": [
          {
            "$comment": "OR = alternatywa warunków, czyli SŁABSZA polityka przy jednosłownym diffie. Uzasadnienie jest obowiązkowe, żeby osłabienie było widoczne w pliku, a nie tylko w intencji autora.",
            "if": {
              "properties": {
                "combining_function": {
                  "const": "OR"
                }
              },
              "required": [
                "combining_function"
              ]
            },
            "then": {
              "required": [
                "or_reason"
              ]
            },
            "else": {
              "$comment": "Bez OR uzasadnienie nie ma czego uzasadniać — a zostawione po powrocie do AND wygląda w review na aktualne.",
              "not": {
                "required": [
                  "or_reason"
                ]
              }
            }
          },
          {
            "$comment": "`armed: false` = poziom dziś nie wpuszcza nikogo. Powód jest obowiązkowy, bo bez niego nie da się odróżnić decyzji od niedokończonej roboty — a to jest CAŁA różnica między świadomym placeholderem a defektem. Pola wygaszające i atestacyjne wykluczają się nawzajem: nieuzbrojony poziom nie ma czego atestować, uzbrojony nie ma czego wygaszać.",
            "if": {
              "properties": {
                "armed": {
                  "const": false
                }
              },
              "required": [
                "armed"
              ]
            },
            "then": {
              "required": [
                "unarmed_reason"
              ],
              "allOf": [
                {
                  "not": {
                    "required": [
                      "source_of_truth"
                    ]
                  }
                },
                {
                  "not": {
                    "required": [
                      "reviewed"
                    ]
                  }
                }
              ]
            },
            "else": {
              "allOf": [
                {
                  "not": {
                    "required": [
                      "unarmed_reason"
                    ]
                  }
                },
                {
                  "not": {
                    "required": [
                      "unarmed_accepted_until"
                    ]
                  }
                }
              ]
            }
          },
          {
            "$comment": "Poziom uzbrojony oparty na zakresach IP musi powiedzieć, SKĄD wartość i KIEDY potwierdzona. Bez tego „zakres jest aktualny\" jest zdaniem bez autora i bez daty — a to jest dokładnie ta informacja, której brak sprawia, że zakres zmieniony wygląda identycznie jak zakres działający.",
            "if": {
              "allOf": [
                {
                  "required": [
                    "ip_subnetworks"
                  ]
                },
                {
                  "not": {
                    "properties": {
                      "armed": {
                        "const": false
                      }
                    },
                    "required": [
                      "armed"
                    ]
                  }
                }
              ]
            },
            "then": {
              "required": [
                "source_of_truth",
                "reviewed"
              ]
            }
          }
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,49}$",
            "description": "short_name obiektu ACM: musi zaczynać się literą i zawierać wyłącznie znaki alfanumeryczne oraz `_`. Myślnik odrzuca API — i to dopiero na apply."
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "combining_function": {
            "enum": [
              "AND",
              "OR"
            ],
            "description": "Domyślnie AND. OR zamienia listę warunków w alternatywę — słabsza polityka, łatwa do przeoczenia w review. Wymaga `or_reason`."
          },
          "or_reason": {
            "type": "string",
            "minLength": 20,
            "description": "Dlaczego alternatywa jest tu zamierzona. Wymagane przy `combining_function: OR` i zabronione bez niego — inaczej uzasadnienie przeżywa powrót do AND i przestaje cokolwiek znaczyć."
          },
          "armed": {
            "type": "boolean",
            "description": "Czy ktokolwiek może dziś spełnić ten poziom. `false` = poziom nie autoryzuje nikogo (placeholder, niegotowa procedura, nieosiągalny składnik kompozycji). Domyślnie `true`."
          },
          "unarmed_reason": {
            "type": "string",
            "minLength": 30,
            "description": "Dlaczego poziom jest nieuzbrojony. Wymagane przy `armed: false`, zabronione bez niego."
          },
          "unarmed_accepted_until": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Data, do której wolno referować ten nieuzbrojony poziom z konfiguracji EGZEKWOWANEJ. Reguła oparta na nim nie wpuszcza nikogo — zapis jest świadomy i WYGASA, żeby nie został na zawsze."
          },
          "source_of_truth": {
            "type": "string",
            "minLength": 10,
            "description": "Skąd pochodzą zakresy: obiekt na firewallu, pula NAT, koncentrator VPN, wpis CMDB. Wymagane dla uzbrojonego poziomu z `ip_subnetworks`."
          },
          "reviewed": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Kiedy zespół sieciowy ostatni raz potwierdził, że zakresy nadal są ich. Wymagane dla uzbrojonego poziomu z `ip_subnetworks`."
          },
          "review_interval_days": {
            "type": "integer",
            "minimum": 30,
            "maximum": 730,
            "description": "Po ilu dniach potwierdzenie z `reviewed` się przeterminowuje (domyślnie 180). Przeterminowane na poziomie referowanym przez konfigurację EGZEKWOWANĄ = czerwony plan."
          },
          "ip_subnetworks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "members": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(user|group|serviceAccount):"
            }
          },
          "regions": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            }
          },
          "negate": {
            "type": "boolean",
            "description": "Odwraca sens CAŁEGO warunku. Poziom `block-x` z negate przepuszcza wszystko POZA x — inna polityka niż `blokuj x`."
          },
          "required_access_levels": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,49}$"
            },
            "description": "Kompozycja z innych poziomów (nazwy, nie pełne ścieżki — renderer je rozwija)."
          },
          "custom_expression": {
            "type": "string",
            "minLength": 10,
            "description": "Wyrażenie CEL. Wyklucza się z warunkami basic; trudniejsze do audytu, więc tylko gdy basic nie wystarcza."
          },
          "device_policy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "require_screen_lock": {
                "type": "boolean"
              },
              "require_corp_owned": {
                "type": "boolean"
              },
              "require_admin_approval": {
                "type": "boolean"
              },
              "allowed_encryption_statuses": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "allowed_device_management_levels": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "os_constraints": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "os_type"
                  ],
                  "properties": {
                    "os_type": {
                      "type": "string"
                    },
                    "minimum_version": {
                      "type": "string"
                    },
                    "require_verified_chrome_os": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
