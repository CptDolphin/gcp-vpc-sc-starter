{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/vpc-sc/policy.schema.json",
  "title": "Perimeter baseline",
  "description": "Baseline perimetru — własność centralna. Schema pilnuje kształtu; to, że aiplatform nie może z tej listy wypaść, pilnuje osobno reguła OPA baseline_locked (schema nie widzi, co było wcześniej).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "organization",
    "perimeter",
    "restricted_services",
    "vpc_accessible_services",
    "control_plane_projects",
    "onboarding",
    "attribute_budget"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "org_id",
        "access_policy_name"
      ],
      "properties": {
        "org_id": {
          "type": "string",
          "minLength": 1
        },
        "access_policy_name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "perimeter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "title"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,49}$",
          "description": "short_name perimetru: litera na początku, dalej wyłącznie alfanumeryczne i `_` (myślnik odrzuca API). Niezmienny po utworzeniu."
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "manage_skeleton": {
          "type": "boolean",
          "description": "false = brownfield (Terraform dokłada tylko członków i reguły do istniejącego perimetru); true = zarządzamy szkieletem (przy istniejącym perimetrze wymaga importu)."
        }
      }
    },
    "restricted_services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9.-]+\\.googleapis\\.com$"
      },
      "contains": {
        "const": "aiplatform.googleapis.com"
      },
      "description": "Vertex AI chroniony od dnia zero — `contains` czyni z tego warunek składniowy, nie ustalenie ustne."
    },
    "vpc_accessible_services": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enable_restriction",
        "same_as_restricted"
      ],
      "properties": {
        "enable_restriction": {
          "type": "boolean"
        },
        "same_as_restricted": {
          "type": "boolean"
        }
      }
    },
    "control_plane_projects": {
      "type": "array",
      "description": "Projekty plaszczyzny sterowania perimetru: bucket stanu Terraform, bucket kontraktow, monitoring. Bramka OPA odrzuca plik czlonka wskazujacy ktorykolwiek z nich, bo wciagniecie ich do konfiguracji egzekwowanej odcina konto apply od wlasnego stanu — jedyny tryb awarii, ktorego `git revert` nie cofa. WYMAGANA, choc moze byc pusta: brak sekcji i pusta lista daja ten sam skutek, wiec swiadoma decyzje 'nie mamy takich projektow' musi wymusic schema, a nie pamiec autora.",
      "items": {
        "type": "string",
        "pattern": "^([a-z][a-z0-9-]{4,28}[a-z0-9]|[0-9]{6,20})$",
        "description": "project_id albo numer projektu. Numer MUSI byc stringiem — YAML bez cudzyslowow daje liczbe, a porownanie z project_number (zawsze string) nigdy by nie trafilo: bramka wygladalaby na uzbrojona, nie lapiac niczego."
      },
      "uniqueItems": true
    },
    "onboarding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dry_run_min_days",
        "clean_window_days"
      ],
      "properties": {
        "dry_run_min_days": {
          "type": "integer",
          "minimum": 1
        },
        "clean_window_days": {
          "type": "integer",
          "minimum": 1
        },
        "promotion_waivers": {
          "type": "array",
          "description": "Wyjatki od bramki promocji — per czlonek, z data waznosci i uzasadnieniem. Zyja TUTAJ, a nie w pliku czlonka, bo ten plik jest pod CODEOWNERS Security: wyjatek w pliku czlonka pozwalalby dywizji zwolnic sie z bramki wlasnym PR-em. `expires` jest obowiazkowe — wyjatek bezterminowy to obnizenie baseline pod inna nazwa.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "member",
              "justification",
              "approved_by",
              "expires"
            ],
            "properties": {
              "member": {
                "type": "string",
                "description": "Klucz czlonka `<dywizja>-<project_id>` (ten sam, ktorym adresuje go renderer)."
              },
              "justification": {
                "type": "string",
                "minLength": 40,
                "description": "Dlaczego warunek nie da sie spelnic i dlaczego promocja mimo to jest bezpieczna. Prog dwa razy wyzszy niz przy `exceptions` czlonka — to zwalnia z warunku chroniacego cala dywizje przed odcieciem ruchu."
              },
              "approved_by": {
                "type": "string"
              },
              "expires": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "accept_dry_run_days_below_minimum": {
                "type": "boolean",
                "description": "Zwalnia z minimum dni w dry-run dla TEGO czlonka."
              },
              "accept_violations_up_to": {
                "type": "integer",
                "minimum": 1,
                "description": "Maksymalna liczba naruszen w oknie, ktora wyjatek bierze na siebie. LICZBA, nie flaga: pojawienie sie nowego przeplywu znow zatrzymuje promocje."
              }
            }
          }
        }
      }
    },
    "egress_approvals": {
      "type": "array",
      "description": "Zgody Security na profil `risk: high` — czyli na jedyna klase regul, ktora pozwala danym opuscic Google Cloud. Zyja TUTAJ, a nie w `perimeter/projects.yaml`, bo tamten plik ma w CODEOWNERS wylacznie zespol sieciowy: zgoda w pliku wnioskodawcy to zgoda wystawiana samemu sobie. Egzekwuje je regula OPA `vpcsc.onboarding` (biegnie na obu torach — pull request i apply), a nie CODEOWNERS: rozdzielenie wniosku zwyklego od wysokiego ryzyka idzie po ZAWARTOSCI wpisu, a CODEOWNERS dopasowuje sciezki. Brak tej sekcji NIE rozbraja bramki — reguly czytaja ja przez `object.get` z pusta lista, wiec kazdy taki wniosek odpada (DEC-23).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "member",
          "profile",
          "destinations",
          "approved_by",
          "expires",
          "justification"
        ],
        "properties": {
          "member": {
            "type": "string",
            "description": "Klucz czlonka `<dywizja>-<project_id>` — ten sam, ktorym adresuje go renderer i `promotion_waivers`."
          },
          "profile": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,40}$",
            "description": "Nazwa profilu z `perimeter/profiles/`. Zgoda dotyczy PARY (czlonek, profil): ten sam czlonek moze miec drugi profil wysokiego ryzyka i to jest osobna decyzja."
          },
          "destinations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "Dokladny zbior celow, ktory ta zgoda pokrywa (`s3://BUCKET`, `azure://...`, numer projektu). ZBIOR, nie flaga: cel jest calym ryzykiem, a jego podmiana byla by rutynowym diffem w pliku, ktorego Security nie oglada. Cel spoza tej listy odrzuca osobna regula."
          },
          "approved_by": {
            "type": "string",
            "description": "Kto z Security wydal zgode. Dowodem jest ten plik i jego CODEOWNERS; pole mowi, kogo pytac, gdy trzeba ja odtworzyc."
          },
          "expires": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "Data wygasniecia — OBOWIAZKOWA. Bezterminowa zgoda na wyprowadzanie danych poza Google Cloud to obnizenie baseline pod inna nazwa (ten sam powod co przy `promotion_waivers.expires`). Po tej dacie wniosek znow wymaga decyzji."
          },
          "justification": {
            "type": "string",
            "minLength": 40,
            "description": "Jakie dane wyplywaja, dokad i dlaczego to jest akceptowalne. Prog ten sam co przy `promotion_waivers` — obie zgody zwalniaja z warunku chroniacego cos wiekszego niz jeden wniosek."
          }
        }
      }
    },
    "attribute_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "limit_per_config",
        "warn_at_percent"
      ],
      "properties": {
        "limit_per_config": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6000
        },
        "warn_at_percent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bucket",
        "path"
      ],
      "description": "Publikacja wąskiego JSON-a dla repozytoriów zespołów. Bucket MUSI być inny niż bucket stanu.",
      "properties": {
        "bucket": {
          "type": "string",
          "minLength": 3
        },
        "path": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9/_.-]*\\.json$"
        },
        "publish_members": {
          "type": "boolean"
        },
        "state_bucket": {
          "type": "string",
          "description": "Nazwa bucketa stanu — tylko do guardu w contract.tf (backendu nie da się odczytać z HCL). Musi być identyczna z bucket w terraform/versions.tf."
        }
      }
    },
    "baseline_ingress": {
      "type": "array",
      "description": "Reguły ingress stosowane do KAŻDEGO członka (skanery, monitoring, backup). Każda konsumuje budżet atrybutów × liczba członków, więc trzymaj je wąsko.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "identities",
          "operations"
        ],
        "properties": {
          "title": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,60}$"
          },
          "identities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "access_levels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allow_without_access_level": {
            "type": "boolean",
            "description": "Świadome dopuszczenie reguły bez access levelu — TYLKO dla operacji read-only tożsamości, którą sami kontrolujemy. Wymaga approvalu Security (CODEOWNERS na policy.yaml)."
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "service",
                "methods"
              ],
              "properties": {
                "service": {
                  "type": "string",
                  "pattern": "^[a-z0-9.-]+\\.googleapis\\.com$"
                },
                "methods": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "description": "Metody wypisane jawnie. `*` jest dopuszczalne WYLACZNIE dla uslug, ktorym Access Context Manager nie publikuje listy metod (supportedMethods puste — patrz policy.yaml §services_without_method_selectors); tam jest jedyna wartoscia, jaka API przyjmuje. Schema nie umie tego rozstrzygnac, bo zalezy od stanu API, wiec zawezenie egzekwuja dwie warstwy wyzej: regula OPA (na planie) i tools/check_supported_services.py (na zywej liscie uslug)."
                  }
                }
              }
            }
          }
        }
      }
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "apply_service_account"
      ],
      "description": "Metryki log-based i alerty. Pominięcie sekcji = brak monitoringu perimetru (świadoma ślepota, nie awaria).",
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 4
        },
        "notification_channels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "apply_service_account": {
          "type": "string",
          "format": "email"
        }
      }
    },
    "services_without_method_selectors": {
      "type": "array",
      "description": "Uslugi, dla ktorych ACM nie publikuje listy metod (supportedMethods puste) — tylko dla nich profil moze uzyc methods: [\"*\"]. Lista jest konfrontowana z zywym API przez tools/check_supported_services.py w plan.yml.",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+\\.googleapis\\.com$"
      },
      "uniqueItems": true
    }
  }
}
