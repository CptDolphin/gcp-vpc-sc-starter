{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/vpc-sc/alerting.schema.json",
  "title": "Alerting perimetru",
  "description": "Kto zostaje obudzony i przy jakich progach. Plik jest OPCJONALNY — jego brak wyłącza polityki alertów (bezpieczna degradacja), ale gdy już jest, musi być kompletny: alert z połową konfiguracji budzi człowieka i nie mówi mu, do kogo należy problem.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "channels",
    "thresholds",
    "runbook_base_url"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "channels": {
      "type": "object",
      "additionalProperties": false,
      "description": "DWA kanały, bo alert pojemnościowy i alert o obejściu procesu mają różnych odbiorców. Wspólny kanał kończy się wyuczoną obojętnością na całą kategorię.",
      "required": [
        "capacity",
        "security"
      ],
      "properties": {
        "capacity": {
          "$ref": "#/$defs/channel"
        },
        "security": {
          "$ref": "#/$defs/channel"
        },
        "machine": {
          "type": "object",
          "additionalProperties": false,
          "description": "Kanał maszynowy (Pub/Sub) — OPCJONALNY. Nie budzi nikogo; niesie pełny obiekt incydentu, więc jest jedynym dowodem odpalenia alertu możliwym do sprawdzenia automatem (Cloud Monitoring nie ma publicznego API do listowania incydentów). Drugie zastosowanie: wejście dla SIEM-u.",
          "required": [
            "pubsub_topic"
          ],
          "properties": {
            "pubsub_topic": {
              "type": "string",
              "pattern": "^projects/[a-z0-9-]+/topics/[A-Za-z0-9._~%+-]+$",
              "description": "PEŁNA ścieżka tematu (`projects/<projekt>/topics/<temat>`), nie sama nazwa — Cloud Monitoring przyjmuje wyłącznie tę postać, a sama nazwa daje kanał, który powstaje i nie publikuje niczego."
            }
          }
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attribute_budget_percent",
        "days_to_limit_warning",
        "days_to_limit_critical",
        "apply_pending_seconds",
        "watchdog_absent_seconds",
        "drift_persist_seconds"
      ],
      "properties": {
        "attribute_budget_percent": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100,
          "description": "Próg statyczny budżetu atrybutów, liczony OSOBNO dla `spec` i `status`."
        },
        "days_to_limit_warning": {
          "type": "integer",
          "minimum": 1,
          "description": "Prognoza wyczerpania budżetu — poziom ostrzegawczy. MUSI być większy od `days_to_limit_critical`, inaczej warning nigdy nie odpali przed criticalem."
        },
        "days_to_limit_critical": {
          "type": "integer",
          "minimum": 1
        },
        "apply_pending_seconds": {
          "type": "integer",
          "minimum": 300,
          "description": "Minimum 300 s: apply trwa ~60 s, a serializacja `concurrency` przy dwóch wnioskach naraz przesuwa go o kilka minut. Niżej alert opisywałby normalną pracę pipeline'u."
        },
        "watchdog_absent_seconds": {
          "type": "integer",
          "minimum": 3600,
          "description": "Musi tolerować co najmniej dwa pominięte przebiegi obserwatora — cron GitHuba jest best-effort."
        },
        "drift_persist_seconds": {
          "type": "integer",
          "minimum": 600,
          "description": "Jak długo różnica Git↔chmura musi się utrzymać. Minimum 600 s, bo skutek zmiany w ACM propaguje się ~20 s dłużej niż sama konfiguracja — krótsze okno strzela po każdym apply."
        }
      }
    },
    "runbook_base_url": {
      "type": "string",
      "pattern": "^https://[^ ]+[^/ ]$",
      "description": "Baza URL dokumentacji BEZ ukośnika na końcu — polityki doklejają `/7-alerty.md#kotwica`. Ukośnik na końcu dałby `//7-alerty.md`, czyli 404 z alertu o 3:00."
    },
    "violations_source": {
      "type": "object",
      "additionalProperties": false,
      "description": "Widoki kubełka sinka, z których liczą się metryki odmów i zmian konfiguracji granicy. OPCJONALNE, ale brak tej sekcji NIE tworzy dwóch polityk alertu (odmowa egzekwowana, zmiana poza pipeline'em) — bo nie miałby ich kto zasilać. DLACZEGO widok, a nie metryka log-based: metryka log-based liczy wyłącznie wpisy przyjęte przez Log Router własnego projektu, a te wpisy powstają w projekcie członka (naruszenia) albo w logu organizacji (ACM) i docierają sinkiem do MAGAZYNU, nie na wejście — zmierzone parą kontrolną w #2000. Wartości biorą się z wyjść stacku `violations-sink/`.",
      "required": [
        "project_id",
        "bucket",
        "location",
        "view",
        "config_view"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$",
          "description": "Projekt administracyjny z kubełkiem sinka. MUSI leżeć POZA perimetrem — kubełek wewnątrz granicy odcinałby obserwatora od dowodu dokładnie po pierwszej promocji."
        },
        "bucket": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{2,99}$",
          "description": "Nazwa kubełka logów (`bucket_id` ze stacku `violations-sink/`)."
        },
        "location": {
          "type": "string",
          "minLength": 2,
          "description": "Lokalizacja kubełka. Musi zgadzać się ze stackiem sinka — zła lokalizacja daje 404 na odczycie, czyli brak punktu, czyli martwego-człowieka zamiast liczby."
        },
        "view": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{2,99}$",
          "description": "Widok naruszeń (`LOG_ID(\"cloudaudit.googleapis.com/policy\")`) — ten sam, który czyta raport naruszeń."
        },
        "config_view": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{2,99}$",
          "description": "Widok zmian konfiguracji granicy (`LOG_ID(\"cloudaudit.googleapis.com/activity\")`). ROZŁĄCZNY z widokiem naruszeń — dzięki temu rozszerzenie filtra sinka o ACM nie wpuszcza historii zmian polityki dostępu do danych raportu naruszeń."
        },
        "window_seconds": {
          "type": "integer",
          "minimum": 600,
          "maximum": 86400,
          "default": 5400,
          "description": "Okno liczenia. MUSI przekraczać kadencję `watch.yml`, inaczej między przebiegami powstaje szczelina, w której odmowa nie zostanie policzona przez żaden przebieg. Nakładanie się okien jest pożądane: próg alertu to `> 0`, więc podwójne policzenie nie zmienia decyzji, a przeoczenie zmienia."
        }
      }
    }
  },
  "$defs": {
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "email"
      ],
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "pattern": "^[^@ ]+@[^@ ]+\\.[^@ ]+$",
          "description": "Adres odbiorcy. Kanał e-mail założony przez API startuje jako UNVERIFIED i do czasu kliknięcia linku Google NIE dostarcza powiadomień — polityka wygląda wtedy na uzbrojoną, a skrzynka milczy."
        }
      }
    }
  }
}
