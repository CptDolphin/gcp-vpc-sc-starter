# .github/workflows/break-glass.yml
# Emergency: pull one member out of the ENFORCED configuration when the perimeter is blocking legitimate
# production traffic.
#
# WHY a dedicated path instead of "just open a PR": during an incident the normal path (PR → review → merge
# → apply) is too slow, and the predictable result of a too-slow emergency path is that somebody edits the
# perimeter by hand in the console — which is worse, because it leaves no trace in git and shows up later as
# drift. So we give the emergency an official, audited route.
#
# What it deliberately does NOT do: it does not remove the member from the dry-run configuration. The
# incident does not delete our knowledge of that project's traffic — after the fix, promotion needs the
# same evidence as the first time.
#
# THE AUDIT TRAIL, in the three questions somebody will ask afterwards:
#   * WHO — the run metadata knows, but git does not: the commit below is authored by a bot. So the actor
#     and the run URL are written INTO the commit message and into the postmortem issue. The repository is
#     what gets cloned, mirrored and read a year later; a trace that exists only in the Actions UI is a
#     trace with a retention policy attached.
#   * WHEN — commit timestamp and issue creation time, both in the repository, both from the same run.
#   * FOR HOW LONG — there is no timer, and pretending otherwise would be the dangerous part. The member
#     stays OUT of the enforced configuration until somebody re-promotes it through the normal path, and
#     nothing here will remind you. That sentence is in the postmortem issue on purpose: an emergency
#     measure with no visible end date quietly becomes the new normal.
#
# On the human gate: this environment is separate from `perimeter-apply` so that the emergency does not wait
# for the same people the routine path waits for. Whether it waits for ANYBODY is a repository setting, not
# a property of this file — see the header of `apply.yml`. An emergency procedure blocked on a reviewer who
# is not there at 03:00 is worse than no procedure, because it looks like one.

name: break-glass

on:
  workflow_dispatch:
    inputs:
      member:
        description: "member file name without .yaml (e.g. example-division-prj-example-vertex-prod)"
        required: true
      incident:
        description: "incident ticket (INC…) — goes into the commit and the postmortem issue"
        required: true
      reason:
        description: "what is broken, in one sentence"
        required: true

permissions:
  contents: write
  id-token: write
  issues: write
  pull-requests: write

concurrency:
  group: vpc-sc-apply # shares the single-flight group with apply: never two writers at once
  cancel-in-progress: false

jobs:
  break_glass:
    name: demote a member to dry-run
    runs-on: ubuntu-latest
    environment: break-glass # deliberately NOT `perimeter-apply` — see header for what the separation buys
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0

      # The member is addressed by its KEY (`<division>-<project_id>`) — the same string that used to be the
      # file name and is still the Terraform state address. Nothing about the emergency path changed except
      # where the entry lives (DEC-12).
      #
      # `projects_file` rather than `yaml.safe_load`: this step runs under an incident, with a token that
      # can push to the default branch, and it REWRITES the file that lists every member of the boundary.
      # A duplicate key silently resolved to "last one wins" here would demote a member nobody asked about
      # and nobody would see it in the diff. The strict loader turns that into a stopped workflow.
      - name: demote the member to dry-run
        run: |
          pip install --quiet pyyaml
          python3 - "${{ github.event.inputs.member }}" <<'PY'
          import sys
          sys.path.insert(0, "tools")
          import projects_file

          nazwa = sys.argv[1]
          doc = projects_file.wczytaj(".")
          pasujace = [m for m in doc["members"] if projects_file.klucz(m) == nazwa]
          if not pasujace:
              sys.exit(f"nie ma wpisu {nazwa!r} w {projects_file.SCIEZKA} — sprawdz klucz <dywizja>-<project_id>")
          # Nie moze sie zdarzyc (bramka duplikatu), wiec tym bardziej nie wolno tego zgadywac po cichu:
          # demotowanie „pierwszego z dwoch" zostawiloby drugi wpis nadal w konfiguracji egzekwowanej.
          if len(pasujace) > 1:
              sys.exit(f"{projects_file.SCIEZKA}: {len(pasujace)} wpisow o kluczu {nazwa!r} — napraw plik przed break-glassem")
          m = pasujace[0]
          if m["stage"] != "enforced":
              sys.exit(f"{nazwa} jest juz {m['stage']} — nie ma czego cofac")
          m["stage"] = "dry-run"
          projects_file.zapisz(".", doc)
          print(f"demoted {nazwa}")
          PY

      # The commit is the DURABLE half of the audit trail, so it carries the actor and the run URL. The
      # author is a bot and cannot be anything else (the workflow, not a person, holds the token), which is
      # exactly why "who" has to be in the message body rather than left to `git log --format=%an`.
      - name: commit
        run: |
          git config user.name "vpc-sc-break-glass"
          git config user.email "noreply@example.com"
          git add perimeter/projects.yaml
          git commit -m "break-glass: demote ${{ github.event.inputs.member }} to dry-run (${{ github.event.inputs.incident }})

          ${{ github.event.inputs.reason }}

          Applied outside the normal review path under the break-glass procedure.
          Pulled by: @${{ github.actor }}
          Run: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
          The member is NOT protected from now on, with no automatic expiry, until it is re-promoted.
          Postmortem issue is opened automatically by this workflow."
          git push

      - uses: google-github-actions/auth@c200f3691d83b41bf9bbd8638997a462592937ed # v2.1.13
        with:
          workload_identity_provider: ${{ vars.WIF_PROVIDER }}
          service_account: ${{ vars.APPLY_SERVICE_ACCOUNT }}

      - uses: hashicorp/setup-terraform@b9cd54a3c349d3f38e8881555d616ced269862dd # v3.1.2
        with:
          terraform_version: "1.15.5"

      - name: apply
        run: |
          terraform -chdir=terraform init -input=false
          terraform -chdir=terraform apply -input=false -auto-approve -lock-timeout=10m

      # An emergency without a postmortem repeats. The issue is created automatically so that the follow-up
      # is not "somebody should write this up" but an item with a number.
      - name: open the postmortem issue
        uses: actions/github-script@f28e40c7f34bde8b3046d885e986cb6290c5673b # v7.1.0
        with:
          script: |
            await github.rest.issues.create({
              owner: context.repo.owner,
              repo: context.repo.repo,
              title: `postmortem: break-glass on ${{ github.event.inputs.member }} (${{ github.event.inputs.incident }})`,
              labels: ['postmortem', 'break-glass'],
              body: [
                '**What happened:** ${{ github.event.inputs.reason }}',
                '',
                '**Pulled by:** @${{ github.actor }} · **run:** ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}',
                '',
                'The member was demoted to the dry-run configuration and is currently **not protected**.',
                'It stays in dry-run, so its traffic is still being recorded.',
                '',
                '**There is no timer on this.** Nothing re-promotes the member automatically and nothing will',
                'remind you; it is unprotected until the checklist below is done and a promotion PR is merged.',
                '',
                '### Before re-promoting',
                '- [ ] which flow was blocked, and why was it missing from the rules?',
                '- [ ] does an existing profile cover it, or do we need a new one?',
                '- [ ] why did the observation window not catch it (too short? rare job? seasonal?)',
                '- [ ] fresh clean window + violations report attached to the promotion PR',
              ].join('\n'),
            });
