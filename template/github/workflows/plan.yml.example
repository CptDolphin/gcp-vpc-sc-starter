# .github/workflows/plan.yml
# Read-only plan against the real organization + policy gates on the plan JSON.
#
# WHY gates run on the plan and not only on the YAML: the YAML says what somebody wrote; the plan says what
# will actually be sent to the API after the renderer resolved profiles and parameters. The plan is the thing
# that changes the security boundary, so that is what we inspect.

name: plan

on:
  pull_request:
    paths:
      - "perimeter/**"
      - "terraform/**"
      - "policy/**"
      # `tools/**` — bo w tym jobie żyją DWIE bramki napisane w Pythonie (`check_supported_services.py`
      # i `control_plane_check.py --live`), a bez tej ścieżki pull request zmieniający wyłącznie je nie
      # uruchamiał ich ani razu. Ta sama pomyłka, którą validate.yml ma już opisaną przy `iam-bootstrap/**`:
      # bramka, która nie widzi zmiany w pliku, który sama wykonuje, jest bramką tylko z nazwy. Kosztem jest
      # jeden plan (read-only) na zmianę narzędzi — tanio jak na jedyne miejsce, gdzie widać ich wykonanie.
      - "tools/**"
      - ".github/workflows/plan.yml"
      # `.github/actions/**` — z tego samego powodu co `tools/**` wyżej: bramki żywe stoją teraz w akcji
      # złożonej, więc pull request zmieniający SAMĄ bramkę nie uruchamiałby jej ani razu.
      - ".github/actions/**"

permissions:
  contents: read
  id-token: write # required to mint the OIDC token exchanged via Workload Identity Federation
  pull-requests: write

concurrency:
  group: plan-${{ github.ref }}
  cancel-in-progress: true

jobs:
  # PREREKWIZYTY KANDYDATA PRZED PLANEM, A NIE PO NIM — i dlatego osobny job, nie krok.
  #
  # Werdykt tej bramki ma ZATRZYMAĆ plan, a nie go zaczerwienić: `needs:` niżej sprawia, że przy czerwonym
  # pre-flighcie job `plan` pokazuje się jako `skipped`, czyli zamek stanu nie zostaje wzięty i refresh
  # przeciw organizacji się nie wykonuje. Wniosek o projekt bez Private Google Access kosztuje wtedy jedno
  # przeczytanie sieci kandydata, a nie pełny plan.
  #
  # TEN SAM JOB STOI W `apply.yml` (DEC-16 — bramka należy do mutatora, nie do zdarzenia `pull_request`),
  # z tą samą akcją i tą samą tożsamością. Selftest mierzy zawieranie zbiorów akcji obu torów, więc
  # dopisanie bramki wyłącznie tutaj czerwieni go natychmiast.
  pre-flight:
    name: pre-flight (prerekwizyty wchodzacych)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0

      - uses: google-github-actions/auth@c200f3691d83b41bf9bbd8638997a462592937ed # v2.1.13
        with:
          workload_identity_provider: ${{ vars.WIF_PROVIDER }}
          service_account: ${{ vars.PLAN_SERVICE_ACCOUNT }}

      - uses: ./.github/actions/bramka-preflightu

  plan:
    name: terraform plan
    runs-on: ubuntu-latest
    # Twarda zależność, nie kolejność kroków: czerwony pre-flight = ten job w ogóle nie startuje.
    needs: pre-flight
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0

      # Keyless. Konto read-only jest jedyną tożsamością, jaką ten workflow potrafi objąć — decyduje o tym
      # `service_account` niżej, a NIE warunek providera WIF.
      #
      # NIE CZYTAJ TU OGRANICZENIA NA `event_name`, bo go nie ma, i to jest fakt o kształcie wdrożenia,
      # nie szczegół. `attribute_condition` providera pyta WYŁĄCZNIE o repozytorium, a `principalSet`
      # konta `plan` celuje w `attribute.repository` — czyli w KAŻDY workflow tego repozytorium, także
      # uruchomiony pushem na gałąź domyślną. Na tym stoi bramka pre-flightu na ścieżce apply: pyta tym
      # samym kontem `plan`, bez rozszerzania uprawnień konta `apply` (DEC-24). Odwrotnie jest przy koncie
      # `watch`, które celuje w `attribute.ref` — patrz `iam-bootstrap/main.tf` i docs/2-uprawnienia-i-wif.md.
      - uses: google-github-actions/auth@c200f3691d83b41bf9bbd8638997a462592937ed # v2.1.13
        with:
          workload_identity_provider: ${{ vars.WIF_PROVIDER }}
          service_account: ${{ vars.PLAN_SERVICE_ACCOUNT }}

      - uses: hashicorp/setup-terraform@b9cd54a3c349d3f38e8881555d616ced269862dd # v3.1.2
        with:
          terraform_version: "1.15.5"

      # `-chdir` przenosi katalog roboczy WYŁĄCZNIE terraformowi — przekierowanie `>` wykonuje powłoka
      # w katalogu joba, czyli w korzeniu repo. `> plan.json` kładło więc plik obok `terraform/`, a kroki
      # niżej (conftest, sha256sum, upload-artifact) czytają `terraform/…`. Efekt: job padał na
      # `stat terraform/plan.json: no such file or directory` PO udanym planie, czyli bramki OPA na planie
      # nie wykonywały się ani razu. Ścieżka jest wypisana wprost, żeby producent i konsument pliku
      # zgadzali się bez wiedzy o tym, czym `-chdir` jest, a czym nie.
      - name: plan
        run: |
          terraform -chdir=terraform init -input=false
          terraform -chdir=terraform plan -input=false -lock-timeout=5m -out=tfplan.binary
          terraform -chdir=terraform show -json tfplan.binary > terraform/plan.json

      - name: install conftest
        run: |
          curl -sSfL -o /tmp/conftest.tar.gz \
            https://github.com/open-policy-agent/conftest/releases/download/v0.56.0/conftest_0.56.0_Linux_x86_64.tar.gz
          tar -xzf /tmp/conftest.tar.gz -C /tmp conftest
          sudo mv /tmp/conftest /usr/local/bin/

      # --data feeds policy.yaml into the rules: the wildcard gate needs to know which services the API
      # publishes no methods for. Without it the set is empty and every "*" is denied — fail-closed on purpose.
      - name: policy gates on the plan
        run: conftest test --policy policy --data perimeter/policy.yaml --namespace vpcsc.perimeter terraform/plan.json

      # Bramki żywe — jedyne w pipelinie, które rozmawiają z API. Definicja stoi w jednym miejscu, bo woła
      # je także job bramek w `apply.yml`: pull request i mutator mają dostawać DOKŁADNIE ten sam zestaw,
      # a dwie kopie tych samych dwóch kroków rozjeżdżają się przy pierwszej zmianie (DEC-16).
      # Tożsamość wybiera WYWOŁUJĄCY — tutaj konto `plan`, uwierzytelnione krokiem wyżej.
      - uses: ./.github/actions/bramki-zywe

      # The plan artifact is what apply consumes. Pinning its digest means the thing that was reviewed is
      # byte-for-byte the thing that gets applied — no re-plan against a moved target between the two jobs.
      - name: pin the plan
        id: pin
        run: |
          sha=$(sha256sum terraform/tfplan.binary | cut -d' ' -f1)
          echo "sha=$sha" >> "$GITHUB_OUTPUT"
          echo "plan sha256: \`$sha\`" >> "$GITHUB_STEP_SUMMARY"

      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: tfplan-${{ github.event.pull_request.number }}-${{ steps.pin.outputs.sha }}
          path: terraform/tfplan.binary
          retention-days: 5

      - name: comment the human-readable diff
        run: |
          {
            echo "### Plan"
            echo '```'
            terraform -chdir=terraform show -no-color tfplan.binary | head -200
            echo '```'
          } >> "$GITHUB_STEP_SUMMARY"
