# .github/workflows/validate.yml
# Cheap, credential-free gates that run on every PR. Nothing here touches Google Cloud, so a syntax-level
# PR can never go red because of expired credentials or a broken remote state.

name: validate

on:
  pull_request:
    paths:
      - "perimeter/**"
      - "policy/**"
      - "schemas/**"
      - "terraform/**"
      # `iam-bootstrap/**` — bramka na ten stack ISTNIEJE niżej (krok „tflint - iam-bootstrap stack"),
      # ale bez tej ścieżki odpalała się WYŁĄCZNIE wtedy, gdy w tym samym pull requeście zmieniało się
      # coś innego. PR dotykający samego `iam-bootstrap/` nie dostawał ŻADNEGO checku — a to jest stack
      # nadający wszystkie uprawnienia tego systemu, więc akurat on nie może być jedynym katalogiem bez
      # bramki. Zmierzone na wdrożeniu: „no checks reported on the branch".
      - "iam-bootstrap/**"
      # `contrib/**`, `tools/**` i CAŁE `.github/workflows/**` — z tego samego powodu, co
      # `iam-bootstrap/**` wyżej, i wykryte tak samo: „no checks reported on the branch" na pull requeście,
      # który przestawiał KANAŁ WEJŚCIOWY (`contrib/action.yml` + `external-intake.yml`) i skrypt zakładający
      # bramki GitHuba (`tools/bootstrap_github.sh`). Guard „actions pinned to a SHA" w tym właśnie workflow
      # czytał wtedy `.github/workflows/*.yml` ORAZ `contrib/action.yml` — czyli bramka na te pliki istniała, ale
      # odpalała się wyłącznie wtedy, gdy w tym samym PR-ze zmieniało się coś zupełnie innego. Bramka, która
      # nie widzi zmiany w pliku, który sama sprawdza, jest bramką tylko z nazwy.
      - "contrib/**"
      - "tools/**"
      - ".github/workflows/**"
      # `violations-sink/**` — TRZECI stack Terraforma (sinki org-level, kubełki, widoki, IAM strumienia
      # naruszeń). Ta sama pomyłka co przy `iam-bootstrap/**` wyżej, popełniona po raz czwarty: stack
      # powstał, a lista ścieżek i kroki niżej zostały przy dwóch. Zmierzone 2026-08-13: błąd składni HCL
      # w `violations-sink/main.tf` (polski cudzysłów zamykający zapisany jako ASCII `"`) przeszedł CAŁY
      # pipeline bez ani jednego czerwonego joba. Ten stack applikuje CZŁOWIEK z org-level
      # `roles/logging.configWriter` — konto pipeline'u świadomie go NIE MA — więc jedynym miejscem, gdzie
      # taki błąd wychodzi, jest ręczna sesja osoby o najwyższych uprawnieniach w organizacji.
      # Odkąd lista stacków wyprowadza się z drzewa (DEC-34), stack bez tej ścieżki czerwieni selftest.
      - "violations-sink/**"
      # `.github/actions/**` — tu leżą TERAZ same bramki treści. Bez tej ścieżki pull request zmieniający
      # wyłącznie definicję bramki nie uruchamiałby jej ani razu, czyli jedyny plik, którego regresja
      # rozbraja cały tor, byłby jedynym bez checku. Ta sama pomyłka co przy `iam-bootstrap/**` wyżej.
      - ".github/actions/**"
      # `docs/**` i `.starter-sync` — ta sama pomylka co przy `iam-bootstrap/**` wyzej, popelniona po raz
      # PIATY, i wykryta tym samym komunikatem: „no checks reported on the branch" (pull request #103,
      # synchronizacja procedury offboardingu). Sciezki dopisywano dotad pojedynczo, po jednej na incydent.
      #
      # DLACZEGO AKURAT TE DWIE NIE SA KOSMETYKA:
      #   * `.starter-sync` jest JEDYNYM wejsciem bramki `starter-drift`. Bez tej sciezki wskaznik da sie
      #     podniesc BEZ ANI JEDNEGO zielonego checku, a bramka odczyta to jako „zsynchronizowane" — czyli
      #     dokladnie sytuacja, przed ktora ostrzega `vpc-sc-starter-sync.md` §5;
      #   * `docs/` trzyma rejestr decyzji (`0-decyzje.md`, bramka `decisions_check.py` w obu trybach)
      #     ORAZ kotwice `<a id=…>`, na ktore celuja `runbook_url` polityk alertow. Martwa kotwica znaczy,
      #     ze alert CRITICAL o 3:00 daje spis tresci zamiast procedury.
      - "docs/**"
      - ".starter-sync"
      # SZÓSTE wystąpienie — i ostatnie dopisywane z ręki. Cztery pliki w trzech klasach leżały poza
      # WSZYSTKIMI filtrami `paths:` w repozytorium: pull request dotykający wyłącznie któregoś z nich
      # dostawał „no checks reported on the branch", tak samo jak pięć razy wcześniej. Znalazł je nie
      # człowiek, tylko `tools/paths_pokrycie_check.py`, i to jest cała różnica wobec tamtych pięciu razy:
      #   * `.tflint.hcl` — JEDYNE wejście trzech kroków `tflint` niżej, na wszystkie stacki. Zdjęcie
      #     `plugin "google"` albo podniesienie progu rozbraja analizę na stałe i niewidocznie: `tflint`
      #     zostaje zielony, bo nie ma już czego znaleźć (nagłówek tego pliku opisuje ten tryb awarii);
      #   * `.github/CODEOWNERS` — wsad `tools/codeowners_check.py`, jedynego mechanizmu rozdzielającego
      #     zgodę od wniosku, odkąd `require_code_owner_reviews` jest w tym planie niedostępne (DEC-23);
      #   * `tests/**` — wsad kontraktu symulatora ServiceNow (`tools/snow_symulator_kontrakt.py`),
      #     dwa pliki: `snow-approved.json` i `symulator-instancja.json`.
      # Ścieżka pliku-korzenia musi być wypisana wprost: żaden z istniejących wzorców katalogowych
      # nie łapie pliku leżącego w korzeniu repozytorium.
      #
      # `.gitattributes` i `AGENTS.md` NIE weszły tu, choć pierwszy pomiar je wskazywał: obie nazwy
      # padają wyłącznie w PROZIE nagłówków (`projects_file.py`, `decisions_check.py`), a nie w kodzie,
      # który je otwiera. Skaner odsiewa docstringi właśnie po to — bramka żądająca ścieżki dla pliku,
      # którego nikt nie czyta, uczy zespołu dopisywania wyjątków i psuje samą siebie.
      #
      # `.github/*` zamiast samego `.github/CODEOWNERS`: pliki konfiguracyjne leżące BEZPOŚREDNIO
      # w `.github/` to jedna klasa (CODEOWNERS, deklaracja pominięć bramki `paths`, dependabot),
      # a wzorzec `*` nie przechodzi przez ukośnik, więc nie dubluje `.github/workflows/**` ani
      # `.github/actions/**` niżej. Wypisywanie ich pojedynczo byłoby tą samą listą z pamięci,
      # od której to zgłoszenie odchodzi.
      - ".tflint.hcl"
      - ".github/*"
      - "tests/**"
  workflow_dispatch:

permissions:
  contents: read
  # `actions: read` — wyłącznie po to, żeby pobrać artefakt `violations` z ostatniego udanego przebiegu
  # `violations-report.yml`. To jest DOWÓD dla bramki promocji; skąd on się bierze, tłumaczy krok „dowód
  # naruszeń" niżej. Bez tego uprawnienia `gh run download` dostaje 403, dowodu nie ma i promocja stoi —
  # czyli degradacja idzie w stronę bezpieczną, ale kosztuje czas na diagnozę, więc uprawnienie zostaje.
  actions: read

concurrency:
  group: validate-${{ github.ref }}
  cancel-in-progress: true

jobs:
  declarations:
    name: schema, policy and budget
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      # WSZYSTKIE bramki treści są W JEDNYM MIEJSCU, wołanym też przez `apply.yml`. Rozpisane tutaj jako
      # kroki byłyby kopią, a kopia rozjeżdża się przy pierwszej zmianie — i wtedy wraca defekt, który ten
      # układ zamyka: bramka stojąca obok ścieżki, którą realnie zmienia się granicę (patrz nagłówek
      # `.github/actions/bramki-tresci/action.yml` i DEC-16).
      - uses: ./.github/actions/bramki-tresci
        with:
          token_gh: ${{ github.token }}

  terraform:
    name: terraform fmt and validate
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: hashicorp/setup-terraform@dfe3c3f87815947d99a8997f908cb6525fc44e9e # v4.0.1
        with:
          terraform_version: "1.15.5"
          # WRAPPER WYLACZONY, BO MASKUJE KODY WYJSCIA — a na nich stoja wszystkie bramki nizej.
          # Zmierzone (#2058, przebieg `31699704955`): plik `violations-sink/main.tf` z bledem skladni HCL
          # (polski cudzyslow zamykajacy zapisany jako ASCII) dal krok `fmt` = **success**, a dopiero
          # `init` = failure. `terraform fmt -check` zwraca w takiej sytuacji **2**, wrapper zamienia to
          # na **0** (kod 3, czyli „pliki niesformatowane", propaguje poprawnie). Bramka formatowania
          # przepuszczala wiec plik, ktorego terraform nie potrafi sparsowac.
          #
          # Ten sam wniosek stal juz w `selftest.yml` SAMEGO startera („wrapper psuje kody wyjscia, na
          # ktorych stoi selftest") — i nie zostal zastosowany do materialu, ktory starter WYSYLA.
          # Repozytorium chronilo siebie, a nie wdrozenie.
          #
          # Nic nie czyta `steps.<id>.outputs.stdout/exitcode`, wiec wylaczenie wrappera niczego nie psuje
          # (sprawdzone grepem w obu repozytoriach).
          terraform_wrapper: false
      - run: terraform -chdir=terraform fmt -check -recursive
      # -backend=false on purpose: this job has no cloud credentials and must not need any.
      - run: terraform -chdir=terraform init -backend=false
      - run: terraform -chdir=terraform validate
      # Natywne testy renderera — sprawdzają, czy YAML tłumaczy się na właściwe reguły. Bez credentiali:
      # `command = plan` na locals, żadnego apply.
      #
      # ATRAPA TOKENU, NIE POŚWIADCZENIE. Provider `google` odmawia INICJALIZACJI, gdy nie widzi żadnej
      # tożsamości — niezależnie od tego, że testy renderera nie wołają API. Bez tej zmiennej job padał
      # na `could not find default credentials`, czyli jedyna bramka na logikę renderera mówiła o czymś
      # innym niż to, co bada. Wartość jest jawnie bezużyteczna: pozwala providerowi wystartować i nic
      # nie autoryzuje. Ten job nadal NIE MA i nie może mieć dostępu do chmury (brak `id-token: write`).
      - run: terraform -chdir=terraform test
        env:
          GOOGLE_OAUTH_ACCESS_TOKEN: nie-uzywany-testy-sa-plan-only

      # KAŻDY stack Terraforma dostaje TEN SAM zestaw bramek bezkredencjałowych, a nie zestaw dobrany
      # do tego, jak ważny się wydawał w dniu powstania. Powód jest zmierzony, nie estetyczny: przez
      # dwie zmiany z rzędu `fmt`/`init`/`validate` biegły WYŁĄCZNIE na `terraform/`, więc `iam-bootstrap`
      # miał tylko lintera, a `violations-sink` nie miał nic — i błąd składni HCL przeszedł tam cały
      # pipeline na zielono (2026-08-13, komentarz przy `violations-sink/**` wyżej). Asymetria „ten stack
      # ma bramkę, tamten nie" jest niewidoczna w przeglądzie: pull request wygląda tak samo zielono
      # w obu przypadkach. Kompletność tej listy pilnuje selftest, wyprowadzając stacki z DRZEWA repo
      # (DEC-34) — nowy katalog z `*.tf` bez kroków niżej czerwieni bramkę, zamiast czekać na incydent.
      - name: iam-bootstrap — fmt
        run: terraform -chdir=iam-bootstrap fmt -check -recursive
      - name: iam-bootstrap — init (bez backendu)
        run: terraform -chdir=iam-bootstrap init -backend=false
      - name: iam-bootstrap — validate
        run: terraform -chdir=iam-bootstrap validate

      - name: violations-sink — fmt
        run: terraform -chdir=violations-sink fmt -check -recursive
      - name: violations-sink — init (bez backendu)
        run: terraform -chdir=violations-sink init -backend=false
      - name: violations-sink — validate
        run: terraform -chdir=violations-sink validate

  tflint:
    name: tflint (static analysis)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      - uses: terraform-linters/setup-tflint@6e1e0642c0289bd619021bf6b34e3c08ed1e005a # v6.3.0
        with:
          tflint_version: v0.63.1

      # Plugin google jest ściągany z GitHuba — bez tego kroku reguły dla zasobów Google nie działają, a
      # przebieg i tak jest zielony.
      - run: tflint --init
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

      # `--config` z BEZWZGLĘDNĄ ścieżką: `--chdir` przenosi też miejsce, w którym tflint szuka konfiguracji,
      # więc bez tego .tflint.hcl z roota repo jest cicho ignorowany (patrz nagłówek .tflint.hcl).
      # `--minimum-failure-severity=notice`: reguły o dokumentacji mają severity Notice, a bramka, która
      # przepuszcza własne findingi, jest ozdobą.
      - name: tflint - perimeter stack
        run: tflint --chdir=terraform --config="$PWD/.tflint.hcl" --minimum-failure-severity=notice

      - name: tflint - iam-bootstrap stack
        run: tflint --chdir=iam-bootstrap --config="$PWD/.tflint.hcl" --minimum-failure-severity=notice

      # Ten sam linter na stacku agregacji logów. Zmierzone na treści z dnia dołożenia bramki: zero
      # findingów, więc próg `notice` zostaje taki sam jak wyżej — nie ma czego zwalniać z bramki.
      - name: tflint - violations-sink stack
        run: tflint --chdir=violations-sink --config="$PWD/.tflint.hcl" --minimum-failure-severity=notice
