# .github/workflows/violations-report.yml
# Turns raw dry-run violations into something an owner can act on, and into the EVIDENCE the promotion gate
# requires. Without this workflow the clean window is a claim; with it, it is a file.
# The window length comes from `perimeter/policy.yaml` (`onboarding.clean_window_days`), not from
# a literal here: a number hardcoded next to the declaration it contradicts is how #2083 happened.

name: violations-report

on:
  schedule:
    - cron: "0 6 * * 1" # Monday morning: the report lands before the week's promotion PRs
  workflow_dispatch:
    inputs:
      days:
        description: "observation window in days"
        # Puste = wez okno z deklaracji (`onboarding.clean_window_days`). Wpisz liczbe TYLKO
        # na przelot diagnostyczny — raport z innym oknem nie jest dowodem dla bramki promocji.
        default: ""

permissions:
  contents: read
  id-token: write
  issues: write

jobs:
  report:
    name: dry-run violations per member
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      - uses: google-github-actions/auth@7c6bc770dae815cd3e89ee6cdf493a5fab2cc093 # v3.0.0
        with:
          workload_identity_provider: ${{ vars.WIF_PROVIDER }}
          service_account: ${{ vars.PLAN_SERVICE_ACCOUNT }}

      - uses: google-github-actions/setup-gcloud@aa5489c8933f4cc7a4f7d45035b3b1440c9c10db # v3.0.1

      # The declarations are built BEFORE the logs are read, because they decide WHERE to read from.
      - name: collect declarations
        run: |
          pip install --quiet pyyaml
          python3 tools/collect_declarations.py > declarations.json

      # ONE query, not N — and this is the whole point of the step.
      #
      # A VPC-SC audit entry is written to the log of the project that OWNS the protected resource, i.e. the
      # member, so the scope that looks the most complete is the one that sees the least. Measured on the live
      # perimeter: `--organization=` returned 0 entries while a single member project held 41, same filter,
      # same window. That zero is indistinguishable from a clean window, and a clean window is exactly what
      # promotion_gate accepts as PROOF — so the wrong scope alone was enough to promote a member with 41
      # violations.
      #
      # Reading every member separately fixed the blindness and bought a different failure: at the target
      # scale (several hundred projects) that is several hundred `logging read` calls per run — slow, and
      # brittle in the way that matters, because ONE project the account cannot read takes down the whole
      # report, i.e. the evidence.
      #
      # An organization-level sink with `include_children` routes every VPC-SC violation in the organization
      # into one log bucket in the administrative project, and this step reads that bucket with a single
      # query. Measured equivalence on one window (2026-08-11, 11m47s, 3 services, 2 member projects):
      # sink = 16 entries in 1 query, union of per-project reads = 16 entries in 3 queries, identical
      # `insertId` sets — nothing missing, nothing extra. Terraform for the sink: `violations-sink/`.
      #
      # THE FILTER HAS NO `dryRun` PREDICATE, deliberately. The field exists ONLY on dry-run violations (with
      # value `true`); an ENFORCED denial carries no `dryRun` field at all, so `dryRun="false"` matches
      # nothing, ever, in any organization. Measured on the same 25 live entries: the type filter alone
      # returned 16 dry-run + 9 enforced, while adding `dryRun="false"` returned 0. Both kinds belong in the
      # report — dry-run is what promotion_gate weighs, enforced means someone is being blocked right now.
      #
      # The sink also carries violations from projects that are NOT members: pre-flight candidates and freshly
      # offboarded projects. That is required, not sloppy. Filtering by member list belongs in the REPORT
      # (`violations_report.py` has the list and puts strangers in their own section), never in the sink —
      # otherwise the evidence disappears at the exact moment the configuration changes.
      #
      # The explicit `|| exit 1` stays, for the reason it was measured: on a denied read `gcloud logging read`
      # prints `[]` on STDOUT and the error only on stderr, so a bare redirect turns "I was not allowed to
      # read" into "there were no violations" — a clean window manufactured from a permission failure.
      - name: read audit logs
        env:
          ORG_ID: ${{ vars.ORG_ID }}
          SINK_PROJECT: ${{ vars.VIOLATIONS_SINK_PROJECT }}
          SINK_BUCKET: ${{ vars.VIOLATIONS_SINK_BUCKET }}
          SINK_LOCATION: ${{ vars.VIOLATIONS_SINK_LOCATION }}
          DAYS_WEJSCIE: ${{ github.event.inputs.days }}
        run: |
          set -o pipefail
          FILTER='protoPayload.metadata."@type"="type.googleapis.com/google.cloud.audit.VpcServiceControlAuditMetadata"'

          # OKNO POCHODZI Z DEKLARACJI, nie z literalu w tym pliku (#2083). Do tej poprawki stalo tu zaszyte
          # `14`, podczas gdy `policy.yaml` deklarowal `clean_window_days: 7` i twierdzil, ze to wlasnie ta
          # liczba mowi, „ile ostatnich dni musi byc bez naruszen". Raport obejmowal wiec inne okno niz to,
          # ktore opisywala deklaracja, a bramka promocji czytala jego wynik jako dowod dla okna z deklaracji.
          # Fail-closed: brak klucza albo brak `policy.yaml` konczy przebieg, bo raport z NIEZNANYM oknem nie
          # jest dowodem — jest liczba bez jednostki.
          DAYS=$(python3 -c "import yaml,sys; print(yaml.safe_load(open('perimeter/policy.yaml'))['onboarding']['clean_window_days'])") || {
            echo "::error::nie odczytano onboarding.clean_window_days z perimeter/policy.yaml — raport bez znanego okna nie jest dowodem"
            exit 1
          }
          if [ -n "${DAYS_WEJSCIE:-}" ]; then
            echo "::warning title=OKNO Z WEJSCIA, NIE Z DEKLARACJI::raport obejmuje ${DAYS_WEJSCIE} d zamiast zadeklarowanych ${DAYS} d — przelot diagnostyczny, NIE dowod dla bramki promocji"
            DAYS="$DAYS_WEJSCIE"
          fi
          echo "okno raportu: ${DAYS} d"

          # GUARD PRZED ODCZYTEM, i to nie jest ozdoba. Sink, który nie dostarcza, wygląda DOKŁADNIE tak samo
          # jak czyste okno: pusty kubełek, zielony przebieg, `violations.json` z zerami i przepuszczona
          # promocja. Zmierzone 2026-08-11 przy zakładaniu sinka — zanim grant `logging.bucketWriter` dla jego
          # tożsamości się rozpropagował, 9 z 18 wpisów przepadło BEZPOWROTNIE, a `sinks describe` przez cały
          # ten czas raportował sink jako zdrowy. Sprawdzamy więc, że sink ISTNIEJE, ma `includeChildren` i ma
          # ten sam filtr co odczyt — bo zerowy wynik wolno raportować dopiero wtedy, gdy wiadomo, skąd jest.
          SINK_CFG=$(gcloud logging sinks describe "$SINK_BUCKET" --organization="$ORG_ID" \
            --format='value(filter,includeChildren)') || {
            echo "::error::nie umiem odczytać konfiguracji sinka $SINK_BUCKET — pusty wynik byłby nieodróżnialny od czystego okna"
            exit 1
          }
          echo "sink: $SINK_CFG"
          case "$SINK_CFG" in
            *VpcServiceControlAuditMetadata*True) : ;;
            *) echo "::error::sink $SINK_BUCKET ma inny filtr albo includeChildren=False — dowód byłby niepełny"; exit 1 ;;
          esac

          gcloud logging read "$FILTER" \
            --project="$SINK_PROJECT" --bucket="$SINK_BUCKET" --location="$SINK_LOCATION" --view="$SINK_BUCKET" \
            --freshness="${DAYS}d" --format=json > raw.json || {
            echo "::error::gcloud logging read z sinka nie powiódł się — bez raportu nie ma dowodu, promocja zostaje zablokowana"
            exit 1
          }
          python3 -c 'import json;print("entries:", len(json.load(open("raw.json"))))'

      - name: build the report
        run: |
          python3 tools/violations_report.py \
            --logs raw.json --declarations declarations.json \
            --json-out violations.json --markdown-out violations.md \
            --platform-json-out violations-platform.json
          cat violations.md >> "$GITHUB_STEP_SUMMARY"

      # violations.json is the artifact a promotion PR must attach. The rego rule treats a MISSING entry as
      # "no evidence" rather than "no violations" — otherwise skipping the report would be the easy way to
      # pass the gate.
      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: violations
          path: |
            violations.json
            violations.md
            violations-platform.json
          retention-days: 30
