# .github/workflows/watch.yml
# Obserwator granicy: co godzinę odpowiada na cztery pytania i publikuje odpowiedzi jako metryki.
#
#   * czy zmergowana zmiana granicy jest ZASTOSOWANA?          -> apply_pending_seconds
#   * ile z limitu 6000 atrybutów zjada `spec`, a ile `status`? -> attribute_budget_percent
#   * ile dni zostało do ściany przy dzisiejszym tempie?        -> attribute_budget_days_to_limit
#   * czy chmura zgadza się z Gitem?                            -> drift_resources
#   * czy ktoś siedzi w granicy po `review_by`?                 -> members_expired
#
# DLACZEGO TO NIE JEST „NASŁUCH NA NIEUDANY WORKFLOW". Trzy tryby awarii `apply` dają ten sam objaw, ale
# tylko JEDEN z nich generuje zdarzenie: przebieg nieudany. Przebieg, który się nie odpalił (zły `paths`,
# wyłączone Actions, brak minut) i przebieg wiszący nie generują NICZEGO — a granica jest wtedy tak samo
# rozjechana z Gitem. Ten workflow mierzy STAN, nie zdarzenia, więc widzi wszystkie trzy jedną liczbą.
#
# DLACZEGO CO GODZINĘ, A NIE CO 5 MINUT. `terraform plan` na tej konfiguracji trwa ~40 s, a minuty Actions
# w repozytorium prywatnym są limitowane; 24 przebiegi na dobę to ~35 min dziennie. Kadencja jest ZWIĄZANA
# z `alignment_period = 3600s` w `terraform/alerts.tf` — okno wyrównania krótsze od kadencji publikacji
# daje puste kubełki między zapisami, a warunek z pustym kubełkiem nigdy nie utrzyma się przez wymagany
# czas. Zmieniasz cron -> zmień okno.
#
# TEN WORKFLOW JEST TEŻ NADAJNIKIEM, NIE TYLKO MIERNIKIEM. Ostatni krok joba `publish` wysyła heartbeat do
# dead-man's-switcha u zewnętrznego dostawcy — poza tą organizacją GCP. Powód: cztery polityki alertów stoją
# w projekcie monitoringu, więc skasowanie tego projektu albo wyłączenie mu billingu nie odpala ŻADNEJ z nich.
# Obserwator, który zamilkłby razem z obserwowanym, nie jest obserwatorem. Szczegóły przy samym kroku.
#
# DWA JOBY, DWIE TOŻSAMOŚCI — najważniejsza rzecz w tym pliku. `measure` liczy i jest READ-ONLY (konto
# `plan`, to samo, które może impersonować każdy pull request). `publish` pisze do Cloud Monitoring i ma
# WYŁĄCZNIE `timeSeries.create` (konto `watch`). Gdyby to był jeden job, konto dostępne z pull requesta
# zyskałoby prawo zapisu metryk — czyli autor dowolnego PR-a mógłby opublikować „budżet 5%, zaległości 0"
# i uciszyć wszystkie cztery alerty naraz. Podział kosztuje ~15 s startu joba.

name: watch

on:
  schedule:
    - cron: "17 * * * *" # 17. minuta, nie 0: o pełnej godzinie kolejka GitHuba jest najdłuższa
  # Po KAŻDYM apply — udanym i nieudanym. Bez tego pierwszy pomiar po wdrożeniu przychodzi dopiero
  # w następnej pełnej godzinie, a `condition_absent` w alercie o `apply` jest znaczący DOPIERO PO
  # pierwszym zapisie: metryka, do której nigdy nic nie napisano, nie jest „nieobecna", tylko nieznana.
  workflow_run:
    workflows: [apply]
    types: [completed]
  workflow_dispatch:

permissions:
  contents: read
  id-token: write
  actions: read # odczyt historii przebiegów `apply` — to z niej bierze się wiek zaległej zmiany

concurrency:
  group: vpc-sc-watch
  cancel-in-progress: true

jobs:
  measure:
    name: policz (read-only)
    runs-on: ubuntu-latest
    outputs:
      metryki: ${{ steps.licz.outputs.metryki }}
    steps:
      # `fetch-depth: 0` JEST WARUNKIEM POPRAWNOŚCI, nie optymalizacją na odwrót: wiek zaległej zmiany
      # liczymy z `git log <sha-ostatniego-udanego-apply>..HEAD`. W płytkim klonie tego SHA po prostu nie
      # ma, a skrypt wpada wtedy w gałąź awaryjną i liczy od HEAD — czyli zaniża wiek do zera po każdym
      # merge'u i alert nigdy nie odpala.
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0

      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: "3.12"

      - uses: google-github-actions/auth@7c6bc770dae815cd3e89ee6cdf493a5fab2cc093 # v3.0.0
        id: auth
        with:
          workload_identity_provider: ${{ vars.WIF_PROVIDER }}
          service_account: ${{ vars.PLAN_SERVICE_ACCOUNT }}
          # Token OAuth zamiast pliku poświadczeń: skrypt woła Monitoring API zwykłym `urllib`, bez
          # instalowania bibliotek Google. Mniej zależności w jobie, który ma działać, gdy inne nie działają.
          token_format: access_token

      - uses: hashicorp/setup-terraform@dfe3c3f87815947d99a8997f908cb6525fc44e9e # v4.0.1
        with:
          terraform_version: "1.15.5"

      # `-lock-timeout=2m`: ten plan bierze blokadę stanu tak samo jak każdy inny. Kolizja z trwającym
      # `apply` kończy się tu porażką joba — i to jest ZAMIERZONE, a nie zaniedbanie. Jeden brakujący
      # pomiar mieści się w oknie `watchdog_absent_seconds` (3 h = trzy przebiegi), a wymuszanie
      # `-lock=false` dałoby odczyt stanu w trakcie zapisu, czyli losowy wynik dryfu.
      - name: plan (detailed exit code)
        id: plan
        run: |
          terraform -chdir=terraform init -input=false
          set +e
          terraform -chdir=terraform plan -input=false -lock-timeout=2m -no-color -out=tfplan.binary
          code=$?
          set -e
          if [ "$code" != "0" ]; then
            echo "::error::terraform plan zakonczyl sie kodem $code"
            exit "$code"
          fi
          terraform -chdir=terraform show -json tfplan.binary > terraform/plan.json

      - name: policz metryki
        id: licz
        env:
          GH_TOKEN: ${{ github.token }}
          GOOGLE_ACCESS_TOKEN: ${{ steps.auth.outputs.access_token }}
        run: |
          pip install --quiet pyyaml
          python3 tools/collect_declarations.py > declarations.json
          # `|| true`, bo `attribute_budget.py` wychodzi kodem 1 PO PRZEKROCZENIU PROGU — a to jest
          # dokładnie ten stan, o którym ma powiadomić alert. Obserwator, który pada wtedy, gdy jest
          # co zgłosić, jest gorszy niż jego brak.
          python3 tools/attribute_budget.py --input declarations.json --format json > budget.json || true
          python3 tools/perimeter_watch.py measure \
            --repo "${{ github.repository }}" \
            --project "${{ vars.MONITORING_PROJECT }}" \
            --branch "${{ github.event.repository.default_branch || 'main' }}" \
            > metryki.json

          python3 - <<'PY' >> "$GITHUB_STEP_SUMMARY"
          import json
          d = json.load(open("metryki.json"))
          print("### Obserwator granicy\n")
          print(f"Zaleganie apply: **{d['powod_zalegania']}**\n")
          print("| metryka | wartosc |\n|---|---|")
          for k, v in d["podsumowanie"].items():
              print(f"| `{k}` | `{v}` |")
          PY

          # Jedna linia do outputu joba — punkty jadą do drugiego joba, który ma prawo je zapisać.
          python3 -c "import json;print('metryki='+json.dumps(json.load(open('metryki.json'))))" >> "$GITHUB_OUTPUT"

  publish:
    name: opublikuj (timeSeries.create)
    needs: measure
    runs-on: ubuntu-latest
    # `always()` NIE: gdy `measure` padnie, nie ma czego publikować, a publikacja zera byłaby KŁAMSTWEM
    # w bezpiecznym kierunku tylko pozornie — wyzerowałaby zaległość apply i uciszyła alert.
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: "3.12"

      - uses: google-github-actions/auth@7c6bc770dae815cd3e89ee6cdf493a5fab2cc093 # v3.0.0
        id: auth
        with:
          workload_identity_provider: ${{ vars.WIF_PROVIDER }}
          # JEDYNE miejsce w tym repozytorium, które używa konta `watch`. Ma dokładnie jedno uprawnienie:
          # `monitoring.timeSeries.create` w projekcie monitoringu. Nie czyta perimetru, nie czyta stanu,
          # nie czyta kontraktu — więc nawet przejęte nie mówi nic o granicy, a jedynie kłamie o telemetrii.
          service_account: ${{ vars.WATCH_SERVICE_ACCOUNT }}
          token_format: access_token

      - name: zapisz metryki
        env:
          GOOGLE_ACCESS_TOKEN: ${{ steps.auth.outputs.access_token }}
          METRYKI: ${{ needs.measure.outputs.metryki }}
        run: |
          printf '%s' "$METRYKI" > metryki.json
          python3 tools/perimeter_watch.py publish --input metryki.json \
            --project "${{ vars.MONITORING_PROJECT }}"

      # SYGNAŁ ŻYCIA DLA OBSERWATORA POZA TĄ ORGANIZACJĄ — piąta warstwa i jedyna, której nie da się
      # wyłączyć razem z czterema pozostałymi.
      #
      # CO ZAMYKA, bo to jest dokładnie ta luka, którą `terraform/alerts.tf` nazywa u siebie w nagłówku.
      # Wszystkie cztery polityki alertów stoją w projekcie monitoringu — tym samym, w którym leży stan
      # Terraform, pula WIF i buckety kontraktów. Skasowanie tego projektu albo wyłączenie mu billingu nie
      # odpala ŻADNEJ z nich, bo nie ma czego ewaluować. Nie ratuje tego nawet `condition_absent`: on łapie
      # „metryki przestały przychodzić", ale sam potrzebuje żywego silnika ewaluacji, a ten znika razem
      # z projektem. Zostaje cisza nieodróżnialna od zdrowia — na granicy bezpieczeństwa.
      #
      # DLACZEGO PING STOI ZA PUBLIKACJĄ, A NIE NA POCZĄTKU JOBA. Ma znaczyć „cały łańcuch żyje", a nie
      # „runner wstał". Wysłany stąd dowodzi po kolei: GitHub odpalił workflow → `measure` przeczytał stan
      # Terraform z bucketa w projekcie monitoringu → WIF wydał token → `timeSeries.create` przeszedł.
      # Wystarczy, że którekolwiek z tych ogniw padnie i pingu nie ma, a obserwator zewnętrzny odzywa się
      # sam. Ping wysłany wcześniej meldowałby zdrowie martwej maszynerii — czyli robiłby dokładną
      # odwrotność tego, po co tu jest.
      #
      # DLACZEGO NIE MA PINGU `/fail` PRZY PORAŻCE. Kolizja blokady stanu z trwającym `apply` wywraca
      # `measure` CELOWO (patrz komentarz przy `-lock-timeout`) — to zdarzenie znane, tolerowane
      # i samonaprawiające się. `/fail` alarmowałby na nim natychmiast, czyli nauczyłby dyżurnego ignorować
      # kanał, który ma odezwać się raz na nigdy. Cisza zostaje JEDYNYM sygnałem, i właśnie dlatego okno po
      # stronie dostawcy musi tolerować dwa pominięte przebiegi: period 1 h + grace 2 h = 3 h, ta sama
      # liczba co `watchdog_absent_seconds` w `perimeter/alerting.yaml`. Zmieniasz jedno — zmień drugie.
      #
      # DLACZEGO SEKRET DOSTAJE TEN JOB, A NIE `measure`. URL pingu jest poświadczeniem: kto go ma, ten
      # potrafi UCISZYĆ dead-man's-switch. `measure` chodzi na koncie `plan`, które może impersonować każdy
      # pull request — sekret podany tam pozwoliłby autorowi dowolnego PR-a podtrzymywać heartbeat przy
      # martwej maszynerii. To ta sama granica, dla której te dwa joby w ogóle są dwoma jobami; guard
      # `heartbeat DMS we właściwym jobie` w `validate.yml` pilnuje, żeby nikt jej nie „uprościł".
      - name: heartbeat dead-man's-switch (poza tą organizacją)
        # Jawnie, mimo że krok i tak nie ruszy po porażce poprzednika. To jest WARUNEK POPRAWNOŚCI tej
        # warstwy, a nie domyślne zachowanie, na które można się natknąć: dopisanie wyżej kroku
        # z `continue-on-error` bez tej linijki zamieniłoby heartbeat z powrotem w „runner wstał".
        if: success()
        env:
          DMS_URL: ${{ secrets.DMS_PING_URL }}
        run: |
          if [ -z "${DMS_URL}" ]; then
            # BEZPIECZNA DEGRADACJA, ALE WIDOCZNA. Brak sekretu nie może wywracać `watch` — metryki są
            # zapisane, a cztery alerty w GCP działają. Ale cicho nieuzbrojony dead-man's-switch to
            # dokładnie ta klasa defektu, którą to wdrożenie już raz zapłaciło: kontrola obecna
            # w konfiguracji, nieosiągalna w działaniu, brana za spokój. Stąd adnotacja i wiersz
            # w podsumowaniu przebiegu, a nie `echo` ginące w logu.
            echo "::warning::Obserwator poza organizacja NIEUZBROJONY — brak sekretu DMS_PING_URL. Skasowanie projektu monitoringu nie odpali dzis niczego. Uzbrojenie: docs/7-alerty.md#dms-zewnetrzny"
            echo "- Dead-man's-switch (poza GCP): **NIEUZBROJONY** — brak sekretu \`DMS_PING_URL\`" >> "$GITHUB_STEP_SUMMARY"
            exit 0
          fi

          # `-o /dev/null` i ani śladu `-v`: URL jest sekretem, a maskowanie GitHuba nie sięga tego, co
          # wypisze o nim sam curl. `--retry 3 --retry-all-errors`: jeden 5xx u dostawcy nie jest awarią
          # granicy, a okno po stronie checka i tak toleruje cały pominięty przebieg.
          if curl -fsS -m 10 --retry 3 --retry-all-errors -o /dev/null "$DMS_URL"; then
            echo "- Dead-man's-switch (poza GCP): **ping wyslany**" >> "$GITHUB_STEP_SUMMARY"
          else
            # NIE `exit 1`, i to jest decyzja, nie niedbałość. Metryki SĄ opublikowane — czerwony `watch`
            # twierdziłby coś innego i wysłał dyżurnego pod zły adres. A nieudany ping nie potrzebuje
            # naszego meldunku: obserwator zewnętrzny widzi ciszę i odzywa się sam. Na tym polega
            # dead-man's-switch — nie prosi obserwowanego o raport z własnej śmierci.
            echo "::warning::Ping dead-man's-switch nie doszedl. Metryki opublikowane; jesli to sie powtorzy, obserwator zewnetrzny zglosi brak sam."
            echo "- Dead-man's-switch (poza GCP): **ping NIE doszedl**" >> "$GITHUB_STEP_SUMMARY"
          fi
