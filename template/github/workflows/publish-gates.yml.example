# .github/workflows/publish-gates.yml
# Publikuje BRAMKI (schemas/ + policy/) jako artefakt release'u, żeby repozytoria zespołów mogły walidować
# swoje deklaracje u siebie — bez klonowania tego repozytorium.
#
# WHY this exists instead of „just use a submodule": a submodule gives the team the WHOLE repository, which
# includes perimeter/projects.yaml (every division's service accounts and user groups) and perimeter/access-levels/
# (your corporate IP ranges). They need none of that to validate one file of their own. Sparse checkout does
# not fix it either — the history still comes along, so `git show` reaches everything.
#
# What goes out: schemas (JSON Schema) and policy (rego). Those are RULES, not data — they say what a valid
# declaration looks like, and reveal nothing about who is inside the perimeter.

name: publish-gates

on:
  push:
    branches: [main]
    paths:
      - "schemas/**"
      - "policy/**"
      - ".github/workflows/publish-gates.yml"
      # `tools/**` i `contrib/**` — paczka wysyłana zespołom zawiera nie tylko reguły: krok `pack` niżej
      # kopiuje do niej `tools/collect_declarations.py`, `tools/projects_file.py` i `contrib/validate-local.sh`.
      # Bez tych ścieżek zmiana w kolektorze NIE ODŚWIEŻAŁA release'u, więc dywizje walidowały swoje
      # deklaracje starym kodem — a po naszej stronie wszystko było zielone, bo ten workflow po prostu
      # nie ruszał. Cena to jeden release na zmianę narzędzi; przeterminowana paczka u odbiorcy jest
      # droższa, bo nie widać jej z żadnej strony.
      - "tools/**"
      - "contrib/**"
      # `.github/actions/**` — ten job instaluje narzędzia akcją `./.github/actions/narzedzia`, więc jej
      # zmiana zmienia to, czym paczka jest weryfikowana przed wysyłką.
      - ".github/actions/**"
  workflow_dispatch:

permissions:
  contents: write # tworzy release

concurrency:
  group: publish-gates
  cancel-in-progress: true

jobs:
  publish:
    name: pack and publish the gates
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      # Sanity: nie wypuszczamy paczki, która nie przechodzi własnych testów. Bramki wysłane zespołom z
      # zepsutą regułą oznaczają, że każdy z nich zobaczy u siebie fałszywe „zielono" albo fałszywy błąd.
      # Patrz naglowek `.github/actions/narzedzia/action.yml` i DEC-26. Bez `pakiety_python`: ten job
      # nie potrzebuje pipa, a dokladanie mu PyPI byloby powiekszeniem powierzchni awarii, nie porzadkiem.
      - uses: ./.github/actions/narzedzia

      - name: rego unit tests
        run: conftest verify --policy policy

      # Paczka zawiera WYŁĄCZNIE reguły i minimalny zestaw narzędzi potrzebny do ich uruchomienia.
      # Żaden plik z perimeter/ tu nie wchodzi — to jest cała różnica wobec submodule.
      - name: pack
        id: pack
        run: |
          mkdir -p out/gates
          cp -R schemas out/gates/
          cp -R policy out/gates/
          mkdir -p out/gates/tools
          # `projects_file.py` jedzie razem z kolektorem, bo kolektor go IMPORTUJE. Paczka bez niego
          # rozpakowuje sie poprawnie i wywala sie dopiero przy uruchomieniu, u dywizji, komunikatem
          # o module — czyli bramka wysylana zespolom byla by zepsuta w sposob niewidoczny po naszej stronie.
          cp tools/collect_declarations.py tools/projects_file.py out/gates/tools/
          cp contrib/validate-local.sh out/gates/
          tar -czf gates.tar.gz -C out gates
          sha256sum gates.tar.gz | tee gates.tar.gz.sha256
          echo "version=$(date -u +%Y.%m.%d)-${GITHUB_SHA::7}" >> "$GITHUB_OUTPUT"

      # Release z tagiem datowanym — zespół może przypiąć konkretną wersję bramek albo brać `latest`.
      # Pinowanie ma sens dla nich (stabilna walidacja), `latest` ma sens dla nas (od razu widzą nowe reguły).
      - name: release
        env:
          GH_TOKEN: ${{ github.token }}
          VERSION: ${{ steps.pack.outputs.version }}
        run: |
          gh release create "gates-$VERSION" \
            gates.tar.gz gates.tar.gz.sha256 \
            --title "Perimeter gates $VERSION" \
            --notes "Bramki walidacyjne (schemas + policy) do użycia w repozytoriach zespołów.

          Zawiera WYŁĄCZNIE reguły — żadnych danych o członkach perimetru, tożsamościach ani zakresach IP.

          Użycie: akcja contrib (w starterze, .github/actions/contrib — DEC-21) pobiera tę paczkę
          automatycznie. Ręcznie:
              gh release download gates-$VERSION --repo \${{ github.repository }} --pattern gates.tar.gz
              tar -xzf gates.tar.gz && ./gates/validate-local.sh --member <plik.yaml> --gates ./gates"
