# .github/workflows/apply.yml
# The ONLY job in this repository that mutates the perimeter.
#
# Two things make it safe, and both are load-bearing:
#   * environment `perimeter-apply` with required reviewers — a merged PR still does not apply until a human
#     approves the run. This gate lives in GitHub, independent of CODEOWNERS.
#   * single-flight concurrency — Access Context Manager modifies the org-level policy as a whole
#     (read-modify-write), so two parallel applies can silently overwrite each other.

name: apply

on:
  push:
    branches: [main]
    paths:
      - "perimeter/**"
      - "terraform/**"
  workflow_dispatch:

permissions:
  # `write`, nie `read`: ten job publikuje kontrakt także jako asset release'u (krok „apply + publikacja").
  # Zakres jest nadal wąski — token workflowa działa wyłącznie na TYM repozytorium; perimetr zmienia się
  # przez WIF, nie przez ten token.
  contents: write
  id-token: write

# cancel-in-progress MUST stay false: cancelling an apply mid-flight leaves the policy half-written.
concurrency:
  group: vpc-sc-apply
  cancel-in-progress: false

jobs:
  apply:
    name: terraform apply
    runs-on: ubuntu-latest
    environment: perimeter-apply # required reviewers: networking + security
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0

      # The write-capable service account. Its WIF condition pins ref == refs/heads/main AND
      # environment == perimeter-apply, so this identity is unreachable from a pull request.
      - uses: google-github-actions/auth@c200f3691d83b41bf9bbd8638997a462592937ed # v2.1.9
        with:
          workload_identity_provider: ${{ vars.WIF_PROVIDER }}
          service_account: ${{ vars.APPLY_SERVICE_ACCOUNT }}

      - uses: hashicorp/setup-terraform@b9cd54a3c349d3f38e8881555d616ced269862dd # v3.1.2
        with:
          terraform_version: "1.15.5"

      # We re-plan on main and apply that plan. WHY not reuse the PR artifact: main may have moved between
      # review and merge (another division's PR), and applying a stale plan would silently revert it.
      # The safety here comes from the human gate above plus the policy gates that run again below.
      - name: plan on main
        run: |
          terraform -chdir=terraform init -input=false
          terraform -chdir=terraform plan -input=false -lock-timeout=10m -out=tfplan.binary
          terraform -chdir=terraform show -json tfplan.binary > plan.json

      - name: install conftest
        run: |
          curl -sSfL -o /tmp/conftest.tar.gz \
            https://github.com/open-policy-agent/conftest/releases/download/v0.56.0/conftest_0.56.0_Linux_x86_64.tar.gz
          tar -xzf /tmp/conftest.tar.gz -C /tmp conftest
          sudo mv /tmp/conftest /usr/local/bin/

      # Gates run AGAIN here. A gate that only runs on the PR protects the PR, not the boundary.
      - name: policy gates on the plan
        run: conftest test --policy policy --namespace vpcsc.perimeter terraform/plan.json

      # JEDEN KROK, DWIE PUBLIKACJE — i to jest sedno tej konstrukcji, nie oszczędność linijek.
      #
      # Kontrakt trafia w dwa miejsca: do bucketa (robi to sam `terraform apply`, zasób
      # `google_storage_bucket_object.contract`) oraz jako asset release'u `contract` w tym repozytorium.
      # Ta druga droga istnieje po to, żeby repozytorium dywizji NIE potrzebowało tożsamości w GCP —
      # pobiera kontrakt tym samym tokenem GitHuba, którym pobiera paczkę bramek.
      #
      # DLACZEGO to jest JEDEN step, a nie drugi job albo osobny workflow: dwie publikacje w dwóch krokach
      # mają dwa wyzwalacze i dwa wejścia, więc prędzej czy później opublikują DWIE RÓŻNE treści — a konsument
      # nie ma jak zauważyć, że czyta starszą. Tutaj bajty assetu to output `contract_json`, czyli atrybut
      # zasobu ZAPISANEGO PRZEZ TEN APPLY: nie ma drugiego renderu, więc nie ma czego rozjechać.
      # Odrzucone warianty:
      #   * publikacja w `publish-gates.yml` — ten workflow odpala się na zmianę `schemas/`+`policy/`, czyli
      #     w innych momentach niż apply; rozjazd byłby wtedy gwarantowany, nie możliwy;
      #   * osobny job `needs: apply` — jeden stan świata, ale dwa uruchomienia i dwa odczyty stanu; zielony
      #     apply z czerwoną publikacją zostawia rozjazd na stałe i wygląda w historii na „prawie sukces".
      - name: apply + publikacja kontraktu (jeden krok - patrz komentarz)
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          terraform -chdir=terraform apply -input=false -auto-approve tfplan.binary

          # Treść bierzemy z OUTPUTU tego apply. Lokalny plik zrenderowany obok byłby TRZECIĄ kopią.
          terraform -chdir=terraform output -json contract_json > contract.tfout.json
          terraform -chdir=terraform output -json contract_md5 > contract.md5.json

          python3 - <<'PY'
          import base64, hashlib, json, pathlib

          tresc = json.loads(pathlib.Path("contract.tfout.json").read_text())
          w_buckecie = json.loads(pathlib.Path("contract.md5.json").read_text())

          # Sekcja `contract` jest opcjonalna — brak zasobu to null, nie awaria.
          if tresc is None:
              print("policy.yaml nie ma sekcji `contract` - nie ma czego publikowac")
              raise SystemExit(0)

          pathlib.Path("contract.json").write_text(tresc)

          # Porownanie z suma POLICZONA PRZEZ GCS z obiektu, ktory realnie wyladowal w buckecie. Wlasna suma
          # z tej samej zmiennej bylaby tautologia: zgadzalaby sie takze wtedy, gdyby do bucketa nie poszlo nic.
          do_release = base64.b64encode(hashlib.md5(tresc.encode()).digest()).decode()
          if do_release != w_buckecie:
              raise SystemExit(
                  f"::error::kontrakt w buckecie ({w_buckecie}) != kontrakt do release'u ({do_release})")
          print(f"md5 zgodne po obu stronach: {do_release}")
          PY

          if [ ! -f contract.json ]; then
            echo "Kontrakt wyłączony w policy.yaml — publikacja assetu pominięta." >> "$GITHUB_STEP_SUMMARY"
            exit 0
          fi

          # Tag `contract` jest RUCHOMY i to jest zamierzone: konsument potrzebuje AKTUALNEGO kontraktu.
          # Przypięty stary kontrakt oznacza walidację wobec profili, których już nie ma — ten sam powód,
          # dla którego obiekt w buckecie ma `Cache-Control: no-store`. Paczka bramek jest odwrotnie:
          # to REGUŁY, więc tam pinowanie wersji ma sens (`publish-gates.yml`).
          gh release view contract >/dev/null 2>&1 \
            || gh release create contract --title "Kontrakt perimetru (zawsze aktualny)" \
                 --notes "Asset contract.json podmieniany przy KAZDYM apply, razem z obiektem w buckecie kontraktow - obie publikacje wychodza z jednego kroku. Pobranie: gh release download contract --pattern contract.json. NIE przypinaj wersji: kontrakt opisuje STAN, nie reguly."
          gh release upload contract contract.json --clobber

          echo "Kontrakt opublikowany: bucket + asset release'u \`contract\`." >> "$GITHUB_STEP_SUMMARY"

      # Done means measured. The outputs say who is really enforced now — paste-able into the ticket.
      - name: report what is live
        run: |
          # `contract_json` wycięty z podsumowania: to ~4 KB w JEDNEJ linii, które wypchnęłoby stąd listę
          # członków — a fakt jego publikacji potwierdza (albo wywraca) krok wyżej, nie ten raport.
          {
            echo "### Perimeter after apply"
            echo '```json'
            terraform -chdir=terraform output -json \
              | python3 -c 'import json,sys; d=json.load(sys.stdin); d.pop("contract_json", None); print(json.dumps(d, indent=2))' \
              | head -60
            echo '```'
          } >> "$GITHUB_STEP_SUMMARY"
