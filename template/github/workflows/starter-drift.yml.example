# .github/workflows/starter-drift.yml
# Is this repository still running the starter it says it runs?
#
# WHY. This repo is the starter unpacked plus environment values. Fixes are written in the starter,
# because that is where they belong — and until somebody carries them over, the perimeter runs code that
# is not the source. Measured: two divergences in a single day. In the second one the dry-run violations
# report claimed a clean window while the member had 30 real violations, and that report is the EVIDENCE
# the promotion gate reads. So the failure mode of "we'll sync it when we remember" is not an untidy repo,
# it is a green gate built on a stale one.
#
# WHY A POINTER AND NOT A TREE DIFF. Comparing this repo against `install.sh` output byte for byte would
# be red permanently and legitimately: the environment values are exactly what this repo is supposed to
# have and the template is not. A gate that is always red teaches everyone to ignore it. So we compare the
# ONE thing that is unambiguous — the starter commit recorded in `.starter-sync` against the starter's
# `main` — and print the commits in between. That is the list of what has to be carried over, and nothing
# else. The starter is public, so this needs no secret and no access to anything.
#
# WHY IT DOES NOT BLOCK EVERY PULL REQUEST. A pull request about an access level has nothing to do with
# upstream moving; failing it would be noise, and noise is how gates die. This runs on a schedule and on
# demand — and the promotion procedure requires a green run on demand BEFORE promoting a member, because
# that is the operation whose evidence is worth nothing if the tooling is stale.

name: starter-drift

on:
  schedule:
    - cron: "0 5 * * 1" # Monday, before the week's promotion pull requests
  workflow_dispatch:

permissions:
  contents: read
  issues: write

jobs:
  starter-drift:
    name: is the template material still current
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0

      - name: compare the recorded starter commit with the starter's main
        id: compare
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          set -o pipefail
          repo=$(sed -n 's/^repo:[[:space:]]*//p' .starter-sync | head -1)
          mine=$(sed -n 's/^commit:[[:space:]]*//p' .starter-sync | head -1)
          # An unreadable pointer is not "in sync": it means nobody can tell what this repo runs.
          case "$mine" in
            [0-9a-f]*) [ "${#mine}" = 40 ] || { echo "::error::.starter-sync: commit is not a full sha"; exit 1; } ;;
            *) echo "::error::.starter-sync: no readable commit"; exit 1 ;;
          esac
          [ -n "$repo" ] || { echo "::error::.starter-sync: no readable repo"; exit 1; }
          head=$(gh api "repos/$repo/commits/main" --jq .sha)
          echo "recorded: $mine"
          echo "starter main: $head"
          if [ "$mine" = "$head" ]; then
            echo "behind=0" >> "$GITHUB_OUTPUT"
            echo "In sync with $repo@$head" >> "$GITHUB_STEP_SUMMARY"
            exit 0
          fi
          # `compare` also tells us whether the recorded commit is an ancestor at all — a pointer that is
          # AHEAD or unrelated means somebody edited the file by hand, which is worth failing on separately.
          gh api "repos/$repo/compare/$mine...$head" > compare.json
          status=$(python3 -c 'import json;print(json.load(open("compare.json"))["status"])')
          [ "$status" = "behind" ] && { echo "::error::.starter-sync points AHEAD of the starter"; exit 1; }
          python3 - <<'PY' >> missing.md
          import json
          d = json.load(open("compare.json"))
          print(f"{d['ahead_by']} commit(s) in the starter are not in this repo:\n")
          for c in d["commits"]:
              print(f"- `{c['sha'][:9]}` {c['commit']['message'].splitlines()[0]}")
          PY
          cat missing.md >> "$GITHUB_STEP_SUMMARY"
          {
            echo "behind=1"
            echo "count=$(python3 -c 'import json;print(json.load(open("compare.json"))["ahead_by"])')"
          } >> "$GITHUB_OUTPUT"

      # DRUGA KONTROLA, WĘŻSZA OD WSKAŹNIKA I SZERSZA NIŻ ON — czy zbiór DECYZJI tutaj pokrywa zbiór
      # decyzji startera.
      #
      # PO CO, SKORO WSKAŹNIK. Wskaźnik odpowiada na pytanie „czy ktoś przeniósł commity", a nie „czy
      # przeniósł całą ich treść". Zmierzone: wskaźnik wskazywał aktualny `main` startera — ta bramka
      # była ZIELONA — a `docs/0-decyzje.md` nie miało dwóch całych decyzji, w tym jednej cytowanej
      # w dziewięciu miejscach tego samego repozytorium. Sync commit-po-commicie tego nie widzi, bo
      # każdy pojedynczy przeniesiony commit wygląda na kompletny.
      #
      # DLACZEGO TO JEST BEZPIECZNE, A PORÓWNANIE DRZEWA NIE BYŁOBY. Porównujemy ZBIÓR NUMERÓW SEKCJI,
      # nie treść. Treść decyzji tutaj różni się od startera legalnie i zwykle różnić się musi — opisuje
      # wdrożenie, nie szablon. Bramka na treści byłaby zawsze czerwona, czyli byłaby tym, czego ta
      # konstrukcja unika z premedytacją.
      #
      # DLACZEGO TU, A NIE PRZY POZOSTAŁYCH BRAMKACH TREŚCI: potrzebuje startera, czyli sieci. Połowa,
      # która sieci nie potrzebuje (każdy CYTOWANY numer ma sekcję), stoi w `bramki-tresci` i biegnie na
      # każdym wniosku oraz na ścieżce apply.
      - name: compare the set of decisions with the starter
        id: decyzje
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          set -o pipefail
          repo=$(sed -n 's/^repo:[[:space:]]*//p' .starter-sync | head -1)
          # `--jq .content | base64 -d` zamiast surowego `raw`: `raw` na prywatnym forku wymagałby innego
          # nagłówka, a `contents` działa jednakowo. Pusty plik na wyjściu jest wykryty przez samo
          # narzędzie (fail-closed na zepsutym wejściu), nie przemilczany tutaj.
          gh api "repos/$repo/contents/docs/0-decyzje.md" --jq .content | base64 -d > /tmp/decyzje-startera.md
          if python3 tools/decisions_check.py --wzgledem /tmp/decyzje-startera.md > brak-decyzji.txt 2>&1; then
            echo "brakujace=0" >> "$GITHUB_OUTPUT"
            cat brak-decyzji.txt >> "$GITHUB_STEP_SUMMARY"
          else
            echo "brakujace=1" >> "$GITHUB_OUTPUT"
            {
              echo ""
              echo "Decyzje startera, ktorych tu nie ma:"
              echo ""
              sed -e 's/^::error:://' brak-decyzji.txt
            } >> "$GITHUB_STEP_SUMMARY"
          fi
          cat brak-decyzji.txt

      # The issue is the artefact an operator reads before promoting. Updated in place rather than opened
      # every Monday: a stack of identical issues is the same thing as no issue.
      - name: open or update the drift issue
        if: steps.compare.outputs.behind == '1' || steps.decyzje.outputs.brakujace == '1'
        uses: actions/github-script@f28e40c7f34bde8b3046d885e986cb6290c5673b # v7.1.0
        with:
          script: |
            const fs = require('fs');
            // Każdy z dwóch powodów może wystąpić SAM — a plik drugiego wtedy nie istnieje. Czytanie go
            // bez tego opakowania wywracałoby krok wyjątkiem `ENOENT` dokładnie wtedy, gdy zgłoszenie
            // ma powstać, czyli zamieniałoby wykrytą niekompletność w awarię workflowa.
            const czytaj = (p) => fs.existsSync(p) ? fs.readFileSync(p, 'utf8') : '';
            const title = 'starter-drift: this repository is behind the starter';
            const wskaznik = '${{ steps.compare.outputs.behind }}' === '1';
            const decyzje = '${{ steps.decyzje.outputs.brakujace }}' === '1';
            const body = [
              'The template material in this repository is older than the starter.',
              '',
              wskaznik ? czytaj('missing.md') : 'The recorded starter commit matches the starter main.',
              '',
              // ROZJAZD TREŚCI PRZY ZGODNYM WSKAŹNIKU jest osobnym zdaniem i tak go tu piszemy: to jest
              // stan, w którym poprzednia wersja tej bramki świeciła na zielono, a repozytorium nie miało
              // dwóch całych decyzji — jednej cytowanej w dziewięciu miejscach własnego kodu.
              decyzje
                ? ['The set of DECISIONS here does not cover the starter. This is the failure the pointer',
                   'comparison cannot see: the commits were carried over, their content was not.',
                   '', '```', czytaj('brak-decyzji.txt'), '```'].join('\n')
                : 'The set of decisions covers the starter.',
              '',
              'Carry them over with a THREE-WAY merge (see `.starter-sync` for the method) and raise',
              '`commit:` in the same pull request. Do not promote a member to `enforced` until this is',
              'closed: the gates that produce the evidence for that promotion are part of what is stale.',
            ].join('\n');
            const open = await github.rest.issues.listForRepo({
              owner: context.repo.owner, repo: context.repo.repo, state: 'open', labels: 'starter-drift',
            });
            const found = open.data.find(i => i.title === title);
            if (found) {
              await github.rest.issues.update({
                owner: context.repo.owner, repo: context.repo.repo, issue_number: found.number, body,
              });
            } else {
              await github.rest.issues.create({
                owner: context.repo.owner, repo: context.repo.repo, title, body,
                labels: ['starter-drift'],
              });
            }

      # Red, not just an issue. An issue nobody assigned is a note; a red scheduled workflow is visible on
      # the repository's front page and in the operator's notifications.
      - name: fail when behind
        if: steps.compare.outputs.behind == '1' || steps.decyzje.outputs.brakujace == '1'
        run: |
          if [ "${{ steps.compare.outputs.behind }}" = "1" ]; then
            echo "::error::behind the starter by ${{ steps.compare.outputs.count }} commit(s) — see the starter-drift issue"
          fi
          # Osobny komunikat, bo to jest inny stan i inna naprawa. „Za wskaźnikiem" znaczy „przenieś
          # commity"; „brak decyzji przy zgodnym wskaźniku" znaczy „poprzedni sync przeniósł commit, ale
          # nie całą jego treść" — i jest to jedyny z tych dwóch, którego samo podniesienie `commit:`
          # nie naprawia, a wręcz zamyka mu drogę do wykrycia.
          if [ "${{ steps.decyzje.outputs.brakujace }}" = "1" ]; then
            echo "::error::the set of decisions does not cover the starter — the pointer is current but content is missing; see the starter-drift issue"
          fi
          exit 1
