<mxfile host="app.diagrams.net" agent="starter" version="24.0.0">
  <diagram name="Trzy kanaly, jeden mutator" id="d1">
    <mxGraphModel dx="2040" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2040" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="Trzy kanały wejścia — jeden byt, który zmienia perimetr" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="32" as="geometry" /></mxCell>
        <mxCell id="t2" value="Zmienia się WYŁĄCZNIE to, skąd przychodzi PR. Apply jest jeden, na jednym stanie, single-flight." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1400" height="20" as="geometry" /></mxCell>
        <mxCell id="h1" value="1 · SKĄD PRZYCHODZI ZGŁOSZENIE" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="400" height="20" as="geometry" /></mxCell>
        <mxCell id="h2" value="2 · REPO PERIMETRU" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="96" width="340" height="20" as="geometry" /></mxCell>
        <mxCell id="h3" value="3 · BRAMKI I APPLY" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="940" y="96" width="420" height="20" as="geometry" /></mxCell>
        <mxCell id="h4" value="4 · GOOGLE CLOUD (ACM)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1520" y="96" width="480" height="20" as="geometry" /></mxCell>
        <mxCell id="a" value="&lt;b&gt;A · Formularz (ServiceNow)&lt;/b&gt;&lt;br&gt;zespół bez Terraforma → approval sieci&lt;br&gt;↳ intake.yml ODDZWANIA do API ticketu:&lt;br&gt;   istnieje? zatwierdzony? właściwa grupa?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f4f8;strokeColor=#4a6785;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="400" height="96" as="geometry" /></mxCell>
        <mxCell id="b" value="&lt;b&gt;B · Architekt / zespół sieciowy&lt;/b&gt;&lt;br&gt;PR wprost w repozytorium perimetru&lt;br&gt;↳ „bezpośrednio&quot; = bez formularza,&lt;br&gt;   NIE bez bramek (statusy wiążą adminów)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f4f8;strokeColor=#4a6785;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="246" width="400" height="96" as="geometry" /></mxCell>
        <mxCell id="c" value="&lt;b&gt;C · Repozytorium innego zespołu&lt;/b&gt;&lt;br&gt;u siebie: vpc-sc/request.yaml, walidacja&lt;br&gt;kontraktem + paczką bramek → dispatch&lt;br&gt;↳ external-intake.yml sprawdza&lt;br&gt;   contributors.yaml: czy TO repo może&lt;br&gt;   prosić o TEN projekt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f4f8;strokeColor=#4a6785;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="362" width="400" height="128" as="geometry" /></mxCell>
        <mxCell id="cn" value="&lt;b&gt;Repo zespołu NIE dostaje dostępu do GCP&lt;/b&gt;&lt;br&gt;ani PAT-a do organizacji, ani WIF-a.&lt;br&gt;Ma token GitHub App na repo perimetru:&lt;br&gt;Contents: Read-only (kontrakt, bramki) +&lt;br&gt;Actions: Read and write (uruchomienie&lt;br&gt;external-intake.yml). ZERO prawa zapisu kodu." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#b3261e;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="400" height="96" as="geometry" /></mxCell>
        <mxCell id="an" value="Payload webhooka to DANE, nigdy autoryzacja —&lt;br&gt;dlatego oba automaty oddzwaniają do źródła." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="624" width="400" height="36" as="geometry" /></mxCell>
        <mxCell id="pr" value="&lt;b&gt;PR: jeden plik YAML&lt;/b&gt;&lt;br&gt;perimeter/members/&amp;lt;zespół&amp;gt;/&amp;lt;projekt&amp;gt;.yaml&lt;br&gt;&lt;br&gt;stage: dry-run — ZAWSZE,&lt;br&gt;niezależnie od kanału" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5c5c5c;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="520" y="246" width="340" height="128" as="geometry" /></mxCell>
        <mxCell id="g" value="&lt;b&gt;Bramki maszynowe (bez chmury)&lt;/b&gt;&lt;br&gt;JSON Schema · OPA na PLANIE, nie na deklaracji&lt;br&gt;pre-flight na żywym GCP (read-only)&lt;br&gt;budżet 6000 atrybutów/konfigurację" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e0;strokeColor=#b8860b;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="940" y="262" width="420" height="96" as="geometry" /></mxCell>
        <mxCell id="m" value="&lt;b&gt;Merge&lt;/b&gt;&lt;br&gt;auto tylko dla zmian addytywnych;&lt;br&gt;reszta — człowiek (sieć + security)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5c5c5c;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="940" y="392" width="420" height="76" as="geometry" /></mxCell>
        <mxCell id="ap" value="&lt;b&gt;apply.yml — JEDYNE miejsce z dostępem do GCP&lt;/b&gt;&lt;br&gt;WIF keyless (zero kluczy w repo), environment&lt;br&gt;z reviewerami, plan z artefaktu pinowanego SHA256,&lt;br&gt;single-flight (bez cancel-in-progress)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#2e7d43;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="940" y="500" width="420" height="100" as="geometry" /></mxCell>
        <mxCell id="apn" value="attribute_condition puli WIF pinuje TO repozytorium&lt;br&gt;+ TEN environment. Token z pull requesta go nie niesie,&lt;br&gt;więc PR-em nie da się posłużyć tożsamością apply." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="940" y="620" width="420" height="52" as="geometry" /></mxCell>
        <mxCell id="d" value="&lt;b&gt;Konfiguracja DRY-RUN&lt;/b&gt;&lt;br&gt;projekt jest w perimetrze,&lt;br&gt;ale NIC nie jest blokowane — naruszenia lądują w logach" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#2e7d43;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1520" y="130" width="480" height="76" as="geometry" /></mxCell>
        <mxCell id="o" value="&lt;b&gt;Okno obserwacji&lt;/b&gt;&lt;br&gt;min. 14 dni ORAZ zero naruszeń w ostatnich 7&lt;br&gt;raport per właściciel: „to przestanie działać&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5c5c5c;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1520" y="230" width="480" height="76" as="geometry" /></mxCell>
        <mxCell id="p" value="&lt;b&gt;Promocja = DRUGI PR, zawsze z człowiekiem&lt;/b&gt;&lt;br&gt;jedno pole w YAML: stage: dry-run → enforced" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5c5c5c;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1520" y="330" width="480" height="60" as="geometry" /></mxCell>
        <mxCell id="e" value="&lt;b&gt;Konfiguracja EGZEKWOWANA&lt;/b&gt;&lt;br&gt;od tej chwili perimetr realnie blokuje" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#2e7d43;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1520" y="414" width="480" height="60" as="geometry" /></mxCell>
        <mxCell id="bg" value="&lt;b&gt;break-glass.yml — gdy blokuje LEGALNY ruch&lt;/b&gt;&lt;br&gt;wyjmij członka z konfiguracji egzekwowanej:&lt;br&gt;2 approverów, automatyczny issue postmortem.&lt;br&gt;Dry-run ZOSTAJE — incydent nie kasuje pomiaru." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#b3261e;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1520" y="510" width="480" height="96" as="geometry" /></mxCell>
        <mxCell id="f1" value="&lt;b&gt;Dlaczego dwa etapy, skoro to spowalnia onboarding:&lt;/b&gt; projekt może należeć do JEDNEJ konfiguracji egzekwowanej i JEDNEJ dry-run. Wrzucenie zespołu od razu do egzekwowanej odcina mu produkcję&lt;br&gt;w minutę po merge&#x27;u — bo nikt, łącznie z nim, nie zna wszystkich swoich przepływów przed pomiarem. Dry-run to jedyny sposób, żeby je ZMIERZYĆ zamiast zgadywać." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1880" height="40" as="geometry" /></mxCell>
        <mxCell id="f2" value="&lt;b&gt;Dlaczego jeden mutator:&lt;/b&gt; audyt (dlaczego ta reguła istnieje i kto ją zaakceptował) · rollback (git revert zamiast rekonstrukcji stanu z pamięci) · wykrywanie dryfu (bez deklaratywnego źródła nie ma z czym porównać stanu realnego)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="752" width="1880" height="20" as="geometry" /></mxCell>
        <mxCell id="f3" value="&lt;b&gt;Czego NIE ma na tym rysunku:&lt;/b&gt; ścieżki, w której cokolwiek poza apply.yml dotyka Access Context Managera. Nie ma jej też w kodzie — i to jest cała teza tego układu." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="784" width="1880" height="20" as="geometry" /></mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5c5c5c;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="a" target="pr"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5c5c5c;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b" target="pr"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5c5c5c;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c" target="pr"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5c5c5c;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="pr" target="g"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5c5c5c;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="g" target="m"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5c5c5c;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="m" target="ap"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5c5c5c;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" edge="1" parent="1" source="ap" target="d"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5c5c5c;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d" target="o"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5c5c5c;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="o" target="p"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5c5c5c;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p" target="e"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9e9e9e;strokeWidth=1;dashed=1;endArrow=open;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="e" target="bg"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
