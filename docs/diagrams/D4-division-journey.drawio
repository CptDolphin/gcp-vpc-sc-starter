<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram name="D4-division-journey" id="d4-division">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="D4 · Joining the perimeter — what it looks like for YOUR team" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#202124;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1100" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="sub" value="You fill in one request and pick a use-case profile. You never write VPC-SC rules. Nothing in your project is blocked for the first two weeks — that window exists so you can see what WOULD break, and fix it before it does." style="text;html=1;fontSize=13;fontStyle=2;align=left;verticalAlign=middle;fontColor=#5F6368;" vertex="1" parent="1">
          <mxGeometry x="40" y="54" width="1500" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="h0" value="BEFORE YOU START" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#888888;fontStyle=1;fontSize=12;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="230" y="95" width="300" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="h1" value="DAY 0 — you raise the request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="550" y="95" width="300" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="h2" value="DAY 0 — happens without you" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="870" y="95" width="300" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="h3" value="DAYS 1–14 — observation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#888888;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1190" y="95" width="300" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="h4" value="DAY 15+ — protected" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1510" y="95" width="300" height="34" as="geometry"/>
        </mxCell>

        <mxCell id="lane1bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7FBFF;strokeColor=#B7CDE3;" vertex="1" parent="1">
          <mxGeometry x="40" y="145" width="1770" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="lane1lbl" value="&lt;b&gt;YOU&lt;/b&gt;&lt;br&gt;(division team)&lt;br&gt;&lt;br&gt;&lt;i&gt;what you actually do&lt;/i&gt;" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#1A4E80;" vertex="1" parent="1">
          <mxGeometry x="55" y="145" width="165" height="270" as="geometry"/>
        </mxCell>

        <mxCell id="lane2bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBF7FD;strokeColor=#CDB7E3;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="1770" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="lane2lbl" value="&lt;b&gt;PLATFORM&lt;/b&gt;&lt;br&gt;(networking + automation)&lt;br&gt;&lt;br&gt;&lt;i&gt;happens without you&lt;/i&gt;" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#6C4B87;" vertex="1" parent="1">
          <mxGeometry x="55" y="430" width="165" height="230" as="geometry"/>
        </mxCell>

        <mxCell id="lane3bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFCF5;strokeColor=#E3CDB7;" vertex="1" parent="1">
          <mxGeometry x="40" y="675" width="1770" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="lane3lbl" value="&lt;b&gt;YOUR PROJECT&lt;/b&gt;&lt;br&gt;what is actually&lt;br&gt;in force&lt;br&gt;&lt;br&gt;&lt;i&gt;read this row first&lt;/i&gt;" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#B26B00;" vertex="1" parent="1">
          <mxGeometry x="55" y="675" width="165" height="145" as="geometry"/>
        </mxCell>

        <mxCell id="y0" value="&lt;b&gt;Get the network ready&lt;/b&gt;&lt;br&gt;(you or your network owner)&lt;br&gt;&lt;br&gt;• Private Google Access on the subnets&lt;br&gt;• private DNS zone sending googleapis.com&lt;br&gt;&nbsp; to the restricted VIP 199.36.153.4/30&lt;br&gt;&lt;br&gt;&lt;i&gt;A pre-flight check blocks the request if&lt;br&gt;this is missing — it is not optional.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4C6FA6;align=left;spacing=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="230" y="160" width="300" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="y0b" value="⚠️ Create Vertex AI endpoints AFTER joining.&#10;An endpoint made before the project joins&#10;cannot have models deployed to it later." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;spacing=6;fontSize=11;fontColor=#7F6000;" vertex="1" parent="1">
          <mxGeometry x="230" y="350" width="300" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="y1" value="&lt;b&gt;One ServiceNow request&lt;/b&gt;&lt;br&gt;&lt;br&gt;• which project(s)&lt;br&gt;• &lt;b&gt;pick a use-case profile&lt;/b&gt;, e.g.&lt;br&gt;&nbsp; „online prediction&quot;, „training jobs&quot;,&lt;br&gt;&nbsp; „people using the console&quot;&lt;br&gt;• owner group · review date&lt;br&gt;&lt;br&gt;&lt;i&gt;You do NOT write ingress/egress rules.&lt;br&gt;The profile is written and reviewed once,&lt;br&gt;centrally, and reused by every division.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacing=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="550" y="160" width="300" height="220" as="geometry"/>
        </mxCell>

        <mxCell id="y2" value="Nothing.&#10;&#10;Approval, the pull request, the checks and&#10;the apply happen on the platform side.&#10;You get a link to follow along." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9E9E9E;dashed=1;align=left;spacing=8;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="870" y="160" width="300" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="y3" value="&lt;b&gt;Read your violation report&lt;/b&gt;&lt;br&gt;(sent to your owner group)&lt;br&gt;&lt;br&gt;It lists, in plain terms:&lt;br&gt;&lt;i&gt;„this service account calls this method&lt;br&gt;and it WILL stop working after promotion&quot;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Two ways to fix it:&lt;br&gt;• change the flow on your side, or&lt;br&gt;• ask for a profile that covers it&lt;br&gt;&nbsp; (never for a hand-written rule)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4C6FA6;align=left;spacing=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1190" y="160" width="300" height="230" as="geometry"/>
        </mxCell>

        <mxCell id="y4" value="&lt;b&gt;Business as usual — with two habits&lt;/b&gt;&lt;br&gt;&lt;br&gt;• a NEW kind of access = a new request&lt;br&gt;&nbsp; (usually just another profile)&lt;br&gt;• confirm the entry at the review date,&lt;br&gt;&nbsp; otherwise the project is proposed&lt;br&gt;&nbsp; for removal&lt;br&gt;&lt;br&gt;&lt;i&gt;If the perimeter ever blocks something&lt;br&gt;legitimate: raise an incident — there is a&lt;br&gt;break-glass path that takes minutes.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4C6FA6;align=left;spacing=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1510" y="160" width="300" height="230" as="geometry"/>
        </mxCell>

        <mxCell id="p1" value="Networking team approves the ticket&#10;(Security joins only if you asked for&#10;something outside the profile catalogue)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;spacing=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="550" y="450" width="300" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p2" value="&lt;b&gt;Automation takes over&lt;/b&gt;&lt;br&gt;• verifies the ticket back in ServiceNow&lt;br&gt;• opens a pull request with your entry&lt;br&gt;• runs the checks (network pre-flight,&lt;br&gt;&nbsp; policy rules, capacity)&lt;br&gt;• applies — usually within the hour" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;spacing=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="870" y="450" width="300" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="p3" value="Weekly report of what your project&#10;tried to do that the perimeter would&#10;have blocked — sent to your owner group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;spacing=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1190" y="450" width="300" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p4" value="&lt;b&gt;Promotion is a human decision&lt;/b&gt;&lt;br&gt;networking + security approve it, and only&lt;br&gt;when the report is clean&lt;br&gt;&lt;br&gt;&lt;i&gt;Not clean? You stay in observation.&lt;br&gt;Nobody flips the switch on a project&lt;br&gt;that is still generating violations.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;spacing=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1510" y="450" width="300" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="s0" value="Outside the perimeter&#10;nothing changed yet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;dashed=1;align=center;spacing=6;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="230" y="710" width="300" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="s1" value="Still outside&#10;nothing changed yet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;dashed=1;align=center;spacing=6;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="550" y="710" width="300" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;In OBSERVATION mode&lt;/b&gt;&lt;br&gt;calls are recorded, &lt;b&gt;nothing is blocked&lt;/b&gt;&lt;br&gt;&lt;i&gt;(and nothing is protected yet either)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=center;spacing=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="870" y="700" width="300" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;Still OBSERVATION&lt;/b&gt;&lt;br&gt;your production keeps working&lt;br&gt;exactly as before" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=center;spacing=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1190" y="700" width="300" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;PROTECTED&lt;/b&gt;&lt;br&gt;calls that do not match a rule are denied&lt;br&gt;&lt;i&gt;a stolen credential no longer reaches&lt;br&gt;your data from outside the perimeter&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=center;spacing=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1510" y="695" width="300" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="note1" value="&lt;b&gt;Two things worth knowing up front&lt;/b&gt;&lt;br&gt;&lt;b&gt;1.&lt;/b&gt; The perimeter stops data leaving to the outside. It does &lt;b&gt;not&lt;/b&gt; separate you from other divisions inside it — access between teams is still governed by IAM, exactly as today.&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; The two-week window is not bureaucracy. It is the only way to find out what your project really calls, instead of guessing — and guessing is what turns a security change into your outage." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=10;fontSize=12;fontColor=#7F6000;" vertex="1" parent="1">
          <mxGeometry x="230" y="855" width="1580" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="y0" target="y1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="y1" target="p1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="p2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="joins in observation mode" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2" target="s2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3" target="p4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="report" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.6;dashed=1;endArrow=open;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3" target="y3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="clean window → approved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2.4;strokeColor=#B85450;endArrow=block;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4" target="s4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="violations found → fix first, stay in observation" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.6;dashed=1;strokeColor=#4C6FA6;endArrow=open;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="y3" target="s3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
