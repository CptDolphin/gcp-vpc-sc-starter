<mxfile host="app.diagrams.net" agent="starter" version="24.0.0">
  <diagram name="Where things live" id="d1">
    <mxGraphModel dx="2020" dy="920" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2020" pageHeight="920" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="Where things live — the perimeter repository and a team repository" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="32" as="geometry" /></mxCell>
        <mxCell id="t2" value="The ownership boundary is what matters here: we automate the BOUNDARY, not somebody else&#x27;s infrastructure. The network prerequisite is ENFORCED by a gate, but fixed by whoever owns it." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1600" height="20" as="geometry" /></mxCell>
        <mxCell id="lp" value="PERIMETER REPOSITORY — owner: Security + Networking · the only thing that mutates the perimeter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9e9e9e;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1010" height="525" as="geometry" /></mxCell>
        <mxCell id="lt" value="gcp-vpc-sc/&lt;br&gt;├─ perimeter/&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;SOURCE OF TRUTH — YAML, not HCL&lt;br&gt;│&amp;nbsp;&amp;nbsp;├─ policy.yaml&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;baseline: restricted services, dry-run window,&lt;br&gt;│&amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;attribute budget&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;[network + security]&lt;br&gt;│&amp;nbsp;&amp;nbsp;├─ access-levels/corp.yaml&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;corp IP, managed devices [network + security]&lt;br&gt;│&amp;nbsp;&amp;nbsp;├─ profiles/&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;rule SHAPE — 4 files FOR THE WHOLE ORG&lt;br&gt;│&amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp;├─ vertex-online-serving.yaml&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;[network + security]&lt;br&gt;│&amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp;├─ vertex-batch-training.yaml&lt;br&gt;│&amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp;├─ corp-user-console-access.yaml&lt;br&gt;│&amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp;└─ bq-omni-external-read.yaml&lt;br&gt;│&amp;nbsp;&amp;nbsp;├─ projects.yaml&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ALL MEMBERSHIP IN ONE FILE (grows to 200 entries)&lt;br&gt;│&amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp;members:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;[network + security; the bot APPENDS one entry]&lt;br&gt;│&amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp;- division: example-division&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;key = &amp;lt;division&amp;gt;-&amp;lt;project_id&amp;gt; — from&lt;br&gt;│&amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;project_id: prj-example-dev&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;the ENTRY, not from a filename&lt;br&gt;│&amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;stage: dry-run&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(stage: enforced lives in the same list)&lt;br&gt;│&amp;nbsp;&amp;nbsp;└─ contributors.yaml&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;team repo -&amp;gt; allowed projects&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;[network + security]&lt;br&gt;├─ .gitattributes&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;projects.yaml merge=union — ONLY with the duplicate gate&lt;br&gt;├─ tools/projects_file.py&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;the only reader/writer; throws on a duplicate key&lt;br&gt;├─ terraform/&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;RENDERER: YAML -&amp;gt; ACM resources&lt;br&gt;│&amp;nbsp;&amp;nbsp;├─ locals.tf&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;the ONLY place with logic in this repo&lt;br&gt;│&amp;nbsp;&amp;nbsp;├─ members.tf&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;_resource + _dry_run_resource&lt;br&gt;│&amp;nbsp;&amp;nbsp;├─ rules.tf&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;_ingress_policy / _egress_policy&lt;br&gt;│&amp;nbsp;&amp;nbsp;├─ contract.tf&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;publishes the contract for other repos&lt;br&gt;│&amp;nbsp;&amp;nbsp;└─ versions.tf&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ONE backend, ONE state for the whole perimeter&lt;br&gt;├─ policy/*.rego&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;OPA gates on plan JSON — the duplicate rules among them&lt;br&gt;├─ schemas/*.json&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;request structure (rejects the boring errors)&lt;br&gt;├─ iam-bootstrap/&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;SEPARATE STACK, separate state —&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;applied by the IAM team, not by this pipeline&lt;br&gt;└─ .github/workflows/&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;apply = the only mutator; intake-rebase re-applies requests" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="58" y="140" width="980" height="475" as="geometry" /></mxCell>
        <mxCell id="rp" value="TEAM REPOSITORY — owner: the product team · ZERO permissions in Access Context Manager" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9e9e9e;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1100" y="100" width="880" height="330" as="geometry" /></mxCell>
        <mxCell id="rt" value="division-a/&lt;br&gt;├─ terraform/&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;PREREQ — we verify it, we do NOT fix it&lt;br&gt;│&amp;nbsp;&amp;nbsp;├─ project.tf&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;the project and its number&lt;br&gt;│&amp;nbsp;&amp;nbsp;├─ network.tf&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;private_ip_google_access = true&lt;br&gt;│&amp;nbsp;&amp;nbsp;├─ dns.tf&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;*.googleapis.com -&amp;gt; restricted VIP&lt;br&gt;│&amp;nbsp;&amp;nbsp;└─ vertex.tf&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;endpoints, notebooks, bucket&lt;br&gt;├─ vpc-sc/&lt;br&gt;│&amp;nbsp;&amp;nbsp;└─ request.yaml&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;WHAT I need: project + profile&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;+ parameters. NEVER rules&lt;br&gt;└─ .github/workflows/&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;└─ vpc-sc-request.yml&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;validates locally with the gates bundle,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;then starts external-intake.yml" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1118" y="140" width="850" height="285" as="geometry" /></mxCell>
        <mxCell id="k1" value="&lt;b&gt;-&amp;gt; outbound: THE CONTRACT (~4 KB, published after every apply)&lt;/b&gt;&lt;br&gt;perimeter name · restricted services · onboarding window parameters&lt;br&gt;access level NAMES · profile catalogue (name, risk, parameter names)&lt;br&gt;+ separately, a gates bundle: schemas/ and policy/ — RULES, not data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#2e7d43;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1100" y="460" width="880" height="96" as="geometry" /></mxCell>
        <mxCell id="k2" value="&lt;b&gt;What the contract does NOT contain — and that is the whole point&lt;/b&gt;&lt;br&gt;not one identity · not one IP range · not one rule.&lt;br&gt;The alternative was a submodule with the entire repo: to validate ONE file,&lt;br&gt;a team would receive perimeter/projects.yaml — the membership of every division — and your network topology." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#b3261e;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1100" y="580" width="880" height="96" as="geometry" /></mxCell>
        <mxCell id="k3" value="&lt;b&gt;&amp;lt;- inbound: workflow_dispatch (GitHub App token, actions: write)&lt;/b&gt;&lt;br&gt;the bot opens a PR appending ONE entry to perimeter/projects.yaml.&lt;br&gt;The team&#x27;s entire permission: START that workflow. No code write here,&lt;br&gt;nothing in GCP. Measured: actions and contents are disjoint both ways." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5c5c5c;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1100" y="700" width="880" height="76" as="geometry" /></mxCell>
        <mxCell id="n0" value="&lt;b&gt;No Terraform lives under perimeter/.&lt;/b&gt; Those directories hold plain YAML — no main.tf, no backend.tf, no per-project state. There is ONE Terraform root, ONE backend and ONE state for the whole perimeter;&lt;br&gt;locals.tf reads that ONE file and for_each over the members LIST renders GRANULAR ACM resources. Adding an ENTRY = adding a resource; the address comes from the entry, not a filename." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="1010" height="40" as="geometry" /></mxCell>
        <mxCell id="n1" value="&lt;b&gt;Why ONE shared file rather than a file per project:&lt;/b&gt; one place answers WHO is inside the boundary, and onboarding is an APPEND to a list, not a new file the renderer must discover.&lt;br&gt;It costs conflicts, so it ships with the rebase-retry bot and the fail-closed duplicate gate — never alone. The measurement lives in experiments/konflikty-ukladow/, reproducible." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="706" width="1010" height="40" as="geometry" /></mxCell>
        <mxCell id="n2" value="&lt;b&gt;Why YAML and not HCL:&lt;/b&gt; a team&#x27;s request has to be readable by an auditor and by security without knowing Terraform, and the PR diff has to show exactly as much as the request changes.&lt;br&gt;Terraform is only a renderer here — all the logic lives in one file (locals.tf), so there is a single place that can break quietly, and it has its own tests." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="762" width="1010" height="40" as="geometry" /></mxCell>
        <mxCell id="f1" value="&lt;b&gt;Three layers of ownership:&lt;/b&gt; THE BOUNDARY (perimeter, services, rules, access levels) = this repo · THE NETWORK PREREQUISITE (Private Google Access, DNS zone on the restricted VIP) = the team&#x27;s repo, we only verify it in pre-flight ·&lt;br&gt;RESOURCES (projects, Vertex endpoints, buckets) = the team&#x27;s repo. If onboarding also provisioned the requester&#x27;s network, the perimeter service account would become the most privileged identity in the organisation." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="824" width="1940" height="40" as="geometry" /></mxCell>
        <mxCell id="f2" value="&lt;b&gt;A trap that only surfaces on the first model deployment:&lt;/b&gt; Vertex endpoints must be created AFTER the project joins the perimeter. Created earlier, a later model deploy against them fails —&lt;br&gt;which is why pre-flight warns about existing endpoints and the request form says so explicitly." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="876" width="1940" height="40" as="geometry" /></mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5c5c5c;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;exitX=0;exitY=0.35;entryX=1;entryY=0.35;" edge="1" parent="1" source="rt" target="lt"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9e9e9e;strokeWidth=1;dashed=1;endArrow=open;fontSize=11;exitX=0;exitY=0.5;entryX=0;entryY=1;" edge="1" parent="1" source="k1" target="rt"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
