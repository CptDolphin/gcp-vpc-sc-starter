          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e12" value="9 · apply" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2.4;fontSize=11;endArrow=block;strokeColor=#B85450;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="promo" target="enf">
