        <mxCell id="e3" value="3 · repository_dispatch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;fontSize=11;endArrow=block;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="appr" target="verify">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="4 · bot opens a PR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;fontSize=11;endArrow=block;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="verify" target="yaml">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4b" value="render rules" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.4;fontSize=11;dashed=1;endArrow=open;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="profiles" target="yaml">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;fontSize=11;endArrow=block;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="yaml" target="gates">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;fontSize=11;endArrow=block;" edge="1" parent="1" source="gates" target="plan">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;fontSize=11;endArrow=block;" edge="1" parent="1" source="plan" target="merge">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;fontSize=11;endArrow=block;" edge="1" parent="1" source="merge" target="apply">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e9" value="6 · member joins" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2.4;fontSize=11;endArrow=block;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="apply" target="dry">
          <mxGeometry relative="1" as="geometry"/>
