        <mxCell id="e15" value="guards both configs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.4;fontSize=11;dashed=1;endArrow=open;strokeColor=#9673A6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="drift" target="peribox">
