<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram name="D1-onboarding-flow" id="d1-onboarding">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="D1 · Self-service onboarding into ONE org-wide VPC-SC perimeter" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#202124;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1100" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="sub" value="ServiceNow approves · Git decides · GitHub Actions applies. Nothing else touches the perimeter. Every member starts in DRY-RUN; only a second, human-approved PR moves it to ENFORCED." style="text;html=1;fontSize=12;fontStyle=2;align=left;verticalAlign=middle;fontColor=#5F6368;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="1200" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;LEGEND&lt;/b&gt;&lt;br&gt;🟨 ServiceNow — front door, NO access to GCP&lt;br&gt;🟩 repository — source of truth&lt;br&gt;🟪 GitHub Actions — the only mutator (WIF, keyless)&lt;br&gt;🟧 perimeter baseline · ⬜ dry-run config · 🟥 enforced config&lt;br&gt;◇ gate — a human or a machine check that can say NO&lt;br&gt;── main path · ┄┄ feedback / emergency" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF8E1;strokeColor=#D6B656;fontSize=11;spacing=8;fontColor=#7F6000;" vertex="1" parent="1">
          <mxGeometry x="1300" y="20" width="380" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="div" value="Division team" style="shape=umlActor;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#4C6FA6;fontSize=12;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="70" y="200" width="50" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="net" value="Networking team&#10;(approver)" style="shape=umlActor;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#4C6FA6;fontSize=12;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="70" y="420" width="50" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="snowbox" value="🎫 ServiceNow — front door only, no GCP access" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=none;strokeColor=#D6B656;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;fontColor=#B8860B;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="200" y="170" width="300" height="380" as="geometry"/>
        </mxCell>
        <mxCell id="req" value="&lt;b&gt;1 · Catalog request&lt;/b&gt;&lt;br&gt;projects · use-case PROFILE&lt;br&gt;owner group · review date" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;spacing=6;" vertex="1" parent="snowbox">
          <mxGeometry x="20" y="50" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="appr" value="&lt;b&gt;2 · Approval&lt;/b&gt;&lt;br&gt;Networking (mandatory)&lt;br&gt;+ Security when the request&lt;br&gt;contains a raw exception" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;spacing=6;" vertex="1" parent="snowbox">
          <mxGeometry x="20" y="180" width="260" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="snownote" value="The ticket records business approval.&#10;It never calls the GCP API." style="text;html=1;fontSize=11;fontStyle=2;align=left;fontColor=#7F6000;" vertex="1" parent="snowbox">
          <mxGeometry x="20" y="290" width="260" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="verify" value="&lt;b&gt;3 · intake workflow calls&lt;br&gt;ServiceNow BACK&lt;/b&gt;&lt;br&gt;approved? by the right group?&lt;br&gt;same project as in the payload?&lt;br&gt;&lt;i&gt;payload = data, never authorization&lt;/i&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontSize=11;fontColor=#B85450;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="560" y="190" width="260" height="180" as="geometry"/>
        </mxCell>

        <mxCell id="repobox" value="📁 GitHub repository — source of truth" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=none;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;fontColor=#4A7A3A;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="560" y="410" width="300" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="yaml" value="&lt;b&gt;4 · PR: perimeter/members/&lt;br&gt;DIVISION-PROJECT.yaml&lt;/b&gt;&lt;br&gt;stage: dry-run (forced by the bot)&lt;br&gt;profiles: [ … ] · review_by" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;spacing=6;" vertex="1" parent="repobox">
          <mxGeometry x="20" y="40" width="260" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="profiles" value="perimeter/profiles/*.yaml&#10;teams pick a profile, never raw rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;spacing=6;" vertex="1" parent="repobox">
          <mxGeometry x="20" y="150" width="260" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="cibox" value="⚙️ GitHub Actions — the only mutator (WIF, keyless)" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=none;strokeColor=#9673A6;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;fontColor=#6C4B87;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="920" y="170" width="330" height="470" as="geometry"/>
        </mxCell>
        <mxCell id="gates" value="&lt;b&gt;5 · Gates&lt;/b&gt;&lt;br&gt;JSON Schema · OPA rules&lt;br&gt;pre-flight against live GCP&lt;br&gt;attribute budget (6000/config)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;spacing=6;" vertex="1" parent="cibox">
          <mxGeometry x="25" y="45" width="280" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="plan" value="terraform plan → pinned artifact&#10;OPA gates run on the PLAN, not the YAML" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;spacing=6;" vertex="1" parent="cibox">
          <mxGeometry x="25" y="150" width="280" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="merge" value="auto-merge?&#10;YES: dry-run join, existing profile, offboard&#10;NO: new egress · new profile · promotion" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontSize=11;fontColor=#B85450;spacing=4;" vertex="1" parent="cibox">
          <mxGeometry x="25" y="230" width="280" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="apply" value="&lt;b&gt;apply&lt;/b&gt; · environment with reviewers&lt;br&gt;single-flight (one writer at a time)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;spacing=6;" vertex="1" parent="cibox">
          <mxGeometry x="25" y="375" width="280" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="peribox" value="☁️ ONE org-wide perimeter · ai_core" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=none;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;fontColor=#B26B00;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1300" y="180" width="380" height="450" as="geometry"/>
        </mxCell>
        <mxCell id="base" value="&lt;b&gt;Baseline&lt;/b&gt; — Vertex AI (aiplatform) + its&lt;br&gt;dependencies protected from day one" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;spacing=6;" vertex="1" parent="peribox">
          <mxGeometry x="25" y="45" width="330" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="dry" value="&lt;b&gt;6 · DRY-RUN configuration&lt;/b&gt;&lt;br&gt;every member lands here first&lt;br&gt;violations logged · nothing blocked&lt;br&gt;&lt;i&gt;the project is not protected yet&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#888888;dashed=1;dashPattern=6 4;fontSize=12;spacing=6;" vertex="1" parent="peribox">
          <mxGeometry x="25" y="140" width="330" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="enf" value="&lt;b&gt;9 · ENFORCED configuration&lt;/b&gt;&lt;br&gt;traffic really blocked&lt;br&gt;this is what protects Vertex AI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;spacing=6;" vertex="1" parent="peribox">
          <mxGeometry x="25" y="330" width="330" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="obs" value="&lt;b&gt;7 · 14 days of observation&lt;/b&gt;&lt;br&gt;per-member violation report to the owner:&lt;br&gt;&quot;these calls WILL break when you are promoted&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="920" y="700" width="380" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="promo" value="&lt;b&gt;8 · Promotion PR — always human-approved&lt;/b&gt;&lt;br&gt;0 violations in the clean window&lt;br&gt;every legitimate flow has a rule&lt;br&gt;&lt;i&gt;evidence attached, not claimed&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1360" y="700" width="320" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="bg" value="🚨 Break-glass — demote to dry-run&#10;2 approvers · auto postmortem issue&#10;the member STAYS in dry-run (we keep the traffic data)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;dashed=1;fontSize=11;fontColor=#B85450;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1360" y="850" width="320" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="drift" value="Nightly drift detection + review_by sweep&#10;a console change or a stale member opens a PR / issue by itself" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;dashed=1;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="920" y="850" width="380" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="e1" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;fontSize=11;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="div" target="req">
