        <mxCell id="e2" value="2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;fontSize=11;endArrow=block;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="req" target="appr">
          <mxGeometry relative="1" as="geometry"/>
