        <mxCell id="e14" value="legitimate traffic blocked" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.4;fontSize=11;dashed=1;endArrow=open;strokeColor=#B85450;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="enf" target="bg">
