<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram name="D3-perimeter-anatomy" id="d3-anatomy">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="D3 · Anatomy — what the repository owns, and what the two perimeter configurations mean" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#202124;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1200" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="sub" value="Brownfield default: the perimeter already exists, so Terraform manages ONLY membership and rules. The baseline stays with its current owner until the skeleton is deliberately imported." style="text;html=1;fontSize=12;fontStyle=2;align=left;verticalAlign=middle;fontColor=#5F6368;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="1300" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="repo" value="Repository (source of truth)" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=none;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;fontColor=#4A7A3A;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="420" height="600" as="geometry"/>
        </mxCell>
        <mxCell id="pol" value="&lt;b&gt;perimeter/policy.yaml&lt;/b&gt;&lt;br&gt;restricted services (Vertex + deps)&lt;br&gt;dry-run window · attribute budget&lt;br&gt;&lt;i&gt;manage_skeleton: false → documentation&lt;br&gt;and gate input, not sent to the API&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;spacing=6;" vertex="1" parent="repo">
          <mxGeometry x="25" y="45" width="370" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="prof" value="&lt;b&gt;perimeter/profiles/*.yaml&lt;/b&gt;&lt;br&gt;reusable rule templates&lt;br&gt;a division picks a profile, never writes rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;spacing=6;" vertex="1" parent="repo">
          <mxGeometry x="25" y="170" width="370" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="memb" value="&lt;b&gt;perimeter/projects.yaml&lt;/b&gt;&lt;br&gt;one shared file · a LIST of member entries&lt;br&gt;stage: dry-run | enforced&lt;br&gt;owner · ticket · review_by&lt;br&gt;&lt;i&gt;key = &amp;lt;division&amp;gt;-&amp;lt;project_id&amp;gt;, read from the entry&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;spacing=6;" vertex="1" parent="repo">
          <mxGeometry x="25" y="270" width="370" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="al" value="&lt;b&gt;perimeter/access-levels/*.yaml&lt;/b&gt;&lt;br&gt;context conditions (corp network, device)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;spacing=6;" vertex="1" parent="repo">
          <mxGeometry x="25" y="385" width="370" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="tf" value="&lt;b&gt;terraform/&lt;/b&gt; — renderer only&lt;br&gt;YAML → granular ACM resources&lt;br&gt;&lt;i&gt;no business logic lives in HCL&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;spacing=6;" vertex="1" parent="repo">
          <mxGeometry x="25" y="470" width="370" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="peri" value="Existing perimeter · accessPolicies/&lt;id&gt;/servicePerimeters/ai_core" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=none;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;fontColor=#B26B00;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="620" y="110" width="880" height="600" as="geometry"/>
        </mxCell>

        <mxCell id="skel" value="&lt;b&gt;Baseline (skeleton)&lt;/b&gt; — restricted_services, vpc_accessible_services&lt;br&gt;🔒 NOT managed by this repository in brownfield mode (current owner keeps it)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;dashed=1;fontSize=12;spacing=8;" vertex="1" parent="peri">
          <mxGeometry x="30" y="45" width="820" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="dryc" value="DRY-RUN configuration (spec) — &quot;the proposed future state&quot;" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#FAFAFA;strokeColor=#888888;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;spacingTop=4;" vertex="1" parent="peri">
          <mxGeometry x="30" y="140" width="400" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="drym" value="&lt;b&gt;ALL members&lt;/b&gt;&lt;br&gt;(dry-run AND enforced ones)&lt;br&gt;&lt;i&gt;why all: promotion then only ADDS an&lt;br&gt;enforced resource — there is never a moment&lt;br&gt;when a project belongs to no configuration&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#888888;fontSize=11;spacing=6;" vertex="1" parent="dryc">
          <mxGeometry x="20" y="45" width="360" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="dryr" value="all rendered rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#888888;fontSize=11;spacing=6;" vertex="1" parent="dryc">
          <mxGeometry x="20" y="175" width="360" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="dryeff" value="&lt;b&gt;Effect:&lt;/b&gt; violations are LOGGED&lt;br&gt;(protoPayload.metadata.dryRun = true)&lt;br&gt;nothing is blocked · the project is NOT protected" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;fontSize=11;spacing=6;" vertex="1" parent="dryc">
          <mxGeometry x="20" y="250" width="360" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="drybudget" value="attribute budget counted SEPARATELY&#10;(6000 per configuration)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;fontSize=11;fontStyle=2;spacing=6;" vertex="1" parent="dryc">
          <mxGeometry x="20" y="350" width="360" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="enfc" value="ENFORCED configuration (status) — what really blocks" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#FFF5F5;strokeColor=#B85450;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;fontColor=#B85450;spacingTop=4;" vertex="1" parent="peri">
          <mxGeometry x="460" y="140" width="390" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="enfm" value="&lt;b&gt;only members with stage: enforced&lt;/b&gt;&lt;br&gt;plus their rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;spacing=6;" vertex="1" parent="enfc">
          <mxGeometry x="20" y="45" width="350" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="enfeff" value="&lt;b&gt;Effect:&lt;/b&gt; calls that do not match a rule&lt;br&gt;are DENIED · the project is protected&lt;br&gt;&lt;i&gt;this is the moment a mistake becomes&lt;br&gt;somebody else's production incident&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontSize=11;spacing=6;" vertex="1" parent="enfc">
          <mxGeometry x="20" y="135" width="350" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="enfgate" value="entered ONLY through a promotion PR:&#10;14+ days in dry-run · 0 violations in the clean window&#10;· human approval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;fontSize=11;spacing=6;" vertex="1" parent="enfc">
          <mxGeometry x="20" y="250" width="350" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="enfnote" value="intra-perimeter traffic is NOT restricted&#10;→ divisions inside share one trust zone (IAM still applies)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;dashed=1;fontSize=11;fontStyle=2;spacing=6;" vertex="1" parent="enfc">
          <mxGeometry x="20" y="345" width="350" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="import" value="&lt;b&gt;Taking over the skeleton later&lt;/b&gt; (optional, deliberate): terraform import → plan must show ZERO changes → only then flip manage_skeleton to true.&lt;br&gt;Doing it the other way round would overwrite the live baseline with whatever policy.yaml happens to contain." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;fontSize=11;align=left;spacing=8;fontColor=#7F6000;" vertex="1" parent="1">
          <mxGeometry x="620" y="730" width="880" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="e1" value="renders" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tf" target="dryc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="stage: enforced only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;strokeColor=#B85450;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="memb" target="enfc">
          <mxGeometry x="-0.75" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="540" y="428"/>
              <mxPoint x="540" y="130"/>
              <mxPoint x="1530" y="130"/>
              <mxPoint x="1530" y="397"/>
            </Array>
            <mxPoint as="offset"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e3" value="promotion" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2.4;endArrow=block;strokeColor=#B85450;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dryc" target="enfc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="break-glass: demote (member stays in dry-run)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.6;dashed=1;endArrow=open;strokeColor=#B85450;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="enfc" target="dryc">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1275" y="700"/>
              <mxPoint x="850" y="700"/>
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
