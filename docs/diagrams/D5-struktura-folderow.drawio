        <mxCell id="divBox" value="Repozytorium dywizji &#8212; dywizja-a&#10;właściciel: zespół produktowy &#183; nie ma uprawnień w Access Context Managerze" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=13;fontStyle=1;" vertex="1" parent="1">
