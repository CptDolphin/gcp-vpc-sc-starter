        <mxCell id="divTree" value="&lt;div style=&quot;font-family:Courier New,monospace;font-size:12px;text-align:left;line-height:1.5&quot;&gt;dywizja-a/&lt;br&gt;&#8866;&#9472; terraform/&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;PREREQ&lt;/b&gt; &#8212; sprawdzamy, nie naprawiamy&lt;br&gt;&#9474;&amp;nbsp;&amp;nbsp;&#8866;&#9472; project.tf&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;projekt + jego numer&lt;/i&gt;&lt;br&gt;&#9474;&amp;nbsp;&amp;nbsp;&#8866;&#9472; network.tf&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;private_ip_google_access = true&lt;/i&gt;&lt;br&gt;&#9474;&amp;nbsp;&amp;nbsp;&#8866;&#9472; dns.tf&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;*.googleapis.com &#8594; 199.36.153.4/30&lt;/i&gt;&lt;br&gt;&#9474;&amp;nbsp;&amp;nbsp;&#9492;&#9472; vertex.tf&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;endpointy, notebooki, bucket&lt;/i&gt;&lt;br&gt;&#8866;&#9472; vpc-sc/&lt;br&gt;&#9474;&amp;nbsp;&amp;nbsp;&#9492;&#9472; request.yaml&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;CZEGO potrzebuję&lt;/b&gt;: projekt + profil&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;+ parametry. NIGDY reguły&lt;/i&gt;&lt;br&gt;&#9492;&#9472; .github/workflows/&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&#9492;&#9472; vpc-sc-request.yml&amp;nbsp;&lt;i&gt;walidacja paczką bramek&lt;/i&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;z kontraktu &#8594; dispatch&lt;/i&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="796" y="118" width="548" height="320" as="geometry" />
        </mxCell>

        <mxCell id="flow" value="Zgłoszenie z repo dywizji albo z ServiceNow &#8594; bot otwiera PR, który dodaje&#10;DOKŁADNIE JEDEN nowy plik w perimeter/members/&amp;lt;dywizja&amp;gt;/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5ee;strokeColor=#0f6e56;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="780" y="480" width="580" height="60" as="geometry" />
        </mxCell>

        <mxCell id="arrowReq" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0f6e56;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="flow" target="perimBox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="konflikty" value="Gdzie w ogóle mogą powstać konflikty" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fae4d9;strokeColor=#993c1d;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="570" width="580" height="220" as="geometry" />
        </mxCell>

        <mxCell id="konfliktyText" value="&lt;div style=&quot;font-size:12px;text-align:left;line-height:1.6&quot;&gt;&lt;b&gt;NIE mogą&lt;/b&gt; (95% ruchu): dołączenie projektu, zmiana parametrów,&lt;br&gt;promocja dry-run &#8594; enforced, offboarding.&lt;br&gt;Każda z tych operacji dotyka &lt;b&gt;jednego, własnego pliku&lt;/b&gt;.&lt;br&gt;Zmierzone: 10 równoległych PR-ów &#8594; &lt;b&gt;10/10 bez konfliktu&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;MOGĄ&lt;/b&gt;, i to jest w porządku: policy.yaml, profiles/*.yaml,&lt;br&gt;access-levels/*.yaml &#8212; pliki niskozmienne, zmieniane świadomie&lt;br&gt;przez Security/Networking. Jeden review dla wszystkich, którzy&lt;br&gt;danego profilu używają &#8212; to cecha, nie koszt.&lt;br&gt;&lt;br&gt;Dla porównania: JEDEN wspólny projects.yml i 10 PR-ów&lt;br&gt;z tej samej dywizji &#8594; &lt;b&gt;1/10 bez konfliktu&lt;/b&gt;.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="794" y="600" width="552" height="180" as="geometry" />
        </mxCell>

        <mxCell id="limit" value="&lt;div style=&quot;font-size:12px;text-align:left;line-height:1.6&quot;&gt;&lt;b&gt;Realny limit skali to nie liczba plików.&lt;/b&gt; 200 plików YAML to ~840 kB i milisekundy w fileset().&lt;br&gt;Wąskim gardłem jest &lt;b&gt;6000 atrybutów na konfigurację perimetru&lt;/b&gt; (osobno enforced i dry-run):&lt;br&gt;każda tożsamość, zasób, usługa i metoda w regule go konsumuje. Dlatego reguły są profilami,&lt;br&gt;a nie tekstem pisanym per wniosek &#8212; i dlatego budżet mierzy się od pierwszego dnia.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faeeda;strokeColor=#854f0b;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="694" width="700" height="100" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
