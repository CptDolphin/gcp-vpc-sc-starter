        <mxCell id="divBox" value="Repozytorium dywizji &#8212; dywizja-a&#10;właściciel: zespół produktowy &#183; nie ma uprawnień w Access Context Managerze" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="72" width="580" height="380" as="geometry" />
        </mxCell>

        <mxCell id="divTree" value="&lt;div style=&quot;font-family:Courier New,monospace;font-size:12px;text-align:left;line-height:1.5&quot;&gt;dywizja-a/&lt;br&gt;&#8866;&#9472; terraform/&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;PREREQ&lt;/b&gt; &#8212; sprawdzamy, nie naprawiamy&lt;br&gt;&#9474;&amp;nbsp;&amp;nbsp;&#8866;&#9472; project.tf&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;projekt + jego numer&lt;/i&gt;&lt;br&gt;&#9474;&amp;nbsp;&amp;nbsp;&#8866;&#9472; network.tf&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;private_ip_google_access = true&lt;/i&gt;&lt;br&gt;&#9474;&amp;nbsp;&amp;nbsp;&#8866;&#9472; dns.tf&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;*.googleapis.com &#8594; 199.36.153.4/30&lt;/i&gt;&lt;br&gt;&#9474;&amp;nbsp;&amp;nbsp;&#9492;&#9472; vertex.tf&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;endpointy, notebooki, bucket&lt;/i&gt;&lt;br&gt;&#8866;&#9472; vpc-sc/&lt;br&gt;&#9474;&amp;nbsp;&amp;nbsp;&#9492;&#9472; request.yaml&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;CZEGO potrzebuję&lt;/b&gt;: projekt + profil&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;+ parametry. NIGDY reguły&lt;/i&gt;&lt;br&gt;&#9492;&#9472; .github/workflows/&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&#9492;&#9472; vpc-sc-request.yml&amp;nbsp;&lt;i&gt;walidacja paczką bramek&lt;/i&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;z kontraktu &#8594; dispatch&lt;/i&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="796" y="118" width="548" height="320" as="geometry" />
        </mxCell>

        <mxCell id="flow" value="Zgłoszenie z repo dywizji albo z ServiceNow → bot otwiera PR, który DOPISUJE&#10;DOKŁADNIE JEDEN wpis na końcu listy w perimeter/projects.yaml" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5ee;strokeColor=#0f6e56;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="780" y="480" width="580" height="60" as="geometry" />
        </mxCell>

        <mxCell id="arrowReq" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0f6e56;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="flow" target="perimBox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="konflikty" value="Konflikty — czym płacimy za jeden wspólny plik" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fae4d9;strokeColor=#993c1d;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="548" width="580" height="290" as="geometry" />
        </mxCell>

        <mxCell id="konfliktyText" value="&lt;div style=&quot;font-size:12px;text-align:left;line-height:1.6&quot;&gt;Jeden wspólny plik + fala wniosków z jednej dywizji = konflikt na każdym kolejnym&lt;br&gt;PR-ze: bot dopisuje &lt;b&gt;NA KOŃCU&lt;/b&gt;, więc wszystkie trafiają w te same linie. Bez bota&lt;br&gt;większość wniosków wymaga &lt;b&gt;ręcznego&lt;/b&gt; rozwiązania konfliktu.&lt;br&gt;&lt;br&gt;Dlatego ten układ wchodzi &lt;b&gt;razem z dwoma mechanizmami&lt;/b&gt;, nigdy sam:&lt;br&gt;• bot ponawia &lt;b&gt;INTENCJĘ&lt;/b&gt; na świeżym main (dopisuje wpis jeszcze raz, NIE&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;code&gt;git rebase&lt;/code&gt;) — przechodzą wszystkie, kosztem ponowień;&lt;br&gt;• samo &lt;code&gt;merge=union&lt;/code&gt; daje zielone scalenia i przy tym &lt;b&gt;GUBI wpisy&lt;/b&gt; (zlepia&lt;br&gt;&amp;nbsp;&amp;nbsp;sąsiednie w jeden), a przy edycji dubluje klucze — stąd bramka duplikatu.&lt;br&gt;&lt;br&gt;&lt;b&gt;Pomiar — jedna tabela:&lt;/b&gt; experiments/konflikty-ukladow/README.md, nie ten obrazek.&lt;br&gt;&lt;b&gt;Konflikty świadome zostają:&lt;/b&gt; policy.yaml, profiles/*.yaml, access-levels/*.yaml.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="794" y="578" width="552" height="254" as="geometry" />
        </mxCell>

        <mxCell id="limit" value="&lt;div style=&quot;font-size:12px;text-align:left;line-height:1.6&quot;&gt;&lt;b&gt;Realny limit skali to nie liczba plików ani wpisów.&lt;/b&gt; 200 wpisów to jeden plik czytany w milisekundach.&lt;br&gt;Wąskim gardłem jest &lt;b&gt;6000 atrybutów na konfigurację perimetru&lt;/b&gt; (osobno enforced i dry-run):&lt;br&gt;każda tożsamość, zasób, usługa i metoda w regule go konsumuje. Dlatego reguły są profilami,&lt;br&gt;a nie tekstem pisanym per wniosek — i dlatego budżet mierzy się od pierwszego dnia.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faeeda;strokeColor=#854f0b;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="738" width="700" height="100" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
